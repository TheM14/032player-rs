import { ListView, ScrollView } from "std-widgets.slint";
import { ArtFit, Fonts, Theme } from "theme.slint";
import { PlayingBars, IconButton, IconKind, Icon, SearchField } from "controls.slint";

// `translation`: shown under the line (bilingual).
export struct LyricLine {
    text: string,
    translation: string,
}

export struct QueueRow {
    uid: int,
    // Position in the queue (1-based; search keeps the queue numbers).
    number: int,
    title: string,
    artist: string,
    duration: string,
    cover: image,
}


export component QueuePanel inherits Rectangle {
    in property <[QueueRow]> rows;
    // Entries in the whole queue (`rows` may be filtered).
    in property <int> total;
    in property <int> current: -1;
    // The search text (rows are filtered in Rust; no dragging then).
    in-out property <string> search;
    callback search-changed(string);
    callback play(int);
    callback remove(int);
    callback clear();
    // Save the queue as a new playlist.
    callback save();
    // (uid, new play-order position)
    callback move(int, int);
    property <int> drag-from: -1;
    property <int> drop-at: -1;
    // The right panel tab hides the title row.
    in property <bool> show-title: true;
    in property <length> side-padding: 16px;
    // Full-screen player light-surface card mode.
    in property <bool> stage: false;
    // Wide full-screen shows the integrated "接下来播放" header inside the card.
    in property <bool> stage-head: false;
    // Current position in the unfiltered queue.
    in property <int> position: -1;
    property <bool> search-open: false;
    // Auto-scroll to the playing track once when the panel opens (re-entering
    // full-screen or switching back to the queue tab mounts a fresh instance).
    property <bool> needs-locate: true;
    property <int> locate-retries: 10;
    property <length> row-h: root.stage ? 64px : 56px;
    property <length> art-size: round((root.stage ? 48px : 40px) / 1phx) * 1phx;

    border-radius: root.stage ? 14px : 0px;
    border-width: root.stage ? 1px : 0px;
    border-color: root.stage ? Theme.border.with-alpha(0.6) : transparent;
    background: root.stage ? Theme.stage-panel : Theme.surface;
    clip: root.stage;

    function locate() {
        root.needs-locate = false;
        if root.current >= 0 {
            list.content-y = -min(max(0px, root.current * root.row-h - (list.visible-height - root.row-h) / 2), max(0px, list.content-height - list.visible-height));
        }
    }

    function try-initial-locate() {
        if root.needs-locate {
            if root.current < 0 || root.rows.length == 0 {
                root.needs-locate = false;
            } else if list.visible-height > 0px && list.content-height >= root.rows.length * root.row-h - 1px {
                root.locate();
            }
        }
    }

    init => {
        root.try-initial-locate();
    }

    locate-timer := Timer {
        interval: 16ms;
        running: root.needs-locate;
        triggered => {
            root.try-initial-locate();
            if root.needs-locate {
                root.locate-retries = root.locate-retries - 1;
                if root.locate-retries <= 0 {
                    root.locate();
                }
            }
        }
    }

    if root.rows.length == 0: Text {
        y: root.stage ? 160px : 120px;
        width: root.width;
        horizontal-alignment: center;
        text: root.search != "" ? "没有匹配的曲目" : "队列为空";
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
    }

    VerticalLayout {
        // Regular sidebar toolbar (unchanged when `!root.stage`).
        if !root.stage && root.show-title: HorizontalLayout {
            padding-left: root.side-padding;
            padding-right: root.side-padding - 8px;
            padding-top: 10px;
            padding-bottom: 4px;
            spacing: 2px;
            Text {
                text: "播放队列";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.total == 0 ? "" : "  " + root.total + " 首";
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        if !root.stage: HorizontalLayout {
            padding-left: root.side-padding;
            padding-right: root.side-padding - 6px;
            padding-top: root.show-title ? 4px : 6px;
            padding-bottom: 8px;
            spacing: 2px;
            SearchField {
                height: 32px;
                placeholder: "搜索队列";
                text <=> root.search;
                edited => {
                    root.search-changed(self.text);
                }
                accepted => {
                    root.search-changed(self.text);
                }
            }
            Rectangle {
                width: 4px;
            }
            IconButton {
                kind: IconKind.locate;
                size: 32px;
                icon-size: 17px;
                enabled: root.current >= 0;
                clicked => {
                    root.locate();
                }
            }
            IconButton {
                kind: IconKind.playlist-add;
                size: 32px;
                icon-size: 17px;
                enabled: root.total > 0;
                clicked => {
                    root.save();
                }
            }
            IconButton {
                kind: IconKind.trash;
                size: 32px;
                icon-size: 17px;
                enabled: root.total > 0;
                clicked => {
                    root.clear();
                }
            }
        }

        // Full-screen stage card header: title + count + quiet action icons
        // + on-demand collapsible search bar + subtle progress subline.
        if root.stage: VerticalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 14px;
            padding-bottom: 10px;
            spacing: 8px;

            HorizontalLayout {
                height: 32px;
                spacing: 6px;
                if root.stage-head: Text {
                    text: "接下来播放";
                    color: Theme.text;
                    font-size: 15.5px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                if root.stage-head && root.total > 0: Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 20px;
                    width: count-txt.preferred-width + 12px;
                    border-radius: 10px;
                    background: Theme.accent-dim;
                    count-txt := Text {
                        text: root.total;
                        font-family: Fonts.family(self.text);
                        color: Theme.accent-text;
                        font-size: 11.5px;
                        font-weight: 600;
                    }
                }
                if !root.stage-head && root.total > 0: Text {
                    text: root.position >= 0
                        ? "正在播放第 " + (root.position + 1) + " / " + root.total + " 首"
                        : "共 " + root.total + " 首";
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: 12.5px;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                IconButton {
                    kind: IconKind.search;
                    size: 30px;
                    icon-size: 15px;
                    active: root.search-open || root.search != "";
                    clicked => {
                        if root.search-open || root.search != "" {
                            root.search-open = false;
                            if root.search != "" {
                                root.search = "";
                                root.search-changed("");
                            }
                        } else {
                            root.search-open = true;
                        }
                    }
                }
                IconButton {
                    kind: IconKind.locate;
                    size: 30px;
                    icon-size: 15px;
                    enabled: root.current >= 0;
                    clicked => {
                        root.locate();
                    }
                }
                IconButton {
                    kind: IconKind.playlist-add;
                    size: 30px;
                    icon-size: 15px;
                    enabled: root.total > 0;
                    clicked => {
                        root.save();
                    }
                }
                IconButton {
                    kind: IconKind.trash;
                    size: 30px;
                    icon-size: 15px;
                    enabled: root.total > 0;
                    clicked => {
                        root.clear();
                    }
                }
            }

            if root.search-open || root.search != "": HorizontalLayout {
                padding-right: 4px;
                SearchField {
                    height: 34px;
                    placeholder: "筛选队列中的曲目或艺人…";
                    text <=> root.search;
                    edited => {
                        root.search-changed(self.text);
                    }
                    accepted => {
                        root.search-changed(self.text);
                    }
                }
            }

            if root.stage-head && root.total > 0: HorizontalLayout {
                padding-right: 4px;
                Text {
                    text: root.position >= 0
                        ? "正在播放第 " + (root.position + 1) + " / " + root.total + " 首"
                        : "共 " + root.total + " 首";
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.search != ""
                        ? "匹配 " + root.rows.length + " 首"
                        : root.position >= 0
                            ? "剩余 " + max(0, root.total - root.position - 1) + " 首"
                            : "";
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 1px;
            Rectangle {
                x: root.side-padding;
                width: parent.width - 2 * root.side-padding;
                background: root.stage ? Theme.border.with-alpha(0.55) : Theme.border;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            list := ListView {
                width: 100%;
                height: 100%;
                changed visible-height => {
                    root.try-initial-locate();
                }
                changed content-height => {
                    root.try-initial-locate();
                }
                for row[i] in root.rows: row-item := Rectangle {
                    property <length> press-y;
                    property <bool> dragging: root.drag-from == i;
                    property <bool> is-current: i == root.current;
                    property <bool> is-played: root.stage && row.number <= root.position;
                    property <bool> row-hover: area.has-hover || play-area.has-hover || stage-remove-area.has-hover;
                    height: root.row-h;
                    background: root.stage ? transparent
                        : row-item.dragging ? Theme.accent-dim
                        : row-item.is-current ? Theme.accent-dim
                        : area.has-hover ? Theme.surface-hover : transparent;

                    // Stage mode: inset rounded row card with subtle active border & left accent bar.
                    if root.stage: Rectangle {
                        x: 10px;
                        y: 2px;
                        width: parent.width - 20px;
                        height: parent.height - 4px;
                        border-radius: 10px;
                        border-width: row-item.is-current ? 1px : 0px;
                        border-color: Theme.accent.with-alpha(0.32);
                        background: row-item.dragging ? Theme.accent-dim
                            : row-item.is-current ? Theme.accent-dim
                            : row-item.row-hover ? Theme.surface-hover : transparent;

                        if row-item.is-current: Rectangle {
                            x: 0px;
                            y: 12px;
                            width: 3px;
                            height: parent.height - 24px;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }
                    }

                    area := TouchArea {
                        double-clicked => {
                            root.play(row.uid);
                        }
                        pointer-event(e) => {
                            if e.button == PointerEventButton.left {
                                if e.kind == PointerEventKind.down {
                                    row-item.press-y = self.mouse-y;
                                }
                                if e.kind == PointerEventKind.up && root.drag-from == i {
                                    if root.drop-at >= 0 && root.drop-at != i {
                                        root.move(row.uid, root.drop-at);
                                    }
                                    root.drag-from = -1;
                                    root.drop-at = -1;
                                }
                            }
                            if e.kind == PointerEventKind.cancel && root.drag-from == i {
                                root.drag-from = -1;
                                root.drop-at = -1;
                            }
                        }
                        moved => {
                            if self.pressed && root.search == "" && (root.drag-from == i || abs(self.mouse-y - row-item.press-y) > 6px) {
                                root.drag-from = i;
                                root.drop-at = max(0, min(root.rows.length - 1, i + round((self.mouse-y - row-item.press-y) / row-item.height)));
                            }
                        }
                    }

                    if root.drag-from >= 0 && root.drop-at == i && i != root.drag-from: Rectangle {
                        x: root.stage ? 12px : 0px;
                        width: root.stage ? parent.width - 24px : parent.width;
                        y: root.drop-at < root.drag-from ? 0 : parent.height - 2px;
                        height: 2px;
                        background: Theme.accent;
                    }

                    // Row content: number, cover (48px snapped in stage), title / artist, duration / hover remove.
                    HorizontalLayout {
                        padding-left: root.stage ? 18px : root.side-padding - 10px;
                        padding-right: root.stage ? 20px : root.side-padding - 6px;
                        spacing: root.stage ? 12px : 10px;
                        opacity: row-item.is-played && !row-item.row-hover ? 0.44 : 1.0;

                        Rectangle {
                            width: root.stage ? 22px : 28px;
                            if !row-item.is-current || root.stage: Text {
                                width: 100%;
                                height: 100%;
                                text: row.number;
                                font-family: Fonts.family(self.text);
                                color: row-item.is-current ? Theme.accent-text : Theme.text-faint;
                                font-size: root.stage ? 12px : 14px;
                                font-weight: row-item.is-current ? 600 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            if row-item.is-current && !root.stage: PlayingBars {
                                width: 12px;
                                height: 11px;
                            }
                        }

                        Rectangle {
                            width: root.art-size;
                            height: root.art-size;
                            y: (parent.height - self.height) / 2;
                            Rectangle {
                                width: ArtFit.width(root.art-size, root.art-size, row.cover);
                                height: ArtFit.height(root.art-size, root.art-size, row.cover);
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                border-radius: root.stage ? 7px : 4px;
                                background: row.cover.width == 0 ? Theme.raised : transparent;
                                clip: true;
                                Image {
                                    source: row.cover;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: ImageFit.cover;
                                }
                                // Stage mode: playing bars on current cover, single-click play overlay on hover.
                                if root.stage && (row-item.is-current || row-item.row-hover): Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    background: #0d0d118a;
                                    if row-item.is-current: PlayingBars {
                                        width: 13px;
                                        height: 12px;
                                        bar-color: #ffffff;
                                    }
                                    if !row-item.is-current: Icon {
                                        kind: IconKind.play;
                                        width: 16px;
                                        height: 16px;
                                        color: #ffffff;
                                    }
                                }
                            }
                            play-area := TouchArea {
                                enabled: root.stage && !row-item.is-current;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.play(row.uid);
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            spacing: root.stage ? 2px : 0px;
                            Text {
                                text: row.title;
                                font-family: Fonts.family(self.text);
                                color: row-item.is-current ? Theme.accent-text : Theme.text;
                                font-size: root.stage ? 14.5px : 15px;
                                font-weight: root.stage && row-item.is-current ? 650 : 600;
                                overflow: elide;
                            }
                            Text {
                                text: row.artist;
                                font-family: Fonts.family(self.text);
                                color: Theme.text-dim;
                                font-size: 12.5px;
                                overflow: elide;
                            }
                        }

                        // Sidebar mode keeps duration + separate 28px remove slot;
                        // Stage mode swaps duration cleanly to the remove button on hover.
                        if !root.stage: Text {
                            text: row.duration;
                            color: Theme.text-faint;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if !root.stage: Rectangle {
                            width: 28px;
                            Icon {
                                visible: area.has-hover || remove-area.has-hover;
                                kind: IconKind.close;
                                width: 14px;
                                height: 14px;
                                color: remove-area.has-hover ? Theme.text : Theme.text-faint;
                            }
                            remove-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.remove(row.uid);
                                }
                            }
                        }
                        if root.stage: Rectangle {
                            width: 40px;
                            if !row-item.row-hover: Text {
                                width: 100%;
                                height: 100%;
                                text: row.duration;
                                color: Theme.text-faint;
                                font-size: 12px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            if row-item.row-hover: Rectangle {
                                x: parent.width - 28px;
                                y: (parent.height - 28px) / 2;
                                width: 28px;
                                height: 28px;
                                border-radius: 7px;
                                background: stage-remove-area.has-hover ? Theme.raised : transparent;
                                Icon {
                                    kind: IconKind.close;
                                    width: 14px;
                                    height: 14px;
                                    color: stage-remove-area.has-hover ? Theme.danger : Theme.text-dim;
                                }
                            }
                        }
                    }

                    stage-remove-area := TouchArea {
                        x: parent.width - 20px - self.width;
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        enabled: root.stage;
                        mouse-cursor: pointer;
                        clicked => {
                            root.remove(row.uid);
                        }
                    }
                }
            }

            // Soft top/bottom fade masks in stage mode (matching LyricsPanel).
            if root.stage && root.rows.length > 0: Rectangle {
                y: 0;
                height: 18px;
                background: @linear-gradient(180deg, Theme.stage-panel 0%, Theme.stage-panel.with-alpha(0) 100%);
            }
            if root.stage && root.rows.length > 0: Rectangle {
                y: parent.height - self.height;
                height: 22px;
                background: @linear-gradient(0deg, Theme.stage-panel 0%, Theme.stage-panel.with-alpha(0) 100%);
            }
        }
    }
}

component LyricsTool inherits Rectangle {
    in property <string> text;
    in property <bool> has-icon;
    in property <IconKind> icon: IconKind.search;
    in property <bool> active;
    in property <bool> on-stage;
    callback clicked();
    height: 30px;
    width: max(30px, tool-row.preferred-width);
    border-radius: 8px;
    background: root.active ? Theme.accent-dim : area.has-hover ? (root.on-stage && Theme.dark ? #ffffff1a : Theme.surface-hover) : transparent;
    tool-row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        alignment: center;
        if root.has-icon: Icon {
            kind: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            color: root.active ? Theme.accent-text : area.has-hover ? Theme.text : Theme.text-dim;
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.active ? Theme.accent-text : area.has-hover ? Theme.text : Theme.text-dim;
            font-size: 12.5px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ToolSep inherits Rectangle {
    width: 9px;
    Rectangle {
        x: 4px;
        width: 1px;
        height: 14px;
        background: Theme.border;
    }
}

// Lyrics tools: search, offset (− value +; the value resets), translate,
// clear. Shared by the right panel (bottom) and the full-screen player.
export component LyricsTools inherits HorizontalLayout {
    in property <bool> synced;
    in property <bool> has-lines;
    in property <bool> can-search;
    in property <bool> can-translate;
    in property <bool> translation-shown;
    in property <bool> translating;
    in property <int> offset-ms;
    in property <bool> on-stage;
    // search, clear, translate
    callback tool(string);
    callback offset(int);
    spacing: 2px;
    alignment: center;
    height: 30px;
    if root.can-search: LyricsTool {
        has-icon: true;
        icon: IconKind.search;
        on-stage: root.on-stage;
        clicked => {
            root.tool("search");
        }
    }
    if root.can-search && root.synced: ToolSep { }
    if root.synced: LyricsTool {
        has-icon: true;
        icon: IconKind.minus;
        on-stage: root.on-stage;
        clicked => {
            root.offset(root.offset-ms - 50);
        }
    }
    if root.synced: Text {
        text: (root.offset-ms > 0 ? "+" : "") + root.offset-ms + " ms";
        font-family: Fonts.family(self.text);
        color: root.offset-ms == 0 ? Theme.text : Theme.accent-text;
        font-size: 12.5px;
        font-weight: 500;
        min-width: 44px;
        horizontal-alignment: center;
        vertical-alignment: center;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.offset(0);
            }
        }
    }
    if root.synced: LyricsTool {
        has-icon: true;
        icon: IconKind.plus;
        on-stage: root.on-stage;
        clicked => {
            root.offset(root.offset-ms + 50);
        }
    }
    if (root.can-search || root.synced) && (root.can-translate || (root.can-search && root.has-lines)): ToolSep { }
    if root.can-translate: LyricsTool {
        has-icon: true;
        icon: IconKind.lang;
        text: root.translating ? "翻译中…" : "翻译";
        active: root.translation-shown;
        on-stage: root.on-stage;
        clicked => {
            root.tool("translate");
        }
    }
    // Clears online lyrics.
    if root.can-search && root.has-lines: LyricsTool {
        has-icon: true;
        icon: IconKind.close;
        on-stage: root.on-stage;
        clicked => {
            root.tool("clear");
        }
    }
}

// Lyrics of the current track: synced lines follow playback (scrolling by
// hand pauses auto-follow until the user clicks the return pill, clicks a
// line, or restarts/changes the track), clicking a synced line seeks to it.
// `stage`: the full-screen lyrics column (left aligned, 44 / 34px);
// `large`: the full-screen lyrics tab (centered); otherwise the right
// panel. The tools sit at the bottom unless `show-tools` is off (the
// full-screen column has them in its header). `fades` with `fade` (the
// background color) fades the lines out at the top and bottom.
export component LyricsPanel inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> active: -1;
    in property <bool> synced;
    in property <string> source;
    in property <bool> has-track;
    in property <bool> can-search;
    in property <bool> can-translate;
    in property <bool> translation-shown;
    in property <bool> translating;
    in property <int> offset-ms;
    in property <int> reset-seq: 0;
    callback seek-line(int);
    // search, clear, translate; offset (ms)
    callback tool(string);
    callback offset(int);
    in property <bool> lines-have-translation;
    in property <bool> large;
    in property <bool> stage;
    in property <bool> show-tools: true;
    in property <color> fade: transparent;
    in property <bool> fades;
    in property <length> side-padding: 24px;
    property <bool> following: true;
    property <bool> centered: root.large && !root.stage;
    property <length> line-size: root.stage ? 34px : root.large ? 26px : 17px;
    property <length> active-size: root.stage ? 44px : root.large ? 30px : 20px;
    property <length> tr-size: root.stage ? 19px : root.large ? 18px : 13px;
    property <length> tr-active-size: root.stage ? 21px : root.large ? 19px : 13px;
    property <length> gap: root.stage ? 22px : root.large ? 14px : 10px;
    property <color> dim-color: root.stage || root.large ? Theme.text.with-alpha(0.3) : Theme.text-faint;
    property <color> dim-tr-color: root.stage || root.large ? Theme.text.with-alpha(0.25) : Theme.text-faint;
    background: transparent;

    VerticalLayout {
        if root.lines.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: root.has-track ? "暂无歌词" : "";
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
            }
        }

        // Synced lyrics: the active line stays at 42% of the height unless
        // the user scrolled away.
        if root.lines.length > 0 && root.synced: synced-flick := Flickable {
            vertical-stretch: 1;
            // Not from the content (its padding follows this height).
            min-height: 0px;
            max-height: 100000px;
            preferred-height: 0px;
            // Top of the active line in the column.
            property <length> target;
            property <bool> follow-state: root.following;
            property <int> active-line: root.active;
            property <int> reset-seq: root.reset-seq;
            function recenter() {
                self.content-y = -max(0px, min(self.target - self.height * 0.42, self.content-height - self.height));
            }
            content-height: synced-col.preferred-height;
            init => {
                root.following = true;
            }
            flicked => {
                root.following = false;
            }
            changed follow-state => {
                if self.follow-state {
                    if root.active < 0 {
                        self.target = 0px;
                    }
                    self.recenter();
                }
            }
            changed active-line => {
                if self.active-line < 0 {
                    self.target = 0px;
                    if root.following {
                        self.recenter();
                    }
                }
            }
            changed reset-seq => {
                root.following = true;
                if root.active < 0 {
                    self.target = 0px;
                }
                self.recenter();
            }
            changed height => {
                if root.following {
                    self.recenter();
                }
            }
            animate content-y { duration: 380ms; easing: ease-out; }

            synced-col := VerticalLayout {
                width: synced-flick.width;
                padding-top: synced-flick.height * 0.42;
                padding-bottom: synced-flick.height * 0.5;
                padding-left: root.side-padding - 8px;
                padding-right: root.side-padding - 8px;
                spacing: root.gap;
                for line[i] in root.lines: Rectangle {
                    property <bool> on: i == root.active;
                    function track() {
                        if self.on {
                            synced-flick.target = self.y;
                            if root.following {
                                synced-flick.recenter();
                            }
                        }
                    }
                    init => {
                        self.track();
                    }
                    changed on => {
                        self.track();
                    }
                    changed y => {
                        self.track();
                    }
                    height: line-col.preferred-height;
                    border-radius: 8px;
                    background: line-area.has-hover ? ((root.stage || root.large) && Theme.dark ? #ffffff0d : Theme.surface-hover) : transparent;
                    line-col := VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: root.stage ? 6px : 3px;
                        Text {
                            text: line.text;
                            font-family: Fonts.family(self.text);
                            wrap: word-wrap;
                            horizontal-alignment: root.centered ? center : left;
                            font-size: on ? root.active-size : root.line-size;
                            font-weight: root.stage ? 780 : 700;
                            color: on ? Theme.text : root.dim-color;
                            animate color { duration: 300ms; }
                        }
                        if line.translation != "": Text {
                            text: line.translation;
                            font-family: Fonts.family(self.text);
                            wrap: word-wrap;
                            horizontal-alignment: root.centered ? center : left;
                            font-size: on ? root.tr-active-size : root.tr-size;
                            font-weight: root.stage ? 500 : 450;
                            color: on ? (root.stage || root.large ? Theme.text.with-alpha(0.75) : Theme.text-dim) : root.dim-tr-color;
                            animate color { duration: 300ms; }
                        }
                    }
                    line-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.following = true;
                            synced-flick.target = parent.y;
                            synced-flick.recenter();
                            root.seek-line(i);
                        }
                    }
                }
            }
        }

        // Plain lyrics: free scrolling.
        if root.lines.length > 0 && !root.synced: plain-flick := Flickable {
            vertical-stretch: 1;
            content-height: plain-col.preferred-height;
            property <int> reset-seq: root.reset-seq;
            changed reset-seq => {
                self.content-y = 0px;
            }
            plain-col := VerticalLayout {
                width: plain-flick.width;
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: root.gap;
                for line in root.lines: VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: line.text;
                        font-family: Fonts.family(self.text);
                        wrap: word-wrap;
                        horizontal-alignment: root.centered ? center : left;
                        font-size: root.line-size;
                        font-weight: 600;
                        color: Theme.text-dim;
                    }
                    if line.translation != "": Text {
                        text: line.translation;
                        font-family: Fonts.family(self.text);
                        wrap: word-wrap;
                        horizontal-alignment: root.centered ? center : left;
                        font-size: root.tr-size;
                        color: Theme.text-faint;
                    }
                }
            }
        }

        if root.has-track && root.show-tools: HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 10px;
            alignment: center;
            LyricsTools {
                synced: root.synced;
                has-lines: root.lines.length > 0;
                can-search: root.can-search;
                can-translate: root.can-translate;
                translation-shown: root.translation-shown;
                translating: root.translating;
                offset-ms: root.offset-ms;
                on-stage: root.large || root.stage;
                tool(what) => {
                    root.tool(what);
                }
                offset(ms) => {
                    root.offset(ms);
                }
            }
        }
    }

    // Fades at the top and bottom of the lines (Slint has no masks).
    if root.fades && root.lines.length > 0: Rectangle {
        y: 0;
        height: min(64px, root.height * 0.14);
        background: @linear-gradient(180deg, root.fade 0%, root.fade.with-alpha(0) 100%);
    }
    if root.fades && root.lines.length > 0: Rectangle {
        y: root.height - self.height - (root.has-track && root.show-tools ? 46px : 0px);
        height: min(64px, root.height * 0.14);
        background: @linear-gradient(0deg, root.fade 0%, root.fade.with-alpha(0) 100%);
    }

    // Floating return pill shown when the user manually scrolled synced lyrics.
    if root.lines.length > 0 && root.synced: Rectangle {
        visible: self.opacity > 0.01;
        opacity: root.following ? 0 : 1;
        animate opacity { duration: 160ms; }
        x: (parent.width - self.width) / 2;
        y: 12px;
        height: 30px;
        width: return-label.preferred-width + 30px;
        border-radius: 15px;
        border-width: 1px;
        border-color: return-area.has-hover ? Theme.accent : Theme.popover-border;
        background: return-area.has-hover
            ? (Theme.dark ? #2e2e3af8 : #ffffff)
            : Theme.popover.with-alpha(0.92);
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000040;
        return-label := Text {
            text: "回到当前歌词";
            font-family: Fonts.family(self.text);
            color: return-area.has-hover ? Theme.accent-text : Theme.text;
            font-size: 12.5px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        return-area := TouchArea {
            enabled: !root.following;
            mouse-cursor: pointer;
            clicked => {
                root.following = true;
            }
        }
    }
}

