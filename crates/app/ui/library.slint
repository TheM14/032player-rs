import { ComboBox, ScrollView } from "std-widgets.slint";
import { Fonts, Theme, Shell } from "theme.slint";
import {
    Field, PrimaryButton, IconButton, IconKind, Icon, SearchField, GhostButton, SmallInput, Chip,
    BigTitle, RoundIconButton,
} from "controls.slint";
import { AlbumRow, PlaylistChoice, CardView } from "views.slint";

// Sort, direction, search and year range of one list. Years are strings
// (empty: no bound) as typed.
export struct ListQuery {
    sort: int,
    desc: bool,
    search: string,
    year-from: string,
    year-to: string,
}

// What the detail page shows. `kind`: 0 album, 1 artist, 2 playlist,
// 3 similar tracks. `subtitle-id`: artist to open from the subtitle.
// A titled group of the artist page's releases with its own card grid.
export struct ReleaseGroupRow {
    title: string,
    count: int,
    grid: int,
    rows: [AlbumRow],
}

// A use of a work on the album: "OP · ED" and the track title.
export struct WorkUseRow {
    label: string,
    title: string,
}

// A work linked to the open album (header capsules, inspector).
export struct AlbumWorkRow {
    id: int,
    title: string,
    translated: string,
    meta: string,
    relation: string,
    usage: string,
    ost: bool,
    // 72 x 108 (inspector), and the 20 x 30 capsule copy (a big texture
    // shrunk by the renderer looks jagged).
    poster: image,
    chip: image,
    uses: [WorkUseRow],
}

// Someone performing on / credited on the album's tracks.
export struct PersonRow {
    id: int,
    name: string,
    roles: string,
    avatar: image,
}

export struct FactRow {
    label: string,
    value: string,
}

export struct DetailInfo {
    // Small text above the title ("专辑", "单曲", ...); empty: by kind.
    kicker: string,
    kind: int,
    id: int,
    title: string,
    subtitle: string,
    subtitle-id: int,
    meta: string,
    quality: string,
    description: string,
    favorite: bool,
    custom-artwork: bool,
}

// Search, sort, direction, year range and the artist filter of a list.
// Edits are committed with `changed` (search and years debounced).
export component ListToolbar inherits HorizontalLayout {
    in property <[string]> sort-labels;
    // Default direction per sort (descending?).
    in property <[bool]> sort-desc;
    in property <ListQuery> query;
    in property <bool> show-order: true;
    in property <bool> show-years: false;
    in property <bool> show-search: true;
    in property <string> filter-label;
    callback changed(ListQuery);
    callback clear-filter();
    property <string> search: root.query.search;
    property <string> year-from: root.query.year-from;
    property <string> year-to: root.query.year-to;
    spacing: 10px;
    height: 40px;

    function commit(sort: int, desc: bool) {
        debounce.running = false;
        root.changed({
            sort: sort,
            desc: desc,
            search: root.search,
            year-from: root.year-from,
            year-to: root.year-to,
        });
    }

    debounce := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            root.commit(root.query.sort, root.query.desc);
        }
    }

    if root.show-search: SearchField {
        horizontal-stretch: 0;
        width: 300px;
        height: 40px;
        text <=> root.search;
        edited => {
            debounce.restart();
        }
        accepted => {
            root.commit(root.query.sort, root.query.desc);
        }
    }

    if root.sort-labels.length > 0: ComboBox {
        horizontal-stretch: 0;
        width: 150px;
        height: 40px;
        model: root.sort-labels;
        current-index: root.query.sort;
        selected => {
            root.commit(self.current-index, root.sort-desc[self.current-index]);
        }
    }

    if root.show-order && root.sort-labels.length > 0: Rectangle {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: order-area.has-hover ? Theme.bar : Theme.raised;
        Icon {
            kind: root.query.desc ? IconKind.sort-desc : IconKind.arrow-up;
            width: 17px;
            height: 17px;
            color: Theme.text-dim;
        }
        order-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.commit(root.query.sort, !root.query.desc);
            }
        }
    }

    if root.show-years: HorizontalLayout {
        horizontal-stretch: 0;
        spacing: 6px;
        SmallInput {
            width: 76px;
            height: 40px;
            placeholder: "起始年";
            text <=> root.year-from;
            edited => {
                debounce.restart();
            }
        }
        Text {
            text: "–";
            width: 10px;
            horizontal-alignment: center;
            color: Theme.text-faint;
            vertical-alignment: center;
        }
        SmallInput {
            width: 76px;
            height: 40px;
            placeholder: "结束年";
            text <=> root.year-to;
            edited => {
                debounce.restart();
            }
        }
    }

    if root.filter-label != "": Chip {
        y: 3px;
        text: root.filter-label;
        removed => {
            root.clear-filter();
        }
    }

    // Page actions on the right (随机播放全部, 新建歌单).
    Rectangle {
        horizontal-stretch: 1;
    }
    @children
}

// Page title (64 / 850) with its count, then the filter bar (the children)
// over a rule (v3 Editorial list pages).
export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> count;
    vertical-stretch: 0;
    padding-left: Shell.pad;
    padding-right: Shell.pad;
    padding-top: Shell.tier == 2 ? 44px : 32px;
    spacing: 0px;

    HorizontalLayout {
        spacing: 14px;
        alignment: start;
        Text {
            text: root.title;
            font-family: Fonts.family(self.text);
            color: Theme.text;
            font-size: Shell.tier == 2 ? Theme.font-page : Shell.tier == 1 ? 52px : 44px;
            font-weight: 850;
            letter-spacing: Shell.tier == 2 ? -2.2px : -1.6px;
            vertical-alignment: bottom;
        }
        Text {
            text: root.count;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 16px;
            font-weight: 600;
            vertical-alignment: bottom;
            // Baseline-ish next to the big title.
            height: self.preferred-height + (Shell.tier == 2 ? 10px : 7px);
            y: parent.height - self.height;
        }
    }
    VerticalLayout {
        padding-top: Shell.tier == 2 ? 26px : 20px;
        padding-bottom: Shell.tier == 2 ? 26px : 20px;
        spacing: 12px;
        @children
    }
    Rectangle {
        height: 1px;
        background: Theme.border;
    }
    Rectangle {
        height: Shell.tier == 2 ? 32px : 24px;
    }
}

// Cards without virtualization (short lists inside a scrolling page).
export component CardRows inherits VerticalLayout {
    in property <[AlbumRow]> rows;
    in property <int> kind;
    in property <[PlaylistChoice]> playlists;
    // Smallest card and the side padding.
    in property <length> min-size: 160px;
    in property <length> side: 32px;
    // Fixed column count (0: as many as fit `min-size`).
    in property <int> fixed-columns: 0;
    // Gap between cards in a row, and between rows.
    in property <length> gap: 24px;
    in property <length> row-gap: 20px;
    // Cards shown at most (0: all); reported through `limit-changed`.
    in property <int> max-items: 0;
    // A plain `for` instantiates every row: with `lazy`, a row reports
    // `row-shown` once it overlaps [view-top, view-bottom] (this
    // component's coordinates) and only then loads its covers.
    in property <bool> lazy;
    in property <length> view-top;
    in property <length> view-bottom;
    callback layout-changed(int, length);
    callback limit-changed(int);
    callback action(string, int, int);
    callback row-shown(int);
    out property <int> columns: root.fixed-columns > 0 ? root.fixed-columns : max(1, floor((self.width - 2 * root.side + root.gap) / (root.min-size + root.gap)));
    // Whole physical pixels, so covers decoded at this size draw 1:1.
    out property <length> card-size: floor(((self.width - 2 * root.side - (root.columns - 1) * root.gap) / root.columns) / 1phx) * 1phx;
    changed card-size => {
        root.layout-changed(root.columns, root.card-size);
    }
    changed columns => {
        root.layout-changed(root.columns, root.card-size);
    }
    changed max-items => {
        root.limit-changed(root.max-items);
    }
    init => {
        root.limit-changed(root.max-items);
        root.layout-changed(root.columns, root.card-size);
    }
    spacing: root.row-gap;

    for row[ri] in root.rows: HorizontalLayout {
        property <bool> in-view: root.lazy && self.height > 0 && self.y + self.height > root.view-top && self.y < root.view-bottom;
        changed in-view => {
            if self.in-view {
                root.row-shown(ri);
            }
        }
        init => {
            if self.in-view {
                root.row-shown(ri);
            }
        }
        padding-left: root.side;
        padding-right: root.side;
        spacing: root.gap;
        alignment: start;
        for card in row.items: CardView {
            card: card;
            kind: root.kind;
            size: root.card-size;
            playlists: root.playlists;
            action(what, arg) => {
                root.action(what, card.id, arg);
            }
        }
    }
}

component MenuRow inherits Rectangle {
    in property <string> text;
    in property <bool> danger;
    callback clicked();
    height: 30px;
    border-radius: 4px;
    background: menu-area.has-hover ? Theme.surface-hover : transparent;
    Text {
        x: 10px;
        text: root.text;
        font-family: Fonts.family(self.text);
        color: root.danger ? Theme.danger : Theme.text;
        vertical-alignment: center;
        height: 100%;
        width: parent.width - 20px;
        overflow: elide;
    }
    menu-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Cover, titles and actions of an album / artist / playlist / similar page
// (v3 Editorial album head): a 380 cover, an oversized title (132, steps
// down when long), the artist, meta, work capsules and pill buttons; on
// wide pages the release facts sit on the right (`facts`).
export component DetailHeader inherits Rectangle {
    in property <DetailInfo> info;
    in property <image> cover;
    in property <bool> loading;
    // The server takes custom playlist artwork.
    in property <bool> artwork-upload;
    in property <[PlaylistChoice]> playlists;
    // Works linked to the album (capsules under the title).
    in property <[AlbumWorkRow]> works;
    // Release facts shown on the right when there is room.
    in property <[FactRow]> facts;
    out property <bool> facts-shown: root.facts.length > 0 && Shell.tier == 2
        && root.width - 2 * root.pad - root.art - 360px - 2 * root.gap >= 420px;
    // (action, argument): play, shuffle, next, last, favorite, add,
    // new-playlist, artist, edit, delete, artwork, artwork-reset,
    // artist-tracks, artist-albums, work (id).
    callback action(string, int);
    property <length> pad: Shell.pad;
    property <length> art: round(Shell.detail-art / 1phx) * 1phx;
    property <length> gap: Shell.tier == 2 ? 48px : Shell.tier == 1 ? 36px : 28px;
    property <length> top: Shell.tier == 2 ? 56px : 44px;
    property <length> bottom: Shell.tier == 2 ? 40px : 28px;
    property <string> kicker: root.info.kicker != "" ? root.info.kicker : root.info.kind == 0 ? "专辑" : root.info.kind == 1 ? "艺人" : root.info.kind == 2 ? "歌单" : "相似歌曲";
    height: max(root.art, info-col.preferred-height) + root.top + root.bottom;

    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        padding-top: root.top;
        padding-bottom: root.bottom;
        spacing: root.gap;

        Rectangle {
            width: root.art;
            height: root.art;
            y: (parent.height - self.height) / 2;
            border-radius: root.info.kind == 1 ? root.art / 2 : 0px;
            background: Theme.raised;
            clip: true;
            drop-shadow-blur: 48px;
            drop-shadow-offset-y: 28px;
            drop-shadow-color: #000000b0;
            Rectangle {
                border-radius: root.info.kind == 1 ? root.art / 2 : 0px;
                clip: true;
                Image {
                    source: root.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
            }
        }

        info-col := VerticalLayout {
            alignment: end;
            spacing: 0px;
            horizontal-stretch: 1;
            min-width: 0px;

            BigTitle {
                text: root.loading && root.info.title == "" ? "加载中…" : root.info.title;
                max-size: Shell.tier == 2 ? Theme.font-album : Shell.tier == 1 ? 80px : 64px;
                weight: 880;
                tracking: -0.045;
            }
            if root.info.subtitle != "": HorizontalLayout {
                alignment: start;
                padding-top: Shell.tier == 2 ? 18px : 12px;
                Text {
                    text: root.info.subtitle;
                    font-family: Fonts.family(self.text);
                    color: subtitle-area.has-hover && root.info.subtitle-id > 0 ? Theme.accent-text : Theme.text;
                    font-size: Shell.tier == 2 ? 24px : Shell.tier == 1 ? 20px : 18px;
                    font-weight: 650;
                    overflow: elide;
                    subtitle-area := TouchArea {
                        mouse-cursor: root.info.subtitle-id > 0 ? pointer : default;
                        clicked => {
                            if root.info.subtitle-id > 0 {
                                root.action("artist", root.info.subtitle-id);
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                padding-top: 10px;
                Text {
                    text: root.info.meta != "" ? root.kicker + " · " + root.info.meta : root.kicker;
                    font-family: Fonts.family(self.text);
                    color: Theme.text-dim;
                    font-size: 15px;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.info.quality != "": Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: quality-text.preferred-width + 14px;
                    height: 20px;
                    border-radius: 5px;
                    background: Theme.raised;
                    quality-text := Text {
                        text: root.info.quality;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-dim;
                        font-size: 11.5px;
                        font-weight: 600;
                    }
                }
            }
            if root.info.description != "": Text {
                text: root.info.description;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 14px;
                wrap: word-wrap;
                overflow: elide;
                max-height: 40px;
            }
            // Work capsules (web album hero): poster, title, use.
            // Clipped: its width must not widen the header (the title elides).
            if root.works.length > 0: Rectangle {
                min-width: 0px;
                preferred-width: 0px;
                height: 56px;
                clip: true;
                HorizontalLayout {
                    x: 0;
                    y: 16px;
                    width: max(parent.width, self.preferred-width);
                    spacing: 10px;
                    alignment: start;
                    height: 40px;
                    for w in root.works: Rectangle {
                        height: 40px;
                        width: min(360px, capsule.preferred-width);
                        border-radius: 20px;
                        background: capsule-area.has-hover ? Theme.surface-hover : Theme.raised;
                        capsule := HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 14px;
                            spacing: 9px;
                            Rectangle {
                                width: 20px;
                                height: 30px;
                                y: 5px;
                                border-radius: 4px;
                                background: Theme.surface;
                                clip: true;
                                Image {
                                    source: w.chip;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: ImageFit.cover;
                                }
                            }
                            Text {
                                text: w.title;
                                font-family: Fonts.family(self.text);
                                color: Theme.text;
                                font-size: 13.5px;
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 240px;
                            }
                            if w.usage != "": Text {
                                text: w.usage;
                                font-family: Fonts.family(self.text);
                                color: w.ost ? Theme.text-dim : Theme.accent-text;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                        capsule-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.action("work", w.id);
                            }
                        }
                    }
                }
            }

            // Clipped: its width must not widen the header (the title elides).
            Rectangle {
                min-width: 0px;
                preferred-width: 0px;
                height: Shell.tier == 2 ? 64px : 56px;
                clip: true;
                buttons := HorizontalLayout {
                    x: 0;
                    y: parent.height - 40px;
                    height: 40px;
                    width: max(parent.width, self.preferred-width);
                    spacing: 10px;
                    alignment: start;
                    PrimaryButton {
                        text: "播放";
                        has-icon: true;
                        clicked => {
                            root.action("play", 0);
                        }
                    }
                    GhostButton {
                        height: 40px;
                        text: "随机播放";
                        has-icon: true;
                        icon: IconKind.shuffle;
                        clicked => {
                            root.action("shuffle", 0);
                        }
                    }
                    if root.info.kind == 0 || root.info.kind == 1: RoundIconButton {
                        kind: root.info.favorite ? IconKind.heart : IconKind.heart-outline;
                        active: root.info.favorite;
                        clicked => {
                            root.action("favorite", root.info.favorite ? 0 : 1);
                        }
                    }
                    if root.info.kind == 3: GhostButton {
                        height: 40px;
                        text: "另存为歌单";
                        clicked => {
                            root.action("new-playlist", 0);
                        }
                    }
                    if root.info.kind != 2 && root.info.kind != 3: add-button := RoundIconButton {
                        kind: IconKind.list-plus;
                        clicked => {
                            add-menu.show();
                        }
                    }
                    more-button := RoundIconButton {
                        kind: IconKind.more;
                        clicked => {
                            more-menu.show();
                        }
                    }
                }
            }
        }

        // Release facts (album, wide pages), after a rule.
        if root.facts-shown: HorizontalLayout {
            width: 360px;
            spacing: 28px;
            Rectangle {
                width: 1px;
                height: facts-col.preferred-height;
                y: parent.height - self.height;
                background: Theme.border;
            }
            facts-col := VerticalLayout {
                alignment: end;
                spacing: 12px;
                horizontal-stretch: 1;
                for f[i] in root.facts: HorizontalLayout {
                    visible: i < 6;
                    height: i < 6 ? 20px : 0px;
                    spacing: 20px;
                    Text {
                        text: f.label;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-faint;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: f.value;
                        font-family: Fonts.family(self.text);
                        color: Theme.text;
                        font-size: 14px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // Menus open under the buttons row (the last button is "more").
    property <length> menu-x: root.pad + root.art + root.gap + min(buttons.preferred-width, info-col.width) - 220px;
    property <length> menu-y: info-col.y + info-col.height + root.top - 6px;

    more-menu := PopupWindow {
        x: max(0px, root.menu-x + 40px);
        y: root.menu-y;
        width: 180px;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                MenuRow {
                    text: "下一首播放";
                    clicked => {
                        root.action("next", 0);
                    }
                }
                MenuRow {
                    text: "添加到队列末尾";
                    clicked => {
                        root.action("last", 0);
                    }
                }
                if root.info.kind == 1: MenuRow {
                    text: "查看全部曲目";
                    clicked => {
                        root.action("artist-tracks", 0);
                    }
                }
                if root.info.kind == 1: MenuRow {
                    text: "查看全部专辑";
                    clicked => {
                        root.action("artist-albums", 0);
                    }
                }
                if root.info.kind == 2: MenuRow {
                    text: "编辑名称和简介";
                    clicked => {
                        root.action("edit", 0);
                    }
                }
                if root.info.kind == 2 && root.artwork-upload: MenuRow {
                    text: "更换封面…";
                    clicked => {
                        root.action("artwork", 0);
                    }
                }
                if root.info.kind == 2 && root.artwork-upload && root.info.custom-artwork: MenuRow {
                    text: "恢复默认封面";
                    clicked => {
                        root.action("artwork-reset", 0);
                    }
                }
                if root.info.kind == 2: MenuRow {
                    text: "删除歌单";
                    danger: true;
                    clicked => {
                        root.action("delete", 0);
                    }
                }
            }
        }
    }

    add-menu := PopupWindow {
        x: max(0px, root.menu-x - 10px);
        y: root.menu-y;
        width: 220px;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                MenuRow {
                    text: "新建歌单…";
                    clicked => {
                        root.action("new-playlist", 0);
                    }
                }
                Flickable {
                    height: min(240px, root.playlists.length * 30px);
                    VerticalLayout {
                        alignment: start;
                        for p in root.playlists: MenuRow {
                            text: p.name;
                            clicked => {
                                root.action("add", p.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// Modal dialog asking for a name and a description.
export component PromptDialog inherits Rectangle {
    in property <string> title;
    in property <string> confirm-text: "确定";
    in-out property <string> name;
    in-out property <string> description;
    callback confirm(string, string);
    callback cancel();
    background: #00000099;

    // Swallows clicks outside the card.
    TouchArea { }

    Rectangle {
        width: 420px;
        height: card.preferred-height;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        card := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: root.title;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }
            Field {
                label: "名称";
                text <=> root.name;
                accepted => {
                    if root.name != "" {
                        root.confirm(root.name, root.description);
                    }
                }
            }
            Field {
                label: "简介（可选）";
                text <=> root.description;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                GhostButton {
                    text: "取消";
                    clicked => {
                        root.cancel();
                    }
                }
                PrimaryButton {
                    text: root.confirm-text;
                    enabled: root.name != "";
                    width: 96px;
                    height: 32px;
                    clicked => {
                        root.confirm(root.name, root.description);
                    }
                }
            }
        }
    }
}

export component ConfirmDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    in property <string> confirm-text: "确定";
    callback confirm();
    callback cancel();
    background: #00000099;

    TouchArea { }

    Rectangle {
        width: 380px;
        height: card.preferred-height;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        card := VerticalLayout {
            padding: 24px;
            spacing: 16px;
            Text {
                text: root.title;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }
            Text {
                text: root.message;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                GhostButton {
                    text: "取消";
                    clicked => {
                        root.cancel();
                    }
                }
                Rectangle {
                    width: 96px;
                    height: 32px;
                    border-radius: Theme.radius;
                    background: danger-area.has-hover ? Theme.danger.brighter(10%) : Theme.danger;
                    Text {
                        text: root.confirm-text;
                        font-family: Fonts.family(self.text);
                        color: #ffffff;
                        font-weight: 600;
                    }
                    danger-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.confirm();
                        }
                    }
                }
            }
        }
    }
}

// Track details (right-click "查看信息"; Feishin item details, only the
// fields 032 has). Values can be selected and copied.
export component InfoDialog inherits Rectangle {
    in property <string> title;
    in property <[FactRow]> rows;
    callback close();
    background: #00000099;

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        width: min(560px, root.width - 64px);
        height: min(card.preferred-height, root.height - 64px);
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;
        // Clicks on the card do not close it.
        TouchArea { }

        card := VerticalLayout {
            padding: 24px;
            spacing: 14px;
            HorizontalLayout {
                Text {
                    text: "曲目信息";
                    color: Theme.text;
                    font-size: 18px;
                    font-weight: 700;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                IconButton {
                    kind: IconKind.close;
                    size: 30px;
                    icon-size: 14px;
                    clicked => {
                        root.close();
                    }
                }
            }
            info-flick := Flickable {
                vertical-stretch: 1;
                min-height: min(info-col.preferred-height, 200px);
                preferred-height: info-col.preferred-height;
                content-height: info-col.preferred-height;
                info-col := VerticalLayout {
                    width: info-flick.width;
                    spacing: 8px;
                    for f in root.rows: HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: f.label;
                            font-family: Fonts.family(self.text);
                            width: 72px;
                            color: Theme.text-faint;
                            font-size: 13px;
                        }
                        TextInput {
                            text: f.value;
                            read-only: true;
                            color: Theme.text;
                            font-size: 13px;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            selection-background-color: Theme.accent-dim;
                        }
                    }
                }
            }
        }
    }
}

// Inspector section head: title, a faint count, a rule to the edge.
component InspectorHead inherits HorizontalLayout {
    in property <string> text;
    in property <string> count;
    spacing: 12px;
    height: 34px;
    Text {
        text: root.text;
        font-family: Fonts.family(self.text);
        color: Theme.text;
        font-size: 15px;
        font-weight: 700;
        vertical-alignment: center;
    }
    if root.count != "": Text {
        text: root.count;
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
        font-size: 12.5px;
        font-weight: 500;
        vertical-alignment: center;
    }
    Rectangle {
        horizontal-stretch: 1;
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
}

component InspectorMore inherits Text {
    callback clicked();
    color: more-area.has-hover ? Theme.accent-text : Theme.text-dim;
    font-size: 13px;
    more-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component Facts inherits VerticalLayout {
    in property <[FactRow]> rows;
    spacing: 10px;
    for f in root.rows: HorizontalLayout {
        spacing: 16px;
        Text {
            text: f.label;
            font-family: Fonts.family(self.text);
            width: 72px;
            color: Theme.text-faint;
            font-size: 14px;
        }
        Text {
            text: f.value;
            font-family: Fonts.family(self.text);
            color: Theme.text;
            font-size: 14px;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
    }
}

// Right-hand column of the 032 album page (`Music032AlbumInspector`):
// linked works with their track uses, release facts, people, media.
export component AlbumInspector inherits Flickable {
    in property <[AlbumWorkRow]> works;
    in property <[FactRow]> release;
    in property <[PersonRow]> people;
    in property <[FactRow]> media;
    in property <string> review;
    // Right padding (the page's).
    in property <length> pad: Shell.pad;
    // (action, id): work, artist.
    callback action(string, int);
    property <bool> all-works;
    property <bool> all-people;
    property <int> expanded-work: -1;
    content-height: col.preferred-height;

    col := VerticalLayout {
        width: root.width;
        padding-right: root.pad;
        padding-top: 8px;
        padding-bottom: 32px;
        spacing: 32px;
        alignment: start;

        if root.works.length > 0: VerticalLayout {
            spacing: 4px;
            InspectorHead {
                text: "关联作品";
                count: root.works.length;
            }
            // Hidden entries take no height; spacing 0 so they leave no gap.
            VerticalLayout {
                spacing: 0;
            for w[i] in root.works: Rectangle {
                visible: root.all-works || i < 3;
                height: self.visible ? work-col.preferred-height : 0px;
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
                work-col := VerticalLayout {
                    y: 0;
                    height: self.preferred-height;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 18px;
                        Rectangle {
                            width: 72px;
                            height: 108px;
                            border-radius: 5px;
                            background: Theme.raised;
                            drop-shadow-blur: 8px;
                            drop-shadow-offset-y: 2px;
                            drop-shadow-color: #00000066;
                            Rectangle {
                                border-radius: 5px;
                                clip: true;
                                if w.poster.width == 0: Text {
                                    text: "作";
                                    color: Theme.text-faint;
                                }
                                Image {
                                    source: w.poster;
                                    width: 100%;
                                    height: 100%;
                                    image-fit: ImageFit.cover;
                                }
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.action("work", w.id);
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: w.title;
                                font-family: Fonts.family(self.text);
                                color: head-area.has-hover ? Theme.accent-text : Theme.text;
                                font-size: 15px;
                                font-weight: 650;
                                wrap: word-wrap;
                                head-area := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.action("work", w.id);
                                    }
                                }
                            }
                            if w.translated != "": Text {
                                text: w.translated;
                                font-family: Fonts.family(self.text);
                                color: Theme.text-dim;
                                font-size: 13px;
                                overflow: elide;
                            }
                            // Track uses: "OP" tag and the title.
                            if w.uses.length > 0: VerticalLayout {
                                spacing: 0;
                                padding-top: 4px;
                            for u[j] in w.uses: Rectangle {
                                visible: root.expanded-work == i || j < 3;
                                height: self.visible ? 26px : 0px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        height: 20px;
                                        width: min(80px, use-label.preferred-width + 14px);
                                        border-radius: 5px;
                                        background: Theme.accent-dim;
                                        use-label := Text {
                                            text: u.label;
                                            font-family: Fonts.family(self.text);
                                            color: Theme.accent-text;
                                            font-size: 11px;
                                            font-weight: 700;
                                            overflow: elide;
                                        }
                                    }
                                    Text {
                                        text: u.title;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text;
                                        font-size: 13px;
                                        overflow: elide;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            }
                            if w.uses.length > 3 && root.expanded-work != i: InspectorMore {
                                text: "显示全部 " + w.uses.length + " 首";
                                clicked => {
                                    root.expanded-work = i;
                                }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text {
                                    text: w.meta;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-faint;
                                    font-size: 12.5px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                                // Album-level relation ("原声集 OST").
                                if w.ost && w.relation != "": Rectangle {
                                    height: 18px;
                                    width: rel.preferred-width + 12px;
                                    border-radius: 5px;
                                    background: Theme.raised;
                                    rel := Text {
                                        text: w.relation;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text-dim;
                                        font-size: 11px;
                                        font-weight: 600;
                                    }
                                }
                            }
                        }
                    }
                }
            }
            }
            if root.works.length > 3 && !root.all-works: InspectorMore {
                text: "显示全部 " + root.works.length + " 部";
                clicked => {
                    root.all-works = true;
                }
            }
        }

        if root.release.length > 0: VerticalLayout {
            spacing: 10px;
            InspectorHead {
                text: "发行信息";
            }
            Facts {
                rows: root.release;
            }
        }

        if root.people.length > 0: VerticalLayout {
            spacing: 8px;
            InspectorHead {
                text: "参与者";
                count: root.people.length;
            }
            VerticalLayout {
                spacing: 0;
            for p[i] in root.people: Rectangle {
                visible: root.all-people || i < 8;
                height: self.visible ? 48px : 0px;
                border-radius: 8px;
                background: person-area.has-hover ? Theme.surface-hover : transparent;
                person-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.action("artist", p.id);
                    }
                }
                HorizontalLayout {
                    padding-left: 2px;
                    spacing: 12px;
                    Rectangle {
                        width: 36px;
                        height: 36px;
                        y: 6px;
                        border-radius: 18px;
                        background: Theme.raised;
                        clip: true;
                        if p.avatar.width == 0: Text {
                            text: p.name == "" ? "?" : "♪";
                            font-family: Fonts.family(self.text);
                            color: Theme.text-faint;
                            font-size: 13px;
                        }
                        Image {
                            source: p.avatar;
                            width: 100%;
                            height: 100%;
                            image-fit: ImageFit.cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text {
                            text: p.name;
                            font-family: Fonts.family(self.text);
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: p.roles;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-faint;
                            font-size: 12.5px;
                            overflow: elide;
                        }
                    }
                }
            }
            }
            if root.people.length > 8 && !root.all-people: InspectorMore {
                text: "显示全部 " + root.people.length + " 位";
                clicked => {
                    root.all-people = true;
                }
            }
        }

        if root.media.length > 0: VerticalLayout {
            spacing: 10px;
            InspectorHead {
                text: "媒体信息";
            }
            Facts {
                rows: root.media;
            }
        }

        if root.review != "": VerticalLayout {
            spacing: 10px;
            InspectorHead {
                text: "简介";
            }
            Text {
                text: root.review;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 14px;
                wrap: word-wrap;
            }
        }
    }
}
