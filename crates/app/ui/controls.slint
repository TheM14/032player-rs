import { Theme } from "theme.slint";

// Horizontal bar with drag-to-set. `value` is 0..1; while dragging the bar
// follows the pointer and `committed` fires on release (`live` fires on move).
export component ValueBar inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    callback committed(float);
    callback live(float);
    out property <bool> dragging: false;
    property <float> drag-value;
    property <float> shown: root.dragging ? root.drag-value : max(0, min(1, root.value));
    height: 16px;

    Rectangle {
        y: (parent.height - 4px) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.raised;
        Rectangle {
            x: 0;
            width: parent.width * root.shown;
            height: 100%;
            border-radius: 2px;
            background: area.has-hover || root.dragging ? Theme.accent : Theme.text-dim;
        }
    }

    Rectangle {
        visible: root.enabled && (area.has-hover || root.dragging);
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.text;
        x: parent.width * root.shown - 6px;
        y: (parent.height - 12px) / 2;
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                root.dragging = true;
                root.drag-value = max(0, min(1, self.mouse-x / self.width));
                root.live(root.drag-value);
            }
            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging {
                root.dragging = false;
                root.committed(root.drag-value);
            }
        }
        moved => {
            if root.dragging {
                root.drag-value = max(0, min(1, self.mouse-x / self.width));
                root.live(root.drag-value);
            }
        }
    }
}

export enum IconKind { play, pause, next, previous, lyrics, shuffle, repeat, repeat-one, queue, close, sleep, heart, heart-outline, back, search, plus, arrow-up, arrow-down, more }

// Vector icons (no icon font dependency). Transport icons are filled,
// the others are drawn with a stroke in the same color.
export component Icon inherits Path {
    in property <IconKind> kind;
    in property <color> color: Theme.text;
    property <bool> stroked: root.kind == IconKind.shuffle || root.kind == IconKind.repeat
        || root.kind == IconKind.repeat-one || root.kind == IconKind.queue || root.kind == IconKind.close
        || root.kind == IconKind.sleep || root.kind == IconKind.heart-outline || root.kind == IconKind.back
        || root.kind == IconKind.search || root.kind == IconKind.plus || root.kind == IconKind.arrow-up
        || root.kind == IconKind.arrow-down;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.stroked ? transparent : root.color;
    stroke: root.stroked ? root.color : transparent;
    stroke-width: root.stroked ? 1.8px : 0;
    commands: root.kind == IconKind.play ? "M 7 4 L 20 12 L 7 20 Z"
        : root.kind == IconKind.pause ? "M 6 4 L 10 4 L 10 20 L 6 20 Z M 14 4 L 18 4 L 18 20 L 14 20 Z"
        : root.kind == IconKind.next ? "M 5 5 L 15 12 L 5 19 Z M 16 5 L 19 5 L 19 19 L 16 19 Z"
        : root.kind == IconKind.previous ? "M 19 5 L 9 12 L 19 19 Z M 5 5 L 8 5 L 8 19 L 5 19 Z"
        : root.kind == IconKind.shuffle ? "M 3 7 L 7 7 C 12 7 12 17 17 17 L 21 17 M 3 17 L 7 17 C 12 17 12 7 17 7 L 21 7 M 18 4 L 21 7 L 18 10 M 18 14 L 21 17 L 18 20"
        : root.kind == IconKind.repeat ? "M 4 12 L 4 10 C 4 8 5 7 7 7 L 20 7 M 17 4 L 20 7 L 17 10 M 20 12 L 20 14 C 20 16 19 17 17 17 L 4 17 M 7 14 L 4 17 L 7 20"
        : root.kind == IconKind.repeat-one ? "M 4 12 L 4 10 C 4 8 5 7 7 7 L 20 7 M 17 4 L 20 7 L 17 10 M 20 12 L 20 14 C 20 16 19 17 17 17 L 4 17 M 7 14 L 4 17 L 7 20"
        : root.kind == IconKind.queue ? "M 4 6 L 17 6 M 4 11 L 17 11 M 4 16 L 11 16 M 15 14 L 15 20 L 20 17 Z"
        : root.kind == IconKind.close ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : root.kind == IconKind.sleep ? "M 19 14.5 A 7.5 7.5 0 1 1 9.5 5 A 6 6 0 0 0 19 14.5 Z"
        : root.kind == IconKind.heart || root.kind == IconKind.heart-outline ? "M 12 20 C 12 20 3 14.5 3 8.5 C 3 5.5 5.5 3.5 8 3.5 C 9.8 3.5 11.2 4.5 12 6 C 12.8 4.5 14.2 3.5 16 3.5 C 18.5 3.5 21 5.5 21 8.5 C 21 14.5 12 20 12 20 Z"
        : root.kind == IconKind.back ? "M 15 5 L 8 12 L 15 19"
        : root.kind == IconKind.search ? "M 4 10.5 A 6.5 6.5 0 1 0 17 10.5 A 6.5 6.5 0 1 0 4 10.5 Z M 15.2 15.2 L 20 20"
        : root.kind == IconKind.plus ? "M 12 5 L 12 19 M 5 12 L 19 12"
        : root.kind == IconKind.arrow-up ? "M 12 19 L 12 5 M 6 11 L 12 5 L 18 11"
        : root.kind == IconKind.arrow-down ? "M 12 5 L 12 19 M 6 13 L 12 19 L 18 13"
        : root.kind == IconKind.more ? "M 4.5 10.5 L 7.5 10.5 L 7.5 13.5 L 4.5 13.5 Z M 10.5 10.5 L 13.5 10.5 L 13.5 13.5 L 10.5 13.5 Z M 16.5 10.5 L 19.5 10.5 L 19.5 13.5 L 16.5 13.5 Z"
        : "M 4 6 L 20 6 L 20 8 L 4 8 Z M 4 11 L 16 11 L 16 13 L 4 13 Z M 4 16 L 18 16 L 18 18 L 4 18 Z";
}

export component IconButton inherits Rectangle {
    in property <IconKind> kind;
    in property <length> size: 36px;
    in property <length> icon-size: 18px;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> filled: false;
    // Small text at the top right (repeat-one "1").
    in property <string> badge;
    callback clicked();
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.filled ? (area.pressed ? Theme.accent.darker(20%) : Theme.accent)
        : area.has-hover ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Icon {
        kind: root.kind;
        width: root.icon-size;
        height: root.icon-size;
        color: root.filled ? #ffffff : root.active ? Theme.accent : Theme.text;
    }

    if root.badge != "": Text {
        x: parent.width / 2 + root.icon-size / 2 - 4px;
        y: parent.height / 2 - root.icon-size / 2 - 4px;
        text: root.badge;
        font-size: 9px;
        font-weight: 700;
        color: root.active ? Theme.accent : Theme.text;
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Rounded text input with label (std LineEdit has no dark 032 look).
export component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> placeholder;
    in property <bool> password: false;
    in-out property <string> text;
    callback accepted();
    callback edited();
    spacing: 6px;

    Text {
        text: root.label;
        color: Theme.text-dim;
        font-size: 12px;
    }

    Rectangle {
        height: 38px;
        border-radius: Theme.radius;
        background: Theme.bg;
        border-width: 1px;
        border-color: input.has-focus ? Theme.accent : Theme.border;
        input := TextInput {
            x: 12px;
            width: parent.width - 24px;
            height: 100%;
            vertical-alignment: center;
            text <=> root.text;
            color: Theme.text;
            selection-background-color: Theme.accent-dim;
            input-type: root.password ? InputType.password : InputType.text;
            single-line: true;
            accepted => {
                root.accepted();
            }
            edited => {
                root.edited();
            }
        }

        Text {
            x: 12px;
            visible: root.text == "" && !input.has-focus;
            text: root.placeholder;
            color: Theme.text-faint;
            vertical-alignment: center;
            height: 100%;
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    height: 40px;
    border-radius: Theme.radius;
    background: !root.enabled ? Theme.raised : area.pressed ? Theme.accent.darker(20%) : area.has-hover ? Theme.accent.brighter(10%) : Theme.accent;

    Text {
        text: root.text;
        color: root.enabled ? #ffffff : Theme.text-faint;
        font-weight: 600;
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Search box with icon, placeholder and clear button.
export component SearchField inherits Rectangle {
    in property <string> placeholder: "搜索";
    in-out property <string> text;
    // Fires on every edit (callers debounce) and on Enter.
    callback edited();
    callback accepted();
    forward-focus: input;
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;

    Icon {
        x: 8px;
        kind: IconKind.search;
        width: 16px;
        height: 16px;
        color: Theme.text-faint;
    }

    input := TextInput {
        x: 30px;
        width: parent.width - 30px - 28px;
        height: 100%;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        selection-background-color: Theme.accent-dim;
        single-line: true;
        edited => {
            root.edited();
        }
        accepted => {
            root.accepted();
        }
    }

    Text {
        x: 30px;
        visible: root.text == "";
        text: root.placeholder;
        color: Theme.text-faint;
        vertical-alignment: center;
        height: 100%;
    }

    if root.text != "": Rectangle {
        x: parent.width - 26px;
        width: 20px;
        height: 20px;
        Icon {
            kind: IconKind.close;
            width: 12px;
            height: 12px;
            color: clear-area.has-hover ? Theme.text : Theme.text-faint;
        }
        clear-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.text = "";
                root.edited();
                root.accepted();
            }
        }
    }
}

// Bordered text button, optionally with an icon.
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <IconKind> icon: IconKind.plus;
    in property <bool> has-icon: false;
    in property <bool> enabled: true;
    in property <bool> active: false;
    callback clicked();
    height: 32px;
    min-width: label.preferred-width + (root.has-icon ? 44px : 24px);
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border;
    background: root.active ? Theme.accent-dim : area.has-hover ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;
        if root.has-icon: Icon {
            kind: root.icon;
            width: 14px;
            height: 14px;
            y: (parent.height - self.height) / 2;
            color: root.active ? Theme.accent : Theme.text;
        }
        label := Text {
            text: root.text;
            color: root.active ? Theme.accent : Theme.text;
            vertical-alignment: center;
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Small text input for numbers (year range).
export component SmallInput inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> text;
    callback edited();
    width: 64px;
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.bg;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.border;
    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: 100%;
        vertical-alignment: center;
        text <=> root.text;
        color: Theme.text;
        single-line: true;
        input-type: InputType.number;
        edited => {
            root.edited();
        }
    }
    Text {
        x: 8px;
        visible: root.text == "" && !input.has-focus;
        text: root.placeholder;
        color: Theme.text-faint;
        vertical-alignment: center;
        height: 100%;
    }
}

// Removable filter label ("艺人：X ×").
export component Chip inherits Rectangle {
    in property <string> text;
    callback removed();
    height: 28px;
    width: chip-label.preferred-width + 40px;
    border-radius: 14px;
    background: Theme.accent-dim;
    chip-label := Text {
        x: 12px;
        text: root.text;
        color: Theme.text;
        font-size: 12px;
        vertical-alignment: center;
        height: 100%;
    }
    Rectangle {
        x: parent.width - 24px;
        width: 16px;
        height: 16px;
        Icon {
            kind: IconKind.close;
            width: 10px;
            height: 10px;
            color: chip-area.has-hover ? Theme.text : Theme.text-dim;
        }
        chip-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.removed();
            }
        }
    }
}

// Tab strip entry.
export component Tab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 32px;
    width: tab-label.preferred-width + 24px;
    tab-label := Text {
        text: root.text;
        color: root.selected ? Theme.text : tab-area.has-hover ? Theme.text : Theme.text-dim;
        font-weight: root.selected ? 600 : 400;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        x: 8px;
        width: parent.width - 16px;
        background: root.selected ? Theme.accent : transparent;
    }
    tab-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}
