import { ArtistLayout, ArtistLinks, CreditPart } from "views.slint";
import { ArtFit, Fonts, Theme } from "theme.slint";
import { Icon, IconKind } from "controls.slint";
import { PillTab, SourceBadge, QualityTag } from "nowplaying.slint";

// Full-screen player (v3 Editorial, `docs/UI-REDESIGN.md` D5) over the
// sidebar and the content; the player bar stays below. Plain dark stage
// (no cover-derived background).
//
// Wide (>= 1700): three columns - the cover, title and tags on the left,
// the lyrics in the middle (always shown, tools in their header row) and
// "接下来播放 / 相关歌曲" tabs on the right. Narrower: the cover column and
// the three tabs (up next / related / lyrics) as before.
//
// The panes are the children: they are placed with the geometry this
// component exposes (`lyrics-*`, `side-*`, `tools-*`; `pane-*` for the
// narrow tab pane), relative to the whole component.
export component FullScreenPlayer inherits Rectangle {
    in property <image> cover;
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <[CreditPart]> artists;
    in property <string> album;
    in property <string> quality;
    in property <bool> exclusive;
    in property <int> exclusive-mode;
    in property <bool> asio-fallback;
    in property <bool> bit-perfect;
    in property <string> lyrics-source;
    // 0 up next, 1 related, 2 lyrics (narrow layout; wide shows the
    // lyrics anyway and treats 2 as up next).
    in property <int> tab;
    callback tab-selected(int);
    callback close();
    callback open-album();
    callback open-artist(int);
    // The track info dialog of the current track.
    callback show-info();
    // The cover side settled (after resizing): decode the artwork for it.
    callback cover-resized(length);

    out property <bool> wide: root.width >= 1700px;

    // Wide geometry (the mockup at 2300: 120 / 620 / 120 / lyrics / 60 /
    // 440 / 60).
    property <length> pad-x: clamp(root.width * 0.052, 48px, 120px);
    property <length> wide-cover: round(max(240px, min(clamp(root.width * 0.27, 360px, 620px), root.height - 110px - 270px)) / 1phx) * 1phx;
    out property <length> lyrics-x: root.pad-x + root.wide-cover + root.pad-x;
    out property <length> lyrics-y: 100px;
    out property <length> side-w: 440px;
    out property <length> side-x: root.width - 60px - root.side-w;
    out property <length> lyrics-w: max(200px, root.side-x - 60px - root.lyrics-x);
    out property <length> lyrics-h: root.height - root.lyrics-y - 40px;
    out property <length> side-y: 90px + 52px;
    out property <length> side-h: root.height - root.side-y - 40px;
    // Lyrics tools in the header row of the lyrics column.
    out property <length> tools-x: root.lyrics-x + lyrics-head.preferred-width + 16px;
    out property <length> tools-y: 25px;

    // Narrow geometry: cover column 42%, tabs 58%.
    property <length> pad: 48px;
    property <length> gap: 56px;
    property <length> col-w: round((root.width - 2 * root.pad - root.gap) * 0.42 / 1phx) * 1phx;
    property <length> tabs-w: root.width - 2 * root.pad - root.gap - root.col-w;
    property <length> narrow-cover: round(max(120px, min(root.col-w, root.height - 2 * root.pad - 190px)) / 1phx) * 1phx;
    out property <length> pane-x: root.pad + root.col-w + root.gap;
    out property <length> pane-y: root.pad + 46px;
    out property <length> pane-width: root.tabs-w;
    out property <length> pane-height: root.height - root.pad - root.pane-y;

    out property <length> side: root.wide ? root.wide-cover : root.narrow-cover;

    background: Theme.stage;
    init => {
        root.cover-resized(root.side);
    }
    changed side => {
        resize-timer.restart();
    }
    resize-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.cover-resized(root.side);
        }
    }

    // Keep clicks and wheel events away from the page underneath.
    TouchArea {
        scroll-event(e) => {
            return accept;
        }
    }

    // Cover and metadata: left aligned at the top (wide) or centered in
    // the left column (narrow).
    Rectangle {
        x: root.wide ? root.pad-x : root.pad;
        y: root.wide ? 110px : root.pad;
        width: root.wide ? root.wide-cover : root.col-w;
        height: root.height - self.y - 40px;
        VerticalLayout {
            alignment: root.wide ? start : center;
            spacing: 0px;
            Rectangle {
                height: root.side;
                Rectangle {
                    width: ArtFit.width(root.side, root.side, root.cover);
                    height: ArtFit.height(root.side, root.side, root.cover);
                    x: root.wide ? 0px : (parent.width - self.width) / 2;
                    y: root.side - self.height;
                    border-radius: 14px;
                    background: root.cover.width == 0 ? Theme.raised : transparent;
                    drop-shadow-blur: 60px;
                    drop-shadow-offset-y: 30px;
                    drop-shadow-color: #000000b0;
                    Rectangle {
                        border-radius: 14px;
                        clip: true;
                        Image {
                            source: root.cover;
                            width: 100%;
                            height: 100%;
                            image-fit: ImageFit.cover;
                        }
                    }
                }
            }
            Rectangle {
                height: root.wide ? 36px : 28px;
            }
            Text {
                text: root.has-track ? root.title : "未在播放";
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: root.wide ? Theme.font-full-title : 34px;
                font-weight: 850;
                letter-spacing: root.wide ? -1.7px : -0.7px;
                horizontal-alignment: root.wide ? left : center;
                overflow: elide;
            }
            Rectangle {
                height: 10px;
            }
            if root.has-track: HorizontalLayout {
                min-width: 0px;
                alignment: root.wide ? start : center;
                spacing: 0px;
                ArtistLinks {
                    fallback: root.artist;
                    artists: root.artists;
                    text-color: Theme.text.with-alpha(0.75);
                    font-size: root.wide ? 22px : 18px;
                    open(id) => { root.open-artist(id); }
                }
                if root.album != "": Text {
                    text: " · ";
                    color: Theme.text.with-alpha(0.75);
                    font-size: root.wide ? 22px : 18px;
                    horizontal-stretch: 0;
                }
                if root.album != "": Text {
                    text: root.album;
                    font-family: Fonts.family(self.text);
                    color: album-area.has-hover ? Theme.text : Theme.text.with-alpha(0.75);
                    font-size: root.wide ? 22px : 18px;
                    overflow: elide;
                    min-width: ArtistLayout.cap-width(root.album, root.wide ? 22px : 18px, 140px);
                    album-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-album();
                        }
                    }
                }
            }
            Rectangle {
                height: 18px;
            }
            if root.has-track: HorizontalLayout {
                alignment: root.wide ? start : center;
                spacing: 10px;
                if root.quality != "": QualityTag {
                    y: (parent.height - self.height) / 2;
                    text: root.quality;
                }
                if root.exclusive: QualityTag {
                    y: (parent.height - self.height) / 2;
                    text: root.exclusive-mode == 2
                        ? (root.asio-fallback
                            ? (root.bit-perfect ? "WASAPI · Opus 回落" : "WASAPI · Opus")
                            : (root.bit-perfect ? "ASIO · bit-perfect" : "ASIO"))
                        : (root.bit-perfect ? "独占 · bit-perfect" : "独占");
                    text-color: Theme.ok;
                }
                Rectangle {
                    width: info-row.preferred-width;
                    height: 24px;
                    info-row := HorizontalLayout {
                        spacing: 6px;
                        Icon {
                            kind: IconKind.info;
                            width: 15px;
                            height: 15px;
                            y: (parent.height - self.height) / 2;
                            color: info-area.has-hover ? Theme.text : Theme.text-dim;
                        }
                        Text {
                            text: "曲目信息";
                            color: info-area.has-hover ? Theme.text : Theme.text-dim;
                            font-size: 13px;
                            vertical-alignment: center;
                        }
                    }
                    info-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.show-info();
                        }
                    }
                }
            }
        }
    }

    // Wide: the lyrics header ("歌词" and the source) and the right tabs.
    lyrics-head := HorizontalLayout {
        visible: root.wide;
        x: root.lyrics-x;
        y: 30px;
        width: self.preferred-width;
        height: 24px;
        spacing: 8px;
        Text {
            text: "歌词";
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
        }
        if root.lyrics-source != "": SourceBadge {
            y: 2px;
            text: root.lyrics-source;
        }
    }
    if root.wide: HorizontalLayout {
        x: root.side-x;
        y: 90px;
        width: root.side-w;
        height: 34px;
        spacing: 4px;
        alignment: start;
        PillTab {
            text: "接下来播放";
            on-stage: true;
            selected: root.tab != 1;
            clicked => {
                root.tab-selected(0);
            }
        }
        PillTab {
            text: "相关歌曲";
            on-stage: true;
            selected: root.tab == 1;
            clicked => {
                root.tab-selected(1);
            }
        }
    }

    // Narrow: the three tabs over the pane.
    if !root.wide: HorizontalLayout {
        x: root.pane-x;
        y: root.pad - 4px;
        width: root.tabs-w;
        height: 34px;
        alignment: center;
        spacing: 4px;
        for t[i] in ["接下来播放", "相关歌曲", "歌词"]: PillTab {
            text: t;
            on-stage: true;
            selected: root.tab == i;
            clicked => {
                root.tab-selected(i);
            }
        }
    }

    // The panes (children), positioned by the parent with the geometry above.
    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        @children
    }

    // Close (top left in the mockup).
    Rectangle {
        x: root.wide ? root.pad-x : 24px;
        y: root.wide ? 28px : 20px;
        width: 40px;
        height: 40px;
        border-radius: 20px;
        background: close-area.has-hover ? Theme.text.with-alpha(0.16) : Theme.text.with-alpha(0.08);
        Icon {
            kind: IconKind.chevron-down;
            width: 20px;
            height: 20px;
            color: Theme.text;
        }
        close-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.close();
            }
        }
    }
}
