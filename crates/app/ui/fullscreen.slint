import { Theme } from "theme.slint";
import { IconButton, IconKind, Tab } from "controls.slint";

// Full-screen player (Electron `full-screen-player.tsx`), over the sidebar
// and the content; the player bar stays below. Left: the original cover,
// the title, "artist · album" links and the quality. Right: tabs for up
// next / related / lyrics; the panes are the children. Background: the
// blurred cover (`core::backdrop`), like Electron's dynamic background.
export component FullScreenPlayer inherits Rectangle {
    in property <image> cover;
    in property <image> backdrop;
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> quality;
    // 0 up next, 1 related, 2 lyrics.
    in property <int> tab;
    callback tab-selected(int);
    callback close();
    callback open-album();
    callback open-artist();
    // The cover side settled (after resizing): decode the artwork for it.
    callback cover-resized(length);
    // Size of the pane slot (children use it: their `parent` is this
    // component, not the slot).
    out property <length> pane-width: pane.width;
    out property <length> pane-height: pane.height;

    property <length> pad: 48px;
    property <length> gap: 56px;
    // Cover column 42%, tabs 58% (track lists need the width).
    property <length> col-w: round((root.width - 2 * root.pad - root.gap) * 0.42 / 1phx) * 1phx;
    property <length> tabs-w: root.width - 2 * root.pad - root.gap - root.col-w;
    // Room for the cover above the title, links and quality (~150px).
    out property <length> side: round(max(120px, min(root.col-w, root.height - 2 * root.pad - 150px)) / 1phx) * 1phx;

    background: Theme.bg;
    init => {
        root.cover-resized(root.side);
    }
    changed side => {
        resize-timer.restart();
    }
    resize-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.cover-resized(root.side);
        }
    }

    // Keep clicks and wheel events away from the page underneath.
    TouchArea {
        scroll-event(e) => {
            return accept;
        }
    }

    Image {
        source: root.backdrop;
        width: 100%;
        height: 100%;
        image-fit: ImageFit.fill;
        opacity: 0.5;
    }
    Rectangle {
        background: @linear-gradient(180deg, Theme.bg.with-alpha(0.3) 0%, Theme.bg.with-alpha(0.88) 100%);
    }

    // Cover and metadata.
    Rectangle {
        x: root.pad;
        y: root.pad;
        width: root.col-w;
        height: root.height - 2 * root.pad;
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            Rectangle {
                height: root.side;
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    width: root.side;
                    height: root.side;
                    border-radius: 8px;
                    background: Theme.raised;
                    drop-shadow-blur: 32px;
                    drop-shadow-offset-y: 8px;
                    drop-shadow-color: #00000070;
                    Rectangle {
                        border-radius: 8px;
                        clip: true;
                        Image {
                            source: root.cover;
                            width: 100%;
                            height: 100%;
                            image-fit: ImageFit.cover;
                        }
                    }
                }
            }
            Rectangle {
                height: 28px;
            }
            Text {
                text: root.has-track ? root.title : "未在播放";
                color: Theme.text;
                font-size: 28px;
                font-weight: 800;
                horizontal-alignment: center;
                overflow: elide;
            }
            Rectangle {
                height: 10px;
            }
            if root.has-track: HorizontalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: root.artist;
                    color: artist-area.has-hover ? Theme.accent.brighter(20%) : Theme.accent;
                    font-size: 16px;
                    overflow: elide;
                    artist-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-artist();
                        }
                    }
                }
                if root.album != "": Text {
                    text: "·";
                    color: Theme.text-faint;
                    font-size: 16px;
                }
                if root.album != "": Text {
                    text: root.album;
                    color: album-area.has-hover ? Theme.accent.brighter(20%) : Theme.accent;
                    font-size: 16px;
                    overflow: elide;
                    album-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.open-album();
                        }
                    }
                }
            }
            Rectangle {
                height: 14px;
            }
            if root.has-track && root.quality != "": HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: quality-text.preferred-width + 14px;
                    height: 22px;
                    border-radius: 4px;
                    background: Theme.raised.with-alpha(0.8);
                    quality-text := Text {
                        text: root.quality;
                        color: Theme.text-dim;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }
            }
        }
    }

    // Tabs and their panes (the children).
    Rectangle {
        x: root.pad + root.col-w + root.gap;
        y: root.pad - 16px;
        width: root.tabs-w;
        height: root.height - 2 * root.pad + 16px;
        VerticalLayout {
            spacing: 12px;
            HorizontalLayout {
                alignment: center;
                spacing: 8px;
                for t[i] in ["接下来播放", "相关歌曲", "歌词"]: Tab {
                    text: t;
                    selected: root.tab == i;
                    clicked => {
                        root.tab-selected(i);
                    }
                }
            }
            // The panes clip themselves (list views / flickables).
            pane := Rectangle {
                vertical-stretch: 1;
                @children
            }
        }
    }

    IconButton {
        x: root.width - self.width - 16px;
        y: 12px;
        kind: IconKind.chevron-down;
        size: 36px;
        icon-size: 20px;
        clicked => {
            root.close();
        }
    }
}
