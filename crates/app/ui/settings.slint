import { ComboBox, LineEdit, Switch } from "std-widgets.slint";
import { Fonts, Theme, Shell } from "theme.slint";
import { CastState, GhostButton, RadioState } from "controls.slint";

component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    min-height: 64px;
    border-radius: Theme.radius;
    background: Theme.surface;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 24px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text {
                text: root.title;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-weight: 600;
            }
            if root.description != "": Text {
                text: root.description;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
            }
        }

        @children
    }
}

export struct ShortcutRow { title: string, binding: string }

export component SettingsView inherits Rectangle {
    in-out property <length> scroll-y;
    in property <[ShortcutRow]> shortcuts;
    in property <int> recording: -1;
    callback record-shortcut(int);
    callback clear-shortcut(int);
    callback reset-shortcuts();
    // Output devices for display; index 0 is the system default.
    in property <[string]> devices;
    in-out property <int> device-index;
    in-out property <bool> exclusive;
    // 0 off, 1 WASAPI exclusive, 2 ASIO.
    in-out property <int> exclusive-mode;
    in property <bool> asio-available;
    in property <bool> asio-fallback;
    in property <[string]> asio-drivers;
    in-out property <int> asio-driver-index;
    in property <string> asio-status;
    in property <[string]> asio-channel-pairs;
    in-out property <int> asio-channel-pair-index;
    // A device / exclusive change is being applied.
    in property <bool> output-busy;
    callback opened();
    callback device-selected(int);
    callback exclusive-toggled(bool);
    callback exclusive-mode-selected(int);
    callback asio-driver-selected(int);
    callback asio-channel-pair-selected(int);
    callback refresh-asio-driver();
    callback open-asio-control-panel();
    in property <bool> tray-available;
    in-out property <bool> close-to-tray;
    callback close-to-tray-toggled(bool);
    in-out property <bool> fade-on-pause;
    // 0 system, 1 dark, 2 light.
    in-out property <int> theme-mode;
    callback theme-selected(int);
    callback fade-on-pause-toggled(bool);
    // Index 0: the original file.
    in property <[string]> transcode-options;
    in-out property <int> transcode-index;
    callback transcode-selected(int);
    // Server lyrics translation is available.
    in property <bool> lyrics-translation;
    in-out property <int> lyrics-language;
    in-out property <int> lyrics-mode;
    in-out property <bool> lyrics-auto;
    callback lyrics-changed();
    // Signed-in server; logout (moved here from the sidebar).
    in property <string> server-label;
    callback logout();
    // "0.1.0"; the log folder (bug reports).
    in property <string> app-version;
    // A newer release (tag) and its page; empty: none known.
    in property <string> update-version;
    callback open-update();
    callback open-logs();

    init => {
        root.opened();
    }

    Flickable {
        content-y <=> root.scroll-y;
        content-height: settings-page.preferred-height + 24px;
        settings-page := VerticalLayout {
            width: parent.width;
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            padding-top: 24px;
            spacing: 12px;
            alignment: start;

            Text {
                text: "设置";
                color: Theme.text;
                font-size: 24px;
                font-weight: 700;
            }

            Text {
                text: "账户";
                color: Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
            }

            SettingRow {
                title: "服务器";
                description: root.server-label;
                GhostButton {
                    y: (parent.height - self.height) / 2;
                    text: "退出登录";
                    clicked => {
                        root.logout();
                    }
                }
            }

            SettingRow {
                title: "032player " + root.app-version;
                description: root.update-version != "" ? "有新版本 " + root.update-version + "，点击\"下载新版本\"打开发布页。"
                    : "反馈问题时请附上日志文件（logs/032player.log）。";
                if root.update-version != "": GhostButton {
                    y: (parent.height - self.height) / 2;
                    text: "下载新版本";
                    clicked => {
                        root.open-update();
                    }
                }
                GhostButton {
                    y: (parent.height - self.height) / 2;
                    text: "打开日志文件夹";
                    clicked => {
                        root.open-logs();
                    }
                }
            }

            Text {
                text: "外观";
                color: Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
            }

            SettingRow {
                title: "主题";
                description: "032 深色 / 032 浅色，或跟随系统的深浅色设置。";
                ComboBox {
                    width: 200px;
                    y: (parent.height - self.height) / 2;
                    model: ["跟随系统", "深色", "浅色"];
                    current-index <=> root.theme-mode;
                    selected => {
                        root.theme-selected(self.current-index);
                    }
                }
            }

            Text {
                text: "播放";
                color: Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
            }

            SettingRow {
                title: root.asio-available ? "WASAPI 输出设备" : "输出设备";
                description: root.asio-available
                    ? "用于共享或 WASAPI 独占模式（及 ASIO 模式下的 Opus 回落）。"
                    : "mpv 的音频输出设备";
                ComboBox {
                    width: 320px;
                    y: (parent.height - self.height) / 2;
                    model: root.devices;
                    current-index <=> root.device-index;
                    enabled: !root.output-busy;
                    selected => {
                        root.device-selected(self.current-index);
                    }
                }
            }

            if !root.asio-available: SettingRow {
                title: "独占模式";
                description: "WASAPI 独占输出，绕过系统混音。播放中可切换；部分设备不支持。";
                Switch {
                    y: (parent.height - self.height) / 2;
                    checked <=> root.exclusive;
                    enabled: !root.output-busy;
                    toggled => {
                        root.exclusive-toggled(self.checked);
                    }
                }
            }

            if root.asio-available: SettingRow {
                title: "独占模式";
                description: root.asio-fallback
                    ? "ASIO 独占已开启（Opus 音轨已自动回落到 WASAPI 独占）。"
                    : "选择独占输出模式：WASAPI 独占或 ASIO（原生采样率独占输出，播放中可热切换）。";
                ComboBox {
                    width: 170px;
                    y: (parent.height - self.height) / 2;
                    model: ["关闭", "WASAPI 独占", "ASIO"];
                    current-index <=> root.exclusive-mode;
                    enabled: !root.output-busy;
                    selected => {
                        root.exclusive-mode-selected(self.current-index);
                    }
                }
            }

            if root.asio-available: SettingRow {
                title: "ASIO 驱动";
                description: root.asio-status != ""
                    ? root.asio-status
                    : "从系统已安装的 ASIO 驱动中选择输出设备。";
                VerticalLayout {
                    y: (parent.height - self.height) / 2;
                    spacing: 8px;
                    ComboBox {
                        width: 240px;
                        model: root.asio-drivers;
                        current-index <=> root.asio-driver-index;
                        enabled: !root.output-busy;
                        selected => {
                            root.asio-driver-selected(self.current-index);
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        GhostButton {
                            text: "刷新";
                            enabled: !root.output-busy;
                            clicked => {
                                root.refresh-asio-driver();
                            }
                        }
                        GhostButton {
                            text: "控制面板";
                            enabled: !root.output-busy;
                            clicked => {
                                root.open-asio-control-panel();
                            }
                        }
                    }
                }
            }

            if root.asio-available && root.asio-channel-pairs.length > 0: SettingRow {
                title: "ASIO 输出端口";
                description: "选择该 ASIO 驱动使用的立体声输出通道对（按驱动分别记忆）。";
                ComboBox {
                    width: 280px;
                    y: (parent.height - self.height) / 2;
                    model: root.asio-channel-pairs;
                    current-index <=> root.asio-channel-pair-index;
                    enabled: !root.output-busy && root.asio-channel-pairs.length > 1;
                    selected => {
                        root.asio-channel-pair-selected(self.current-index);
                    }
                }
            }

            SettingRow {
                title: "播放 / 暂停淡入淡出";
                description: "播放和暂停时音量在 0.3 秒内渐变，不改变设定的音量。切歌不淡化。";
                Switch {
                    y: (parent.height - self.height) / 2;
                    checked <=> root.fade-on-pause;
                    toggled => {
                        root.fade-on-pause-toggled(self.checked);
                    }
                }
            }

            SettingRow {
                title: "队列播完自动续播";
                description: RadioState.supported
                    ? "播到队列末尾前自动补充 032 相似曲目继续播放（与队列顶栏 ∞ 双向同步；循环播放或睡眠定时生效时自动避让）。"
                    : "当前服务器未开启相似曲目功能。";
                Switch {
                    y: (parent.height - self.height) / 2;
                    enabled: RadioState.supported;
                    checked <=> RadioState.auto-play;
                    toggled => {
                        RadioState.toggle-auto-play(self.checked);
                    }
                }
            }

            if root.transcode-options.length > 1: SettingRow {
                title: "转码";
                description: "默认播放原始文件（无损、bit-perfect）。网络较慢时可改用服务端转码；MP3 / Opus 拖动进度时会重新请求。";
                ComboBox {
                    width: 320px;
                    y: (parent.height - self.height) / 2;
                    model: root.transcode-options;
                    current-index <=> root.transcode-index;
                    selected => {
                        root.transcode-selected(self.current-index);
                    }
                }
            }

            Text {
                text: "Sonos 投放";
                color: Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
            }

            SettingRow {
                title: "Hi-Res 音轨";
                description: "Sonos 最高播放 48 kHz。只处理采样率高于 48 kHz 的无损音轨，44.1 / 48 kHz 始终原样推送。";
                ComboBox {
                    width: 260px;
                    y: (parent.height - self.height) / 2;
                    model: ["转 MP3 320k（推荐）", "转 FLAC 48 kHz", "保持原样"];
                    current-index <=> CastState.hires;
                    selected => {
                        CastState.options-changed();
                    }
                }
            }

            SettingRow {
                title: "Opus 音轨";
                description: "Sonos 不能播放 Opus，由服务器转码。FLAC 首次播放要等服务器生成缓存，失败时改用 MP3。";
                ComboBox {
                    width: 260px;
                    y: (parent.height - self.height) / 2;
                    model: ["转 MP3 320k（推荐）", "转 FLAC"];
                    current-index <=> CastState.opus;
                    selected => {
                        CastState.options-changed();
                    }
                }
            }

            SettingRow {
                title: "音箱地址";
                description: "自动搜索找不到音箱时（防火墙、多网卡、VPN），填写任意一台音箱的 IP，多个用逗号分隔。";
                hosts-debounce := Timer {
                    interval: 400ms;
                    running: false;
                    triggered => {
                        self.running = false;
                        CastState.options-changed();
                    }
                }
                editor-scope := FocusScope {
                    width: 260px;
                    height: hosts-edit.preferred-height;
                    y: (parent.height - self.height) / 2;
                    key-pressed(e) => { return e.text == Key.Tab ? reject : accept; }
                    hosts-edit := LineEdit {
                        width: 100%;
                        height: 100%;
                        placeholder-text: "例如 192.168.1.30";
                        text <=> CastState.hosts;
                        changed has-focus => {
                            if !self.has-focus && hosts-debounce.running {
                                hosts-debounce.running = false;
                                CastState.options-changed();
                            }
                        }
                        edited => {
                            hosts-debounce.restart();
                        }
                        accepted => {
                            hosts-debounce.running = false;
                            CastState.options-changed();
                        }
                    }
                }
            }

            Text {
                text: "快捷键";
                color: Theme.text;
                font-size: 20px;
                font-weight: 700;
            }
            Text {
                text: "仅在应用窗口内生效，输入文字时不触发。点击按键录入新组合，Esc 取消；支持 Ctrl、Alt、Shift。";
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            for key[i] in root.shortcuts: SettingRow {
                title: key.title;
                GhostButton {
                    width: 180px;
                    text: root.recording == i ? "请按快捷键…" : key.binding == "" ? "未设置" : key.binding;
                    clicked => { root.record-shortcut(i); }
                }
                GhostButton {
                    text: "清除";
                    clicked => { root.clear-shortcut(i); }
                }
            }
            GhostButton {
                text: "恢复默认快捷键";
                clicked => { root.reset-shortcuts(); }
            }

            Text {
                text: "歌词";
                color: Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
            }

            SettingRow {
                title: "翻译目标语言";
                description: root.lyrics-translation ? "歌词翻译由 032 服务端完成（网易云自带翻译或 AI 翻译）。" : "服务端未开启歌词翻译。";
                ComboBox {
                    width: 200px;
                    y: (parent.height - self.height) / 2;
                    model: ["简体中文", "繁體中文", "English"];
                    current-index <=> root.lyrics-language;
                    selected => {
                        root.lyrics-changed();
                    }
                }
            }

            SettingRow {
                title: "译文显示方式";
                description: "只看译文时保留原歌词的时间轴。";
                ComboBox {
                    width: 200px;
                    y: (parent.height - self.height) / 2;
                    model: ["双语（原文下方显示译文）", "只看译文"];
                    current-index <=> root.lyrics-mode;
                    selected => {
                        root.lyrics-changed();
                    }
                }
            }

            SettingRow {
                title: "自动翻译";
                description: "歌词加载后自动请求翻译。";
                Switch {
                    y: (parent.height - self.height) / 2;
                    checked <=> root.lyrics-auto;
                    toggled => {
                        root.lyrics-changed();
                    }
                }
            }

            if root.tray-available: Text {
                text: "窗口";
                color: Theme.text-dim;
                font-size: 13px;
                font-weight: 600;
            }

            if root.tray-available: SettingRow {
                title: "关闭时最小化到托盘";
                description: "关闭窗口后继续播放，从托盘图标重新打开或退出。";
                Switch {
                    y: (parent.height - self.height) / 2;
                    checked <=> root.close-to-tray;
                    toggled => {
                        root.close-to-tray-toggled(self.checked);
                    }
                }
            }
        }
    }
}
