import { Fonts, Theme, Shell } from "theme.slint";
import { Palette } from "std-widgets.slint";
import {
    TieupWork, AlbumCard, AlbumRow, TrackRow, CreditPart, LyricLine, QueueRow, PlaylistChoice,
    LoginView, CardGrid, TrackList, TrackRowView, LyricsPanel, LyricsTools, QueuePanel, PlayerBar,
} from "views.slint";
import {
    ListQuery, DetailInfo, ListToolbar, PageHeader, CardRows, DetailHeader, PromptDialog,
    ConfirmDialog, ReleaseGroupRow, AlbumWorkRow, WorkUseRow, PersonRow, FactRow, AlbumInspector,
    InfoDialog,
} from "library.slint";
import { SettingsView, ShortcutRow } from "settings.slint";
import { FullScreenPlayer } from "fullscreen.slint";
import { NowPlayingPanel } from "nowplaying.slint";
export { ShortcutRow } from "settings.slint";
import { Playback, GhostButton, Icon, IconButton, IconKind, PrimaryButton, SearchField, Tab } from "controls.slint";
import {
    Home, Lib032, LyricsSearch, HomeRow, AlbumPane, SeriesPane, NamedItem, YearBar, HomeStats,
    WorkInfo, SeriesInfo, MixTag, MixInfo, LyricsResult, HomePage, WorksPage, SeriesPage,
    HistoryPage, WorkPage, SeriesDetailPage, MixPage, LyricsSearchDialog, LinkText,
} from "m032.slint";

export { Fonts, Playback }
export { TieupWork, AlbumCard, AlbumRow, TrackRow, CreditPart, LyricLine, QueueRow, PlaylistChoice, ListQuery, DetailInfo, ReleaseGroupRow, AlbumWorkRow, WorkUseRow, PersonRow, FactRow }
export {
    Home, Lib032, LyricsSearch, HomeRow, AlbumPane, SeriesPane, NamedItem, YearBar, HomeStats,
    WorkInfo, SeriesInfo, MixTag, MixInfo, LyricsResult,
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <IconKind> icon;
    in property <bool> selected;
    // Icon rail (narrow windows): the icon only, centered.
    in property <bool> rail;
    callback clicked();
    height: 42px;
    border-radius: 10px;
    background: root.selected ? Theme.raised : area.has-hover ? Theme.surface-hover : transparent;

    HorizontalLayout {
        padding-left: root.rail ? 0px : 12px;
        padding-right: root.rail ? 0px : 8px;
        spacing: 14px;
        alignment: root.rail ? LayoutAlignment.center : LayoutAlignment.stretch;
        Icon {
            kind: root.icon;
            width: 20px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            color: root.selected ? Theme.accent-text : Theme.text-dim;
        }
        if !root.rail: Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.selected ? Theme.text : Theme.text-dim;
            font-size: 15px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Sidebar section title ("我的媒体库", "播放列表").
component SideHeader inherits HorizontalLayout {
    in property <string> text;
    callback clicked();
    height: 48px;
    padding-left: 12px;
    padding-top: 14px;
    padding-bottom: 4px;
    spacing: 2px;
    Text {
        text: root.text;
        font-family: Fonts.family(self.text);
        color: head-area.has-hover ? Theme.text : Theme.text-faint;
        font-size: 12.5px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
        head-area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.clicked();
            }
        }
    }
    @children
}

export component AppWindow inherits Window {
    title: "032player";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    background: Theme.bg;
    // Electron body text (Mantine `md`); fonts: `src/fonts.rs`.
    default-font-size: 14px;
    default-font-family: "Noto Sans SC";

    in-out property <bool> logged-in: false;

    // Login.
    in-out property <string> login-server;
    in-out property <string> login-api-token;
    in-out property <string> login-media-token;
    in property <bool> login-api-token-saved;
    in property <bool> login-media-token-saved;
    in-out property <string> login-error;
    in-out property <bool> login-busy;
    callback login(string, string, string);
    callback logout();

    // Navigation. Pages: 0 albums, 1 tracks, 2 settings, 3 artists,
    // 4 playlists, 5 favorites, 6 search, 10 detail (see `detail.kind`),
    // 20 home, 21 works, 22 series, 23 playback history.
    // Rust keeps the history; `navigate(page, id)` opens details by id:
    // 10 album, 11 artist, 12 playlist, 13 work, 14 series, 15 daily mix.
    in property <int> page: 0;
    // The server has the 032 home / series endpoints.
    in property <bool> has-home;
    in property <bool> can-go-back;
    callback navigate(int, int);
    callback go-back();
    in property <string> server-label;
    // Sidebar footer: "host · 18,930 首".
    in property <string> server-status;
    // Binding of the 搜索曲库 shortcut ("Ctrl+K"), shown in the sidebar.
    in property <string> search-shortcut;
    // The server has /browse (sort direction, random, album year ranges).
    in property <bool> browse;

    // Card grids (`grid` ids): 0 albums, 1 artists, 2 favorite albums,
    // 3 favorite artists, 4 search artists, 5 search albums, 6 artist
    // releases, 7 playlists, 8 works, 9 series, 10 home works, 11 home
    // recent albums, 12 chronicle, 13 home playlists, 14 work albums,
    // 15 series members, 16 series albums.
    callback card-layout-changed(int, int, length);
    // (grid, most cards shown; 0: all)
    callback card-limit-changed(int, int);
    // (grid, row): a row of a lazy grid scrolled into view.
    callback card-row-shown(int, int);
    // (grid, action, id, argument)
    callback card-action(int, string, int, int);
    // Track lists (`list` ids): 0 tracks page, 1 favorites, 2 detail,
    // 3 search, 4-6 spotlight tabs (recent, listening, random), 7 接着听,
    // 8 最近播放, 9 主题曲, 10 history. (list, action, row index, argument)
    callback track-action(int, string, int, int);
    in property <[PlaylistChoice]> playlist-choices;

    // List queries (`target`): 0 albums, 1 tracks, 2 artists, 3 playlists,
    // 4 favorite albums, 5 favorite tracks, 6 favorite artists.
    callback query-changed(int, ListQuery);
    callback clear-filter(int);
    in-out property <ListQuery> q-albums;
    in-out property <ListQuery> q-tracks;
    in-out property <ListQuery> q-artists;
    in-out property <ListQuery> q-all-artists;
    in-out property <ListQuery> q-playlists;
    in-out property <ListQuery> q-fav-albums;
    in-out property <ListQuery> q-fav-tracks;
    in-out property <ListQuery> q-fav-artists;
    in property <[string]> album-sorts;
    in property <[bool]> album-sort-desc;
    in property <[string]> track-sorts;
    in property <[bool]> track-sort-desc;
    in property <[string]> artist-sorts;
    in property <[bool]> artist-sort-desc;
    in property <[string]> playlist-sorts;
    in property <[bool]> playlist-sort-desc;
    // Artist filter chips ("艺人：X").
    in property <string> album-filter;
    in property <string> track-filter;

    // Albums.
    in property <[AlbumRow]> album-rows;
    in property <int> album-loaded;
    in property <int> album-total;
    in property <bool> albums-loading;

    // Tracks.
    in property <[TrackRow]> tracks;
    in property <int> track-total;
    in property <bool> tracks-loading;
    callback shuffle-all();
    // Play a whole track list (`list` ids) in order, or shuffled.
    callback play-list(int, bool);

    // Artists.
    in property <[AlbumRow]> artist-rows;
    in property <int> artist-total;
    in property <bool> artists-loading;

    // Playlists.
    in property <[AlbumRow]> playlist-rows;
    in property <int> playlist-count;
    callback new-playlist();
    // Left sidebar width (dragged by its right edge, saved on release).
    in-out property <length> sidebar-width: 248px;
    callback sidebar-resized();
    in property <string> app-version;
    in property <string> update-version;
    callback open-update();
    callback open-logs();
    // Sidebar playlists: name, "20 首 · 1 小时 14 分", cover.
    in property <[NamedItem]> side-playlists;

    // Favorites: tab 0 tracks, 1 albums, 2 artists.
    in-out property <int> fav-tab: 0;
    in property <[TrackRow]> fav-tracks;
    in property <[AlbumRow]> fav-album-rows;
    in property <[AlbumRow]> fav-artist-rows;
    in property <int> fav-album-count;
    in property <int> fav-artist-count;
    in property <bool> fav-loading;

    // Search: tab 0 tracks, 1 albums, 2 artists.
    in-out property <string> search-text;
    in-out property <int> search-tab: 0;
    in property <[TrackRow]> search-tracks;
    in property <[AlbumRow]> search-album-rows;
    in property <[AlbumRow]> search-artist-rows;
    in property <int> search-album-count;
    in property <int> search-artist-count;
    in property <bool> search-loading;
    callback search(string);

    // Detail page.
    in property <DetailInfo> detail;
    in property <image> detail-cover;
    in property <bool> detail-loading;
    in property <[TrackRow]> detail-tracks;
    // Album page: linked works, release / media facts, people, review.
    in property <[AlbumWorkRow]> album-works;
    in property <[FactRow]> album-release;
    in property <[PersonRow]> album-people;
    in property <[FactRow]> album-media;
    in property <string> album-review;
    // Artist page: releases grouped like the 032 server, the biography.
    in property <[ReleaseGroupRow]> artist-groups;
    // "收藏的歌曲" of the artist (track list 12).
    in property <[TrackRow]> artist-favs;
    in property <string> artist-about;
    in property <bool> playlist-artwork;
    callback detail-action(string, int);

    // Dialogs: 0 none, 1 new playlist, 2 edit playlist, 3 delete playlist,
    // 4 clear playback history, 5 lyrics search, 6 track info.
    in property <[FactRow]> info-rows;
    in-out property <int> dialog: 0;
    in-out property <string> dialog-name;
    in-out property <string> dialog-description;
    in-out property <string> dialog-message;
    callback dialog-confirm(string, string);

    // Queue (play order).
    in property <[QueueRow]> queue;
    in property <int> queue-current: -1;
    // Entries in the whole queue (`queue` holds the search matches).
    in property <int> queue-total;
    in-out property <string> queue-search;
    callback queue-search-changed(string);
    callback save-queue();
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    callback play-queue-item(int);
    callback remove-queue-item(int);
    callback move-queue-item(int, int);
    callback clear-queue();
    callback toggle-shuffle();
    callback cycle-repeat();
    in property <bool> sleep-active;
    in property <string> sleep-label;
    callback set-sleep(int, int);

    // Now playing.
    in property <bool> has-track;
    in property <int> playing-id: -1;
    in property <string> np-title;
    in property <string> np-artist;
    in property <string> np-album;
    in property <string> np-quality;
    in property <image> np-cover;
    // The current cover at `np-art-side` (right panel).
    in property <image> np-cover-large;
    in property <bool> np-favorite;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <string> position-text: "0:00";
    in property <string> duration-text: "0:00";
    in property <bool> paused: true;
    in property <bool> buffering;
    in-out property <float> volume: 100;
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(int);
    callback volume-changed(float);
    callback toggle-now-favorite();
    callback open-now-album();
    callback open-now-artist();

    // Full-screen player: tab 0 up next, 1 related, 2 lyrics. Rust loads
    // the original cover (at `full-cover-side`) and the related songs
    // (track list 11) on `full-changed`.
    in-out property <bool> full-open;
    in-out property <int> full-tab;
    in property <image> full-cover;
    in property <[TrackRow]> full-related;
    in property <bool> full-related-loading;
    in-out property <length> full-cover-side;
    callback full-changed();
    callback now-info();
    function open-full(tab: int) {
        root.full-open = true;
        root.full-tab = tab;
        root.full-changed();
    }
    function close-full() {
        root.full-open = false;
        root.full-changed();
    }

    // Lyrics.
    in property <[LyricLine]> lyrics;
    in property <int> lyrics-active: -1;
    in property <bool> lyrics-synced;
    in property <string> lyrics-source;
    in property <bool> lyrics-translated-lines;
    in property <bool> lyrics-can-search;
    in property <bool> lyrics-can-translate;
    in property <bool> lyrics-translation-shown;
    in property <bool> lyrics-translating;
    in property <int> lyrics-offset;
    // Right panel (settings `rightPanel`): 歌词 | 队列 tabs under the
    // current track (D2). `panel-queue`, `panel-lyrics`,
    // `panel-lyrics-first` and `panel-split` belong to the old stacked
    // layout; they are kept only to be saved back unchanged.
    in-out property <bool> panel-open: true;
    in-out property <bool> panel-queue-tab: false;
    in-out property <bool> panel-queue: true;
    in-out property <bool> panel-lyrics: true;
    in-out property <bool> panel-lyrics-first: false;
    in-out property <float> panel-split: 0.5;
    in-out property <length> panel-width: 420px;
    // Narrow windows (< 1280): the panel is an overlay, closed by default.
    in-out property <bool> overlay-open: false;

    // Breakpoints by window width (docs/UI-REDESIGN.md 外壳尺寸与断点).
    property <bool> wide: root.width >= 1700px;
    // 1280 itself is narrow, as in the final 1280x800 mockup.
    property <bool> small: root.width <= 1280px;
    property <int> tier: root.wide ? 2 : root.small ? 0 : 1;
    out property <length> bar-h: root.tier == 2 ? 92px : root.tier == 1 ? 84px : 80px;
    // The sidebar keeps its dragged width for wide windows (D6).
    property <length> nav-w: root.wide ? clamp(root.sidebar-width, 180px, 400px) : root.small ? 64px : 72px;
    property <bool> panel-docked: !root.small && root.panel-open;
    property <bool> panel-shown: root.small ? root.overlay-open : root.panel-open;
    property <length> panel-max: max(300px, min(720px, root.width * 0.4));
    property <length> panel-w: root.wide ? clamp(root.panel-width, 300px, root.panel-max) : min(372px, root.width - 80px);
    // The current cover in the panel; Rust decodes `np-cover-large` at
    // this size (`np-art-changed`, after resizing settles).
    out property <length> np-art-side: round(max(120px, min(root.wide ? root.panel-w - 48px : 248px, root.height - root.bar-h - 470px)) / 1phx) * 1phx;
    // The detail header cover; Rust reloads it at this size.
    out property <length> detail-art-side: round(Shell.detail-art / 1phx) * 1phx;
    callback detail-art-changed();
    changed detail-art-side => {
        root.detail-art-changed();
    }
    callback np-art-changed();
    changed np-art-side => {
        art-timer.restart();
    }
    art-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            root.np-art-changed();
        }
    }
    // The player bar's lyrics / queue buttons and the queue shortcut: open
    // the panel on that tab, or close it when it already shows it.
    public function toggle-panel(queue: bool) {
        if root.panel-shown && root.panel-queue-tab == queue {
            if root.small {
                root.overlay-open = false;
            } else {
                root.panel-open = false;
            }
        } else {
            root.panel-queue-tab = queue;
            if root.small {
                root.overlay-open = true;
            } else {
                root.panel-open = true;
            }
        }
        root.panel-changed();
    }
    // Any of the panel-* properties changed (saved by Rust).
    callback panel-changed();
    // search, clear, translate
    callback lyrics-tool(string);
    callback lyrics-offset-changed(int);
    callback lyrics-seek(int);
    // The daily mix the current track was queued from (-1: none).
    in property <int> playing-mix: -1;
    // Lyrics settings: translation language (0 zh-Hans, 1 zh-Hant, 2 en),
    // mode (0 bilingual, 1 translated only), auto translate.
    in-out property <int> lyrics-language;
    in-out property <int> lyrics-mode;
    in-out property <bool> lyrics-auto;
    in property <bool> lyrics-translation-available;
    callback lyrics-settings-changed();

    in property <[ShortcutRow]> shortcuts;
    in-out property <int> recording-shortcut: -1;
    changed page => { root.recording-shortcut = -1; }
    callback shortcut-key(KeyEvent) -> bool;
    callback capture-shortcut(KeyEvent) -> bool;
    callback clear-shortcut(int);
    callback reset-shortcuts();
    forward-focus: shortcut-scope;
    // Settings.
    in property <[string]> audio-devices: ["系统默认"];
    in-out property <int> audio-device-index;
    in-out property <bool> exclusive;
    in-out property <bool> output-busy;
    callback settings-opened();
    callback audio-device-selected(int);
    callback exclusive-toggled(bool);
    // Windows tray exists: closing can hide to it.
    in property <bool> tray-available;
    in-out property <bool> close-to-tray;
    callback close-to-tray-toggled(bool);
    in-out property <bool> fade-on-pause;
    callback fade-on-pause-toggled(bool);
    // 0 follow the system, 1 032 Dark, 2 032 Light (settings `theme`).
    in-out property <int> theme-mode: 1;
    callback theme-selected(int);
    function apply-theme() {
        Palette.color-scheme = root.theme-mode == 1 ? ColorScheme.dark
            : root.theme-mode == 2 ? ColorScheme.light : ColorScheme.unknown;
    }
    init => {
        root.apply-theme();
        Shell.window-width = root.width;
    }
    changed width => {
        Shell.window-width = root.width;
    }
    changed theme-mode => {
        root.apply-theme();
    }
    in property <[string]> transcode-options: ["原始文件"];
    in-out property <int> transcode-index;
    callback transcode-selected(int);

    in property <string> notice;

    search-debounce := Timer {
        interval: 400ms;
        running: false;
        triggered => {
            self.running = false;
            root.search(root.search-text);
        }
    }

    function count(n: int, unit: string) -> string {
        return n == 0 ? "" : n + " " + unit;
    }

    shortcut-scope := FocusScope {
        width: root.width;
        height: root.height;
        capture-key-pressed(e) => {
            if root.recording-shortcut >= 0 { return root.capture-shortcut(e) ? accept : reject; }
            return reject;
        }
        key-pressed(e) => {
            if root.dialog == 6 && e.text == Key.Escape {
                root.dialog = 0;
                return accept;
            }
            if root.logged-in && root.dialog == 0 && root.full-open && e.text == Key.Escape {
                root.close-full();
                return accept;
            }
            if root.logged-in && root.dialog == 0 { return root.shortcut-key(e) ? accept : reject; }
            return reject;
        }

    if !root.logged-in: LoginView {
        server <=> root.login-server;
        api-token <=> root.login-api-token;
        media-token <=> root.login-media-token;
        api-token-saved: root.login-api-token-saved;
        media-token-saved: root.login-media-token-saved;
        error: root.login-error;
        busy: root.login-busy;
        login(s, a, m) => {
            root.login(s, a, m);
        }
    }

    if root.logged-in: VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;

            // Left navigation: search, library, playlists, and the server
            // status with the settings entry at the bottom (D1). Narrower
            // than 1700px it is an icon rail (D6).
            sidebar := Rectangle {
                width: root.nav-w;
                background: Theme.chrome;
                property <bool> rail: !root.wide;
                property <length> item-w: root.small ? 44px : 48px;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border;
                }
                VerticalLayout {
                    padding-top: sidebar.rail ? 16px : 18px;
                    padding-bottom: sidebar.rail ? 12px : 14px;
                    padding-left: sidebar.rail ? 0px : 14px;
                    padding-right: sidebar.rail ? 1px : 15px;
                    spacing: 0px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: sidebar.rail ? sidebar.item-w : sidebar.width - 29px;
                            height: 40px;
                            border-radius: 10px;
                            background: root.page == 6 ? Theme.surface-hover : search-area.has-hover ? Theme.surface-hover : Theme.raised;
                            HorizontalLayout {
                                padding-left: sidebar.rail ? 0px : 12px;
                                padding-right: sidebar.rail ? 0px : 10px;
                                spacing: 10px;
                                alignment: sidebar.rail ? LayoutAlignment.center : LayoutAlignment.stretch;
                                Icon {
                                    kind: IconKind.search;
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    color: root.page == 6 ? Theme.accent-text : Theme.text-faint;
                                }
                                if !sidebar.rail: Text {
                                    text: "搜索曲库";
                                    color: Theme.text-faint;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                if !sidebar.rail && root.search-shortcut != "": Rectangle {
                                    y: (parent.height - self.height) / 2;
                                    height: 18px;
                                    width: kbd.preferred-width + 12px;
                                    border-radius: 5px;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    kbd := Text {
                                        text: root.search-shortcut;
                                        color: Theme.text-faint;
                                        font-size: 11px;
                                        font-weight: 500;
                                    }
                                }
                            }
                            search-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.navigate(6, 0);
                                }
                            }
                        }
                    }
                    if !sidebar.rail: SideHeader {
                        text: "我的媒体库";
                    }
                    if sidebar.rail: Rectangle {
                        height: 14px;
                    }
                    for item in [
                        { text: "主页", page: 20, icon: IconKind.home },
                        { text: "收藏", page: 5, icon: IconKind.heart-outline },
                        { text: "专辑", page: 0, icon: IconKind.disc },
                        { text: "曲目", page: 1, icon: IconKind.note },
                        { text: "专辑艺术家", page: 3, icon: IconKind.person },
                        { text: "艺术家", page: 24, icon: IconKind.people },
                        { text: "作品", page: 21, icon: IconKind.work },
                        { text: "系列", page: 22, icon: IconKind.layers },
                        { text: "播放记录", page: 23, icon: IconKind.history },
                    ]: HorizontalLayout {
                        alignment: center;
                        visible: item.page != 20 || root.has-home;
                        height: item.page != 20 || root.has-home ? 42px : 0px;
                        NavItem {
                            width: sidebar.rail ? sidebar.item-w : sidebar.width - 29px;
                            rail: sidebar.rail;
                            text: item.text;
                            icon: item.icon;
                            selected: root.page == item.page;
                            clicked => {
                                root.navigate(item.page, 0);
                            }
                        }
                    }
                    if !sidebar.rail: SideHeader {
                        text: "播放列表";
                        clicked => {
                            root.navigate(4, 0);
                        }
                        IconButton {
                            kind: IconKind.plus;
                            size: 26px;
                            icon-size: 16px;
                            y: (parent.height - self.height) / 2;
                            clicked => {
                                root.new-playlist();
                            }
                        }
                        IconButton {
                            kind: IconKind.sliders;
                            size: 26px;
                            icon-size: 16px;
                            y: (parent.height - self.height) / 2;
                            active: root.page == 4;
                            clicked => {
                                root.navigate(4, 0);
                            }
                        }
                    }
                    if sidebar.rail: Rectangle {
                        height: 18px;
                    }
                    side-list := Flickable {
                        vertical-stretch: 1;
                        content-height: side-col.preferred-height;
                        side-col := VerticalLayout {
                            width: side-list.width;
                            alignment: start;
                            for p in root.side-playlists: HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: sidebar.rail ? 50px : sidebar.width - 29px;
                                    height: sidebar.rail ? 50px : 54px;
                                    border-radius: 10px;
                                    background: root.page == 10 && root.detail.kind == 2 && root.detail.id == p.id ? Theme.raised : p-area.has-hover ? Theme.surface-hover : transparent;
                                    HorizontalLayout {
                                        padding-left: sidebar.rail ? 4px : 12px;
                                        padding-right: sidebar.rail ? 4px : 12px;
                                        spacing: 12px;
                                        Rectangle {
                                            width: 42px;
                                            height: 42px;
                                            y: (parent.height - self.height) / 2;
                                            border-radius: 6px;
                                            background: Theme.raised;
                                            clip: true;
                                            if p.cover.width == 0: Icon {
                                                kind: IconKind.list;
                                                width: 18px;
                                                height: 18px;
                                                color: Theme.text-faint;
                                            }
                                            Image {
                                                source: p.cover;
                                                width: 100%;
                                                height: 100%;
                                                image-fit: ImageFit.cover;
                                            }
                                        }
                                        if !sidebar.rail: VerticalLayout {
                                            alignment: center;
                                            horizontal-stretch: 1;
                                            spacing: 2px;
                                            Text {
                                                text: p.title;
                                                font-family: Fonts.family(self.text);
                                                color: Theme.text;
                                                font-size: 14px;
                                                font-weight: 600;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: p.meta;
                                                font-family: Fonts.family(self.text);
                                                color: Theme.text-faint;
                                                font-size: 12.5px;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                    p-area := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.navigate(12, p.id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Server status and the settings entry.
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: sidebar.rail ? sidebar.item-w : sidebar.width - 29px;
                            height: 42px;
                            border-radius: 10px;
                            background: foot-area.has-hover || root.page == 2 ? Theme.surface-hover : transparent;
                            foot-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.navigate(2, 0);
                                }
                            }
                            HorizontalLayout {
                                padding-left: sidebar.rail ? 0px : 12px;
                                padding-right: sidebar.rail ? 0px : 12px;
                                spacing: 10px;
                                alignment: sidebar.rail ? LayoutAlignment.center : LayoutAlignment.stretch;
                                if !sidebar.rail: Rectangle {
                                    width: 14px;
                                    Rectangle {
                                        width: 14px;
                                        height: 14px;
                                        border-radius: 7px;
                                        background: Theme.ok.with-alpha(0.15);
                                    }
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Theme.ok;
                                    }
                                }
                                if !sidebar.rail: Text {
                                    text: root.server-status;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                                Icon {
                                    kind: IconKind.gear;
                                    width: 18px;
                                    height: 18px;
                                    y: (parent.height - self.height) / 2;
                                    color: root.page == 2 ? Theme.accent-text : foot-area.has-hover ? Theme.text : Theme.text-dim;
                                }
                            }
                        }
                    }
                }
                // Resize from the right edge (180-400px; wide windows only).
                if root.wide: Rectangle {
                    x: parent.width - 5px;
                    width: 5px;
                    property <length> press-x;
                    background: side-edge.has-hover || side-edge.pressed ? Theme.accent-dim : transparent;
                    side-edge := TouchArea {
                        mouse-cursor: col-resize;
                        pointer-event(e) => {
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                                parent.press-x = self.mouse-x;
                            }
                            if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                                root.sidebar-width = sidebar.width;
                                root.sidebar-resized();
                            }
                        }
                        moved => {
                            if self.pressed {
                                root.sidebar-width = clamp(sidebar.width + (self.mouse-x - parent.press-x), 180px, 400px);
                            }
                        }
                    }
                }
            }

            pages := Rectangle {
                horizontal-stretch: 1;

                if root.page == 0: VerticalLayout {
                    PageHeader {
                        title: "专辑";
                        count: root.album-total == 0 ? "" : root.album-loaded < root.album-total ? root.album-loaded + " / " + root.album-total : root.album-total + " 张";
                        ListToolbar {
                            sort-labels: root.album-sorts;
                            sort-desc: root.album-sort-desc;
                            query: root.q-albums;
                            show-order: root.browse;
                            show-years: true;
                            filter-label: root.album-filter;
                            changed(q) => {
                                root.q-albums = q;
                                root.query-changed(0, q);
                            }
                            clear-filter => {
                                root.clear-filter(0);
                            }
                        }
                    }
                    CardGrid {
                        vertical-stretch: 1;
                        rows: root.album-rows;
                        kind: 0;
                        loading: root.albums-loading;
                        empty-text: "没有专辑";
                        playlists: root.playlist-choices;
                        layout-changed(n, size) => {
                            root.card-layout-changed(0, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(0, what, id, arg);
                        }
                    }
                }

                if root.page == 1: VerticalLayout {
                    PageHeader {
                        title: "曲目";
                        count: root.track-total == 0 ? "" : root.tracks.length < root.track-total ? root.tracks.length + " / " + root.track-total : root.track-total + " 首";
                        ListToolbar {
                            sort-labels: root.track-sorts;
                            sort-desc: root.track-sort-desc;
                            query: root.q-tracks;
                            show-order: root.browse;
                            show-years: true;
                            filter-label: root.track-filter;
                            changed(q) => {
                                root.q-tracks = q;
                                root.query-changed(1, q);
                            }
                            clear-filter => {
                                root.clear-filter(1);
                            }
                            GhostButton {
                                text: "随机播放全部";
                                has-icon: true;
                                icon: IconKind.shuffle;
                                clicked => {
                                    root.shuffle-all();
                                }
                            }
                        }
                    }
                    TrackList {
                        vertical-stretch: 1;
                        rows: root.tracks;
                        mode: 0;
                        loading: root.tracks-loading;
                        playing-id: root.playing-id;
                        playlists: root.playlist-choices;
                        action(what, i, arg) => {
                            root.track-action(0, what, i, arg);
                        }
                    }
                }

                // 3: album artists, 24: everyone credited (role=all).
                if root.page == 3 || root.page == 24: artists-page := VerticalLayout {
                    property <int> target: root.page == 24 ? 7 : 2;
                    changed target => {
                        root.query-changed(self.target, root.page == 24 ? root.q-all-artists : root.q-artists);
                    }
                    PageHeader {
                        title: root.page == 24 ? "艺术家" : "专辑艺术家";
                        count: root.count(root.artist-total, "位");
                        ListToolbar {
                            sort-labels: root.artist-sorts;
                            sort-desc: root.artist-sort-desc;
                            query: root.page == 24 ? root.q-all-artists : root.q-artists;
                            show-order: root.browse;
                            changed(q) => {
                                if root.page == 24 {
                                    root.q-all-artists = q;
                                } else {
                                    root.q-artists = q;
                                }
                                root.query-changed(artists-page.target, q);
                            }
                        }
                    }
                    CardGrid {
                        vertical-stretch: 1;
                        rows: root.artist-rows;
                        kind: 1;
                        loading: root.artists-loading;
                        empty-text: "没有艺人";
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(artists-page.target, root.page == 24 ? root.q-all-artists : root.q-artists);
                        }
                        layout-changed(n, size) => {
                            root.card-layout-changed(1, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(1, what, id, arg);
                        }
                    }
                }

                if root.page == 4: VerticalLayout {
                    PageHeader {
                        title: "歌单";
                        count: root.count(root.playlist-count, "个");
                        ListToolbar {
                            sort-labels: root.playlist-sorts;
                            sort-desc: root.playlist-sort-desc;
                            query: root.q-playlists;
                            changed(q) => {
                                root.q-playlists = q;
                                root.query-changed(3, q);
                            }
                            GhostButton {
                                text: "新建歌单";
                                has-icon: true;
                                icon: IconKind.plus;
                                clicked => {
                                    root.new-playlist();
                                }
                            }
                        }
                    }
                    CardGrid {
                        vertical-stretch: 1;
                        rows: root.playlist-rows;
                        kind: 2;
                        empty-text: "还没有歌单";
                        layout-changed(n, size) => {
                            root.card-layout-changed(7, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(7, what, id, arg);
                        }
                    }
                }

                if root.page == 5: VerticalLayout {
                    PageHeader {
                        title: "收藏";
                        count: root.fav-tab == 0 ? root.count(root.fav-tracks.length, "首") : root.fav-tab == 1 ? root.count(root.fav-album-count, "张") : root.count(root.fav-artist-count, "位");
                        HorizontalLayout {
                            spacing: 8px;
                            Tab {
                                text: "曲目";
                                selected: root.fav-tab == 0;
                                clicked => {
                                    root.fav-tab = 0;
                                }
                            }
                            Tab {
                                text: "专辑";
                                selected: root.fav-tab == 1;
                                clicked => {
                                    root.fav-tab = 1;
                                }
                            }
                            Tab {
                                text: "艺人";
                                selected: root.fav-tab == 2;
                                clicked => {
                                    root.fav-tab = 2;
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                            // The filtered, sorted favorite tracks (list 1).
                            if root.fav-tab == 0: HorizontalLayout {
                                horizontal-stretch: 0;
                                spacing: 10px;
                                PrimaryButton {
                                    horizontal-stretch: 0;
                                    text: "播放";
                                    has-icon: true;
                                    enabled: root.fav-tracks.length > 0;
                                    clicked => {
                                        root.play-list(1, false);
                                    }
                                }
                                GhostButton {
                                    height: 40px;
                                    text: "随机播放";
                                    has-icon: true;
                                    icon: IconKind.shuffle;
                                    enabled: root.fav-tracks.length > 0;
                                    clicked => {
                                        root.play-list(1, true);
                                    }
                                }
                            }
                        }
                        if root.fav-tab == 0: ListToolbar {
                            sort-labels: root.track-sorts;
                            sort-desc: root.track-sort-desc;
                            query: root.q-fav-tracks;
                            show-years: true;
                            changed(q) => {
                                root.q-fav-tracks = q;
                                root.query-changed(5, q);
                            }
                        }
                        if root.fav-tab == 1: ListToolbar {
                            sort-labels: root.album-sorts;
                            sort-desc: root.album-sort-desc;
                            query: root.q-fav-albums;
                            show-years: true;
                            changed(q) => {
                                root.q-fav-albums = q;
                                root.query-changed(4, q);
                            }
                        }
                        if root.fav-tab == 2: ListToolbar {
                            sort-labels: root.artist-sorts;
                            sort-desc: root.artist-sort-desc;
                            query: root.q-fav-artists;
                            show-order: root.browse;
                            changed(q) => {
                                root.q-fav-artists = q;
                                root.query-changed(6, q);
                            }
                        }
                    }
                    if root.fav-tab == 0: TrackList {
                        vertical-stretch: 1;
                        rows: root.fav-tracks;
                        mode: 0;
                        loading: root.fav-loading;
                        empty-text: "还没有收藏的曲目";
                        playing-id: root.playing-id;
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(5, root.q-fav-tracks);
                        }
                        action(what, i, arg) => {
                            root.track-action(1, what, i, arg);
                        }
                    }
                    if root.fav-tab == 1: CardGrid {
                        vertical-stretch: 1;
                        rows: root.fav-album-rows;
                        kind: 0;
                        loading: root.fav-loading;
                        empty-text: "还没有收藏的专辑";
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(4, root.q-fav-albums);
                        }
                        layout-changed(n, size) => {
                            root.card-layout-changed(2, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(2, what, id, arg);
                        }
                    }
                    if root.fav-tab == 2: CardGrid {
                        vertical-stretch: 1;
                        rows: root.fav-artist-rows;
                        kind: 1;
                        loading: root.fav-loading;
                        empty-text: "还没有收藏的艺人";
                        playlists: root.playlist-choices;
                        init => {
                            root.query-changed(6, root.q-fav-artists);
                        }
                        layout-changed(n, size) => {
                            root.card-layout-changed(3, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(3, what, id, arg);
                        }
                    }
                }

                if root.page == 6: VerticalLayout {
                    PageHeader {
                        title: "搜索";
                        search-field := SearchField {
                            vertical-stretch: 0;
                            height: 38px;
                            placeholder: "搜索曲目、专辑、艺人";
                            text <=> root.search-text;
                            init => {
                                self.focus();
                            }
                            edited => {
                                search-debounce.restart();
                            }
                            accepted => {
                                search-debounce.running = false;
                                root.search(root.search-text);
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Tab {
                                text: "曲目" + (root.search-tracks.length > 0 ? " " + root.search-tracks.length : "");
                                selected: root.search-tab == 0;
                                clicked => {
                                    root.search-tab = 0;
                                }
                            }
                            Tab {
                                text: "专辑" + (root.search-album-count > 0 ? " " + root.search-album-count : "");
                                selected: root.search-tab == 1;
                                clicked => {
                                    root.search-tab = 1;
                                }
                            }
                            Tab {
                                text: "艺人" + (root.search-artist-count > 0 ? " " + root.search-artist-count : "");
                                selected: root.search-tab == 2;
                                clicked => {
                                    root.search-tab = 2;
                                }
                            }
                        }
                    }
                    if root.search-tab == 0: TrackList {
                        vertical-stretch: 1;
                        rows: root.search-tracks;
                        mode: 0;
                        loading: root.search-loading;
                        empty-text: root.search-text == "" ? "输入关键词搜索" : "没有找到曲目";
                        playing-id: root.playing-id;
                        playlists: root.playlist-choices;
                        action(what, i, arg) => {
                            root.track-action(3, what, i, arg);
                        }
                    }
                    if root.search-tab == 1: CardGrid {
                        vertical-stretch: 1;
                        rows: root.search-album-rows;
                        kind: 0;
                        loading: root.search-loading;
                        empty-text: root.search-text == "" ? "输入关键词搜索" : "没有找到专辑";
                        playlists: root.playlist-choices;
                        layout-changed(n, size) => {
                            root.card-layout-changed(5, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(5, what, id, arg);
                        }
                    }
                    if root.search-tab == 2: CardGrid {
                        vertical-stretch: 1;
                        rows: root.search-artist-rows;
                        kind: 1;
                        loading: root.search-loading;
                        empty-text: root.search-text == "" ? "输入关键词搜索" : "没有找到艺人";
                        playlists: root.playlist-choices;
                        layout-changed(n, size) => {
                            root.card-layout-changed(4, n, size);
                        }
                        action(what, id, arg) => {
                            root.card-action(4, what, id, arg);
                        }
                    }
                }

                // Album, playlist, similar: header and a virtualized list.
                if root.page == 10 && root.detail.kind != 1 && root.detail.kind < 4: detail-page := VerticalLayout {
                    // Album info column (Electron: beside the tracks from
                    // the lg breakpoint); narrower pages switch with tabs.
                    property <bool> album: root.detail.kind == 0;
                    property <bool> has-info: self.album && (root.album-works.length > 0 || root.album-release.length > 0 || root.album-people.length > 0);
                    property <bool> side: pages.width >= 1100px;
                    property <bool> info-tab;
                    detail-head := DetailHeader {
                        info: root.detail;
                        cover: root.detail-cover;
                        loading: root.detail-loading;
                        artwork-upload: root.playlist-artwork;
                        playlists: root.playlist-choices;
                        works: detail-page.album ? root.album-works : [];
                        facts: detail-page.album ? root.album-release : [];
                        action(what, arg) => {
                            root.detail-action(what, arg);
                        }
                    }
                    if detail-page.has-info && !detail-page.side: HorizontalLayout {
                        padding-left: Shell.pad;
                        padding-bottom: 6px;
                        spacing: 4px;
                        alignment: start;
                        Tab {
                            text: "曲目";
                            selected: !detail-page.info-tab;
                            clicked => {
                                detail-page.info-tab = false;
                            }
                        }
                        Tab {
                            text: "信息";
                            selected: detail-page.info-tab;
                            clicked => {
                                detail-page.info-tab = true;
                            }
                        }
                    }
                    // Tracks and the info column (explicit geometry: a
                    // layout would make the track columns' widths loop).
                    body := Rectangle {
                        vertical-stretch: 1;
                        property <bool> show-info: detail-page.has-info && (detail-page.side || detail-page.info-tab);
                        // Inspector 440 (340 below 1700) beside the tracks, 56 apart.
                        property <length> info-w: detail-page.side ? (Shell.tier == 2 ? 440px : 340px) + Shell.pad + 16px : self.width;
                        if !(detail-page.has-info && !detail-page.side && detail-page.info-tab): TrackList {
                            x: 0;
                            y: 0;
                            width: body.width - (body.show-info ? body.info-w : 0px);
                            height: body.height;
                            rows: root.detail-tracks;
                            mode: root.detail.kind == 0 ? 1 : root.detail.kind == 2 ? 2 : 0;
                            loading: root.detail-loading;
                            empty-text: root.detail.kind == 2 ? "歌单是空的" : "没有曲目";
                            playing-id: root.playing-id;
                            playlists: root.playlist-choices;
                            action(what, i, arg) => {
                                root.track-action(2, what, i, arg);
                            }
                        }
                        if body.show-info: AlbumInspector {
                            x: body.width - body.info-w + (detail-page.side ? 16px : Shell.pad);
                            y: 0;
                            width: body.info-w - (detail-page.side ? 16px : Shell.pad);
                            height: body.height;
                            works: root.album-works;
                            // The header shows the release facts when there is room.
                            release: detail-head.facts-shown ? [] : root.album-release;
                            people: root.album-people;
                            media: root.album-media;
                            review: root.album-review;
                            action(what, id) => {
                                root.navigate(what == "work" ? 13 : 11, id);
                            }
                        }
                    }
                }

                // Artist: one scrolling page with top tracks and releases.
                if root.page == 10 && root.detail.kind == 1: artist-flick := Flickable {
                    property <length> flex: max(0px, self.width - 2 * Shell.pad - 44px - 40px - 64px - 80px);
                    content-height: artist-page.preferred-height;
                    artist-page := VerticalLayout {
                        width: artist-flick.width;
                        alignment: start;
                        padding-bottom: 24px;
                        DetailHeader {
                            info: root.detail;
                            cover: root.detail-cover;
                            loading: root.detail-loading;
                            playlists: root.playlist-choices;
                            favorite-count: root.artist-favs.length;
                            action(what, arg) => {
                                root.detail-action(what, arg);
                            }
                        }
                        // 关于, the release groups, 收藏的歌曲 (no 热门歌曲).
                        if root.artist-about != "": about := VerticalLayout {
                            padding-left: Shell.pad;
                            padding-right: Shell.pad;
                            padding-bottom: 8px;
                            spacing: 6px;
                            property <bool> expanded;
                            Text {
                                height: 40px;
                                text: "关于 " + root.detail.title;
                                color: Theme.text;
                                font-size: Shell.tier == 2 ? 26px : 22px;
                                font-weight: 780;
                                vertical-alignment: center;
                            }
                            // Three lines unless expanded.
                            Rectangle {
                                height: about.expanded ? about-measure.preferred-height : min(about-measure.preferred-height, 54px);
                                clip: true;
                                about-measure := Text {
                                    y: 0;
                                    width: parent.width;
                                    height: self.preferred-height;
                                    text: root.artist-about;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                            if about-measure.preferred-height > 56px: HorizontalLayout {
                                alignment: start;
                                LinkText {
                                    text: about.expanded ? "收起" : "展开";
                                    clicked => {
                                        about.expanded = !about.expanded;
                                    }
                                }
                            }
                        }
                        for g[gi] in root.artist-groups: group := VerticalLayout {
                            HorizontalLayout {
                                padding-left: Shell.pad;
                                padding-right: Shell.pad;
                                height: 52px;
                                spacing: 10px;
                                Text {
                                    text: g.title;
                                    color: Theme.text;
                                    font-size: Shell.tier == 2 ? 26px : 22px;
                                    font-weight: 780;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: g.count;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-faint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                // Electron `AlbumSection`: play / next / last
                                // for every album of the group.
                                IconButton {
                                    kind: IconKind.play;
                                    size: 30px;
                                    icon-size: 14px;
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.detail-action("group-play", gi);
                                    }
                                }
                                GhostButton {
                                    text: "下一首播放";
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.detail-action("group-next", gi);
                                    }
                                }
                                GhostButton {
                                    text: "添加到末尾";
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.detail-action("group-last", gi);
                                    }
                                }
                            }
                            CardRows {
                                width: artist-flick.width;
                                rows: g.rows;
                                kind: 0;
                                playlists: root.playlist-choices;
                                // Covers of the rows on screen, plus half a
                                // screen above and below.
                                lazy: true;
                                view-top: -artist-flick.content-y - group.y - self.y - artist-flick.height / 2;
                                view-bottom: self.view-top + artist-flick.height * 2;
                                row-shown(row) => {
                                    root.card-row-shown(g.grid, row);
                                }
                                layout-changed(n, size) => {
                                    root.card-layout-changed(g.grid, n, size);
                                }
                                action(what, id, arg) => {
                                    root.card-action(g.grid, what, id, arg);
                                }
                            }
                        }
                        // Electron `FAVORITE_SONGS`. The gap above sits
                        // outside the header so the actions centre on the
                        // title (same header as the release groups).
                        if root.artist-favs.length > 0: Rectangle {
                            height: 12px;
                        }
                        if root.artist-favs.length > 0: HorizontalLayout {
                            padding-left: Shell.pad;
                            padding-right: Shell.pad;
                            height: 52px;
                            spacing: 10px;
                            Text {
                                text: "收藏的歌曲";
                                color: Theme.text;
                                font-size: Shell.tier == 2 ? 26px : 22px;
                                font-weight: 780;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.artist-favs.length;
                                font-family: Fonts.family(self.text);
                                color: Theme.text-faint;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            // Like the release groups: play / shuffle just
                            // these favorites (track list 12).
                            IconButton {
                                kind: IconKind.play;
                                size: 30px;
                                icon-size: 14px;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    root.play-list(12, false);
                                }
                            }
                            GhostButton {
                                text: "随机播放";
                                has-icon: true;
                                icon: IconKind.shuffle;
                                y: (parent.height - self.height) / 2;
                                clicked => {
                                    root.play-list(12, true);
                                }
                            }
                        }
                        for track in root.artist-favs: TrackRowView {
                            track: track;
                            mode: 0;
                            playing: track.id == root.playing-id;
                            playlists: root.playlist-choices;
                            title-w: artist-flick.flex * 0.42;
                            artist-w: artist-flick.flex * 0.24;
                            album-w: artist-flick.flex * 0.34;
                            action(what, arg) => {
                                root.track-action(12, what, track.index, arg);
                            }
                        }
                    }
                }

                if root.page == 20: HomePage {
                    playlists: root.playlist-choices;
                    playing-id: root.playing-id;
                    playing-mix: root.playing-mix;
                    card-action(grid, what, id, arg) => {
                        root.card-action(grid, what, id, arg);
                    }
                    card-layout(grid, n, size) => {
                        root.card-layout-changed(grid, n, size);
                    }
                    card-limit(grid, n) => {
                        root.card-limit-changed(grid, n);
                    }
                    track-action(list, what, i, arg) => {
                        root.track-action(list, what, i, arg);
                    }
                    navigate(page, id) => {
                        root.navigate(page, id);
                    }
                    open-web(path) => {
                        Lib032.open-web(path);
                    }
                }

                if root.page == 21: WorksPage {
                    playlists: root.playlist-choices;
                    card-action(what, id, arg) => {
                        root.card-action(8, what, id, arg);
                    }
                    card-layout(n, size) => {
                        root.card-layout-changed(8, n, size);
                    }
                }

                if root.page == 22: SeriesPage {
                    card-action(what, id, arg) => {
                        root.card-action(9, what, id, arg);
                    }
                    card-layout(n, size) => {
                        root.card-layout-changed(9, n, size);
                    }
                }

                if root.page == 23: HistoryPage {
                    playing-id: root.playing-id;
                    playlists: root.playlist-choices;
                    track-action(what, i, arg) => {
                        root.track-action(10, what, i, arg);
                    }
                    clear => {
                        root.dialog-message = "这会永久清除全部播放次数和断点位置，不会删除歌曲或收藏。此操作不可撤销。";
                        root.dialog = 4;
                    }
                }

                if root.page == 10 && root.detail.kind == 4: WorkPage {
                    tracks: root.detail-tracks;
                    loading: root.detail-loading;
                    playing-id: root.playing-id;
                    playlists: root.playlist-choices;
                    card-action(what, id, arg) => {
                        root.card-action(14, what, id, arg);
                    }
                    card-layout(n, size) => {
                        root.card-layout-changed(14, n, size);
                    }
                    track-action(what, i, arg) => {
                        root.track-action(2, what, i, arg);
                    }
                    navigate(page, id) => {
                        root.navigate(page, id);
                    }
                }

                if root.page == 10 && root.detail.kind == 5: SeriesDetailPage {
                    loading: root.detail-loading;
                    playlists: root.playlist-choices;
                    card-action(grid, what, id, arg) => {
                        root.card-action(grid, what, id, arg);
                    }
                    card-layout(grid, n, size) => {
                        root.card-layout-changed(grid, n, size);
                    }
                }

                if root.page == 10 && root.detail.kind == 6: MixPage {
                    tracks: root.detail-tracks;
                    loading: root.detail-loading;
                    playing-id: root.playing-id;
                    playing-mix: root.playing-mix;
                    playlists: root.playlist-choices;
                    track-action(what, i, arg) => {
                        root.track-action(2, what, i, arg);
                    }
                    open-mix(id) => {
                        root.navigate(15, id);
                    }
                    play-mix(id) => {
                        Home.action("mix-play", id);
                    }
                }

                if root.page == 2: SettingsView {
                    shortcuts: root.shortcuts;
                    recording: root.recording-shortcut;
                    record-shortcut(i) => { root.recording-shortcut = i; }
                    clear-shortcut(i) => { root.clear-shortcut(i); }
                    reset-shortcuts => { root.reset-shortcuts(); }
                    server-label: root.server-label;
                    logout => {
                        root.logout();
                    }
                    app-version: root.app-version;
                    update-version: root.update-version;
                    open-update => {
                        root.open-update();
                    }
                    open-logs => {
                        root.open-logs();
                    }
                    devices: root.audio-devices;
                    device-index <=> root.audio-device-index;
                    exclusive <=> root.exclusive;
                    output-busy: root.output-busy;
                    opened => {
                        root.settings-opened();
                    }
                    device-selected(i) => {
                        root.output-busy = true;
                        root.audio-device-selected(i);
                    }
                    exclusive-toggled(on) => {
                        root.output-busy = true;
                        root.exclusive-toggled(on);
                    }
                    tray-available: root.tray-available;
                    close-to-tray <=> root.close-to-tray;
                    close-to-tray-toggled(on) => {
                        root.close-to-tray-toggled(on);
                    }
                    theme-mode <=> root.theme-mode;
                    theme-selected(i) => {
                        root.theme-selected(i);
                    }
                    fade-on-pause <=> root.fade-on-pause;
                    fade-on-pause-toggled(on) => {
                        root.fade-on-pause-toggled(on);
                    }
                    transcode-options: root.transcode-options;
                    transcode-index <=> root.transcode-index;
                    transcode-selected(i) => {
                        root.transcode-selected(i);
                    }
                    lyrics-translation: root.lyrics-translation-available;
                    lyrics-language <=> root.lyrics-language;
                    lyrics-mode <=> root.lyrics-mode;
                    lyrics-auto <=> root.lyrics-auto;
                    lyrics-changed => {
                        root.lyrics-settings-changed();
                    }
                }

                if root.can-go-back && root.page == 10: Rectangle {
                    x: 16px;
                    y: 14px;
                    width: 36px;
                    height: 36px;
                    border-radius: 18px;
                    background: back-area.has-hover ? Theme.surface-hover : Theme.raised.with-alpha(0.85);
                    Icon {
                        kind: IconKind.back;
                        width: 18px;
                        height: 18px;
                        color: Theme.text;
                    }
                    back-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.go-back();
                        }
                    }
                }

                // Narrow windows: the right panel is an overlay, opened here
                // or from the player bar.
                if root.small && !root.overlay-open: Rectangle {
                    x: parent.width - self.width - 14px;
                    y: 14px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: open-area.has-hover ? Theme.surface-hover : Theme.raised;
                    drop-shadow-blur: 16px;
                    drop-shadow-offset-y: 6px;
                    drop-shadow-color: #00000066;
                    Icon {
                        kind: IconKind.lyrics;
                        width: 18px;
                        height: 18px;
                        color: Theme.text-dim;
                    }
                    open-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-panel(false);
                        }
                    }
                }
            }

            // Room for the docked right panel (drawn above, see `right`).
            Rectangle {
                width: root.panel-docked ? root.panel-w : 0px;
            }
        }

        PlayerBar {
            tier: root.tier;
            exclusive: root.exclusive;
            exclusive-busy: root.output-busy;
            toggle-exclusive(on) => {
                root.output-busy = true;
                root.exclusive-toggled(on);
            }
            has-track: root.has-track;
            show-cover: !root.panel-shown || root.full-open;
            full-open: root.full-open;
            toggle-full => {
                if root.full-open {
                    root.close-full();
                } else {
                    root.open-full(0);
                }
            }
            title: root.np-title;
            artist: root.np-artist;
            album: root.np-album;
            quality: root.np-quality;
            cover: root.np-cover;
            favorite: root.np-favorite;
            position-ms: root.position-ms;
            duration-ms: root.duration-ms;
            position-text: root.position-text;
            duration-text: root.duration-text;
            paused: root.paused;
            buffering: root.buffering;
            volume: root.volume;
            lyrics-open: root.panel-shown && !root.panel-queue-tab;
            queue-open: root.panel-shown && root.panel-queue-tab;
            shuffle: root.shuffle;
            repeat: root.repeat;
            sleep-active: root.sleep-active;
            sleep-label: root.sleep-label;
            set-sleep(mode, minutes) => {
                root.set-sleep(mode, minutes);
            }
            toggle-favorite => {
                root.toggle-now-favorite();
            }
            open-album => {
                root.open-now-album();
            }
            open-artist => {
                root.open-now-artist();
            }
            toggle-queue => {
                root.toggle-panel(true);
            }
            toggle-shuffle => {
                root.toggle-shuffle();
            }
            cycle-repeat => {
                root.cycle-repeat();
            }
            toggle-pause => {
                root.toggle-pause();
            }
            next => {
                root.next();
            }
            previous => {
                root.previous();
            }
            seek(ms) => {
                root.seek(ms);
            }
            volume-changed(v) => {
                root.volume = v;
                root.volume-changed(v);
            }
            toggle-lyrics => {
                root.toggle-panel(false);
            }
        }
    }

    // Right "now playing" panel (D2): docked beside the pages, or an
    // overlay on narrow windows. The left edge resizes it (wide windows).
    if root.logged-in && root.panel-shown: right := Rectangle {
        x: root.width - self.width;
        y: 0;
        width: root.panel-w;
        height: root.height - root.bar-h;
        property <length> press-x;
        np := NowPlayingPanel {
            has-track: root.has-track;
            title: root.np-title;
            artist: root.np-artist;
            album: root.np-album;
            quality: root.np-quality;
            cover: root.np-cover-large;
            favorite: root.np-favorite;
            exclusive: root.exclusive;
            bit-perfect: root.transcode-index == 0;
            art: root.np-art-side;
            tab: root.panel-queue-tab ? 1 : 0;
            queue-count: root.queue-total;
            lyrics-source: root.lyrics-source;
            floating: root.small;
            tab-selected(i) => {
                root.panel-queue-tab = i == 1;
                root.panel-changed();
            }
            toggle-favorite => {
                root.toggle-now-favorite();
            }
            open-album => {
                root.open-now-album();
            }
            open-artist => {
                root.open-now-artist();
            }
            open-full => {
                root.open-full(0);
            }

            if !root.panel-queue-tab: LyricsPanel {
                x: 0;
                y: 0;
                width: np.pane-width;
                height: np.pane-height;
                fades: true;
                fade: Theme.panel;
                lines: root.lyrics;
                active: root.lyrics-active;
                synced: root.lyrics-synced;
                source: root.lyrics-source;
                has-track: root.has-track;
                lines-have-translation: root.lyrics-translated-lines;
                can-search: root.lyrics-can-search;
                can-translate: root.lyrics-can-translate;
                translation-shown: root.lyrics-translation-shown;
                translating: root.lyrics-translating;
                offset-ms: root.lyrics-offset;
                seek-line(i) => {
                    root.lyrics-seek(i);
                }
                tool(what) => {
                    if what == "search" {
                        root.dialog = 5;
                    }
                    root.lyrics-tool(what);
                }
                offset(ms) => {
                    root.lyrics-offset-changed(ms);
                }
            }
            if root.panel-queue-tab: QueuePanel {
                x: 0;
                y: 0;
                width: np.pane-width;
                height: np.pane-height;
                background: transparent;
                show-title: false;
                side-padding: 24px;
                rows: root.queue;
                total: root.queue-total;
                current: root.queue-current;
                search <=> root.queue-search;
                search-changed(text) => {
                    root.queue-search-changed(text);
                }
                save => {
                    root.save-queue();
                }
                play(uid) => {
                    root.play-queue-item(uid);
                }
                remove(uid) => {
                    root.remove-queue-item(uid);
                }
                move(uid, to) => {
                    root.move-queue-item(uid, to);
                }
                clear => {
                    root.clear-queue();
                }
            }
        }

        // Resize from the left edge.
        if root.wide: Rectangle {
            x: 0;
            width: 5px;
            background: edge-area.has-hover || edge-area.pressed ? Theme.accent-dim : transparent;
            edge-area := TouchArea {
                mouse-cursor: col-resize;
                pointer-event(e) => {
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                        right.press-x = self.mouse-x;
                    }
                    if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                        root.panel-width = right.width;
                        root.panel-changed();
                    }
                }
                moved => {
                    if self.pressed {
                        root.panel-width = clamp(right.width - (self.mouse-x - right.press-x), 300px, root.panel-max);
                    }
                }
            }
        }
    }

    if root.logged-in && root.full-open: full := FullScreenPlayer {
        x: 0;
        y: 0;
        width: root.width;
        // The player bar stays visible.
        height: root.height - root.bar-h;
        cover: root.full-cover;
        has-track: root.has-track;
        title: root.np-title;
        artist: root.np-artist;
        album: root.np-album;
        quality: root.np-quality;
        exclusive: root.exclusive;
        bit-perfect: root.transcode-index == 0;
        lyrics-source: root.lyrics-source;
        tab: root.full-tab;
        tab-selected(i) => {
            root.full-tab = i;
            root.full-changed();
        }
        close => {
            root.close-full();
        }
        open-album => {
            root.open-now-album();
        }
        open-artist => {
            root.open-now-artist();
        }
        show-info => {
            root.now-info();
        }
        cover-resized(side) => {
            root.full-cover-side = side;
            root.full-changed();
        }

        // Up next: the right column (wide) or the first tab.
        if full.wide ? root.full-tab != 1 : root.full-tab == 0: QueuePanel {
            x: full.wide ? full.side-x : full.pane-x;
            y: full.wide ? full.side-y : full.pane-y;
            width: full.wide ? full.side-w : full.pane-width;
            height: full.wide ? full.side-h : full.pane-height;
            background: transparent;
            show-title: false;
            side-padding: 12px;
            rows: root.queue;
            total: root.queue-total;
            current: root.queue-current;
            search <=> root.queue-search;
            search-changed(text) => {
                root.queue-search-changed(text);
            }
            save => {
                root.save-queue();
            }
            play(uid) => {
                root.play-queue-item(uid);
            }
            remove(uid) => {
                root.remove-queue-item(uid);
            }
            move(uid, to) => {
                root.move-queue-item(uid, to);
            }
            clear => {
                root.clear-queue();
            }
        }
        if root.full-tab == 1: TrackList {
            x: full.wide ? full.side-x : full.pane-x;
            y: full.wide ? full.side-y : full.pane-y;
            width: full.wide ? full.side-w : full.pane-width;
            height: full.wide ? full.side-h : full.pane-height;
            pad: 0px;
            rows: root.full-related;
            mode: 1;
            playing-id: root.playing-id;
            playlists: root.playlist-choices;
            loading: root.full-related-loading;
            empty-text: root.has-track ? "没有相关歌曲" : "";
            action(what, i, arg) => {
                root.track-action(11, what, i, arg);
            }
        }
        // Lyrics: the middle column (wide, tools in its header) or the
        // third tab (centered, tools at the bottom).
        if full.wide || root.full-tab == 2: LyricsPanel {
            x: full.wide ? full.lyrics-x - 8px : full.pane-x;
            y: full.wide ? full.lyrics-y : full.pane-y;
            width: full.wide ? full.lyrics-w + 16px : full.pane-width;
            height: full.wide ? full.lyrics-h : full.pane-height;
            large: !full.wide;
            stage: full.wide;
            show-tools: !full.wide;
            side-padding: full.wide ? 8px : 24px;
            fades: true;
            fade: Theme.stage;
            lines: root.lyrics;
            active: root.lyrics-active;
            synced: root.lyrics-synced;
            source: root.lyrics-source;
            has-track: root.has-track;
            lines-have-translation: root.lyrics-translated-lines;
            can-search: root.lyrics-can-search;
            can-translate: root.lyrics-can-translate;
            translation-shown: root.lyrics-translation-shown;
            translating: root.lyrics-translating;
            offset-ms: root.lyrics-offset;
            seek-line(i) => {
                root.lyrics-seek(i);
            }
            tool(what) => {
                if what == "search" {
                    root.dialog = 5;
                }
                root.lyrics-tool(what);
            }
            offset(ms) => {
                root.lyrics-offset-changed(ms);
            }
        }
        if full.wide && root.has-track: Rectangle {
            x: full.tools-x;
            y: full.tools-y;
            width: full-tools.preferred-width + 8px;
            height: 38px;
            border-radius: 12px;
            background: Theme.text.with-alpha(0.05);
            full-tools := LyricsTools {
                x: 4px;
                y: 4px;
                synced: root.lyrics-synced;
                has-lines: root.lyrics.length > 0;
                can-search: root.lyrics-can-search;
                can-translate: root.lyrics-can-translate;
                translation-shown: root.lyrics-translation-shown;
                translating: root.lyrics-translating;
                offset-ms: root.lyrics-offset;
                on-stage: true;
                tool(what) => {
                    if what == "search" {
                        root.dialog = 5;
                    }
                    root.lyrics-tool(what);
                }
                offset(ms) => {
                    root.lyrics-offset-changed(ms);
                }
            }
        }
    }

    if root.dialog == 1 || root.dialog == 2: PromptDialog {
        title: root.dialog == 1 ? "新建歌单" : "编辑歌单";
        confirm-text: root.dialog == 1 ? "创建" : "保存";
        name <=> root.dialog-name;
        description <=> root.dialog-description;
        confirm(name, description) => {
            root.dialog-confirm(name, description);
            root.dialog = 0;
        }
        cancel => {
            root.dialog = 0;
        }
    }

    if root.dialog == 4: ConfirmDialog {
        title: "确定清空全部播放记录吗？";
        message: root.dialog-message;
        confirm-text: "永久清空";
        confirm => {
            root.dialog = 0;
            Lib032.detail-action("clear-history", 0);
        }
        cancel => {
            root.dialog = 0;
        }
    }

    if root.dialog == 6: InfoDialog {
        rows: root.info-rows;
        close => {
            root.dialog = 0;
        }
    }

    if root.dialog == 5: LyricsSearchDialog {
        close => {
            root.dialog = 0;
        }
    }

    if root.dialog == 3: ConfirmDialog {
        title: "删除歌单";
        message: root.dialog-message;
        confirm-text: "删除";
        confirm => {
            root.dialog-confirm("", "");
            root.dialog = 0;
        }
        cancel => {
            root.dialog = 0;
        }
    }

    } // shortcut-scope

    // Toast.
    if root.notice != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - root.bar-h - self.height - 16px;
        width: min(560px, toast.preferred-width + 32px);
        height: toast.preferred-height + 20px;
        border-radius: Theme.radius;
        background: Theme.raised;
        border-width: 1px;
        border-color: Theme.border;
        toast := Text {
            text: root.notice;
            font-family: Fonts.family(self.text);
            color: Theme.text;
            wrap: word-wrap;
            width: min(528px, self.preferred-width);
        }
    }
}
