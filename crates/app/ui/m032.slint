// 032 pages: home, works, series, daily mixes, playback history and the
// lyrics search dialog. Their data lives in the globals `Home`, `Lib032`
// and `LyricsSearch`, set from Rust; actions go through the callbacks of
// the components (forwarded by app.slint) or of the globals.

import { ComboBox, CheckBox, ListView } from "std-widgets.slint";
import { Fonts, Theme, Shell } from "theme.slint";
import { PlayingBars,
    Field, PrimaryButton, IconButton, IconKind, Icon, SearchField, GhostButton, Tab, BigTitle, MoreLink,
    RoundIconButton,
} from "controls.slint";
import { AlbumCard, AlbumRow, TrackRow, PlaylistChoice, CardView, TrackRowView, TrackList, TrackColumns } from "views.slint";
import { CardRows, PageHeader } from "library.slint";

// A small row with a cover on the home page (接着听, 最近播放, 主题曲,
// 今日推荐). `percent` < 0: no progress bar. `link`: the work of a song.
// `covers`: 2x2 mosaic of a daily mix (four covers, else `cover` is used).
export struct HomeRow {
    index: int,
    id: int,
    title: string,
    subtitle: string,
    cover: image,
    album-id: int,
    artist-id: int,
    favorite: bool,
    tag: string,
    tag-accent: bool,
    link: string,
    link-id: int,
    note: string,
    percent: int,
    duration: string,
    dimmed: bool,
    covers: [image],
}

// An album tab of the spotlight. `tab`: 0 recent, 1 listening, 3 random;
// `list`: track list id of its preview tracks.
export struct AlbumPane {
    tab: int,
    list: int,
    album-id: int,
    title: string,
    artist: string,
    artist-id: int,
    facts: string,
    spec: string,
    note: string,
    resume: string,
    more: string,
    favorite: bool,
    cover: image,
    track-count: int,
}

export struct SeriesPane {
    is-series: bool,
    series-id: int,
    first-work-id: int,
    title: string,
    by: string,
    facts: string,
    album-count: int,
}

export struct NamedItem {
    id: int,
    title: string,
    meta: string,
    year: string,
    cover: image,
}

export struct YearBar {
    year: int,
    count: int,
    height: int,
}

export struct HomeStats {
    albums: int,
    tracks: int,
    works: int,
    last-scan: string,
    pending: int,
}

export struct WorkInfo {
    id: int,
    title: string,
    translated: string,
    reading: string,
    facts: string,
    bangumi-url: string,
    series-id: int,
    series-title: string,
    series-meta: string,
    album-count: int,
    collected: int,
}

export struct SeriesInfo {
    id: int,
    title: string,
    renamed: bool,
    facts: string,
    member-count: int,
    album-count: int,
    playing: bool,
}

export struct MixTag {
    label: string,
    style: bool,
}

export struct MixInfo {
    id: int,
    title: string,
    description: string,
    kicker: string,
    subtitle: string,
    // 1 like, -1 dislike.
    rating: int,
    disliked-note: string,
    current: bool,
    replacements-left: int,
    saved-playlist-id: int,
    track-count: int,
}

export struct LyricsResult {
    title: string,
    artist: string,
    meta: string,
    score: string,
}

// The 032 home.
export global Home {
    in property <bool> loading: true;
    // The server has no home endpoint.
    in property <bool> unavailable;
    in property <bool> empty;
    // Spotlight: tab labels and ids (0 recent, 1 listening, 2 series, 3 random).
    in property <[string]> tab-labels;
    in property <[int]> tab-ids;
    in property <int> tab;
    in property <AlbumPane> pane;
    in property <[TrackRow]> pane-tracks;
    in property <SeriesPane> series;
    in property <[image]> series-fan;
    // Spotlight cover size (logical), set by the page; `action("hero-art")`
    // reloads the art at a new size.
    in-out property <length> hero-art: 220px;
    in property <[NamedItem]> series-works;
    in property <[NamedItem]> series-albums;
    in property <[HomeRow]> mixes;
    in property <bool> mixes-generating;
    in property <[HomeRow]> recent;
    in property <[HomeRow]> resume;
    in property <[AlbumRow]> recent-albums;
    in property <[AlbumRow]> works;
    in property <int> works-count;
    in property <int> works-pages;
    // 0 all, 1 anime, 2 game, 3 movie.
    in property <int> works-type;
    in property <[HomeRow]> songs;
    in property <int> songs-count;
    in property <int> songs-pages;
    in property <[YearBar]> years;
    in property <int> year;
    in property <int> year-total;
    in property <[AlbumRow]> chronicle;
    in property <[AlbumRow]> playlists;
    in property <HomeStats> stats;
    callback tab-selected(int);
    // play-pane, append-pane, resume, favorite, reroll, open-album,
    // play-series, open-series, works-type (type), works-next, songs-next,
    // year (year), year-all, mix-play (id), mix-open (id)
    callback action(string, int);
}

// The works, series, history and 032 detail pages.
export global Lib032 {
    in property <[AlbumRow]> works;
    in property <int> works-total;
    in property <bool> works-loading;
    in property <[string]> work-types: ["全部类型", "动画", "电视剧", "电影", "游戏", "广告", "其他"];
    callback query-works(string, int, int);
    in property <[AlbumRow]> series;
    in property <int> series-total;
    in property <bool> series-loading;
    in property <bool> series-supported: true;
    callback query-series(string);
    in property <[TrackRow]> history;
    in property <int> history-total;
    in property <bool> history-loading;
    in property <WorkInfo> work;
    in property <image> work-poster;
    in property <[AlbumRow]> work-albums;
    in property <SeriesInfo> series-info;
    in property <image> series-poster;
    in property <[AlbumRow]> series-members;
    in property <[AlbumRow]> series-albums;
    in property <MixInfo> mix;
    in property <[image]> mix-covers;
    in property <[MixTag]> mix-tags;
    in-out property <[bool]> mix-reasons: [false, false, false, false, false];
    in property <[HomeRow]> mix-others;
    // (action, argument) on the open work / series / mix page: play, shuffle,
    // last, web, bangumi, series, like, dislike, undo, replace, save, saved.
    callback detail-action(string, int);
    // Opens a page of the 032 web console in the browser.
    callback open-web(string);
}

export global LyricsSearch {
    in-out property <string> name;
    in-out property <string> artist;
    in property <[LyricsResult]> results;
    in property <bool> searching;
    in-out property <int> selected: -1;
    in property <[string]> preview;
    callback search(string, string);
    callback select(int);
    callback apply(int);
}

export component LinkText inherits Text {
    callback clicked();
    in property <bool> enabled: true;
    color: link-area.has-hover && root.enabled ? Theme.accent : Theme.text-dim;
    font-size: 13px;
    vertical-alignment: center;
    link-area := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> accent;
    width: pill-text.preferred-width + 14px;
    height: 20px;
    border-radius: 5px;
    background: root.accent ? Theme.accent-dim : Theme.raised;
    pill-text := Text {
        text: root.text;
        font-family: Fonts.family(self.text);
        color: root.accent ? Theme.accent-text : Theme.text-dim;
        font-size: 11.5px;
        font-weight: 700;
    }
}

// "◆ OP": a work use (theme songs, track tags).
component UseTag inherits Rectangle {
    in property <string> text;
    in property <bool> accent: true;
    width: use-row.preferred-width;
    height: 24px;
    border-radius: 12px;
    background: root.accent ? Theme.accent-dim : Theme.raised;
    use-row := HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 6px;
        Text {
            text: "◆";
            color: root.accent ? Theme.accent-text : Theme.text-dim;
            font-size: 9px;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.accent ? Theme.accent-text : Theme.text-dim;
            font-size: 11.5px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

// Section title (26 / 780), a faint note, a rule to the right edge, and
// tools at the end (v3 Editorial `.rule`).
component SectionHead inherits HorizontalLayout {
    in property <string> title;
    in property <string> count;
    spacing: 16px;
    height: 40px;
    Text {
        text: root.title;
        font-family: Fonts.family(self.text);
        color: Theme.text;
        font-size: Shell.tier == 2 ? 26px : Shell.tier == 1 ? 22px : 20px;
        font-weight: 780;
        letter-spacing: -0.4px;
        vertical-alignment: center;
    }
    if root.count != "": Text {
        text: root.count;
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
        font-size: 13px;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
        max-width: 360px;
    }
    Rectangle {
        horizontal-stretch: 1;
        min-width: 24px;
        Rectangle {
            height: 1px;
            background: Theme.border;
        }
    }
    @children
}

// Small segmented choice in a section head (works type).
component SegItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    y: (40px - self.height) / 2;
    height: 28px;
    width: seg-label.preferred-width + 20px;
    border-radius: 8px;
    background: root.selected ? Theme.raised : seg-area.has-hover ? Theme.surface-hover : transparent;
    seg-label := Text {
        text: root.text;
        color: root.selected ? Theme.text : Theme.text-dim;
        font-size: 13.5px;
        font-weight: root.selected ? 600 : 400;
    }
    seg-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Home "按作品漫游" card: a 2:3 poster beside type · year, the title (three
// lines), the uses, the series and "收录 N 首". `card.artist` is
// "动画 · 2023", `card.note` the uses, `card.badge` the series,
// `card.added` the track count.
component WorkCardH inherits Rectangle {
    in property <AlbumCard> card;
    // Poster width.
    in property <length> art: 128px;
    in property <length> card-width: 294px;
    callback action(string, int);
    width: root.card-width;
    height: root.art * 1.5 + 24px;
    border-radius: 12px;
    background: area.has-hover ? Theme.surface-hover : Theme.surface;

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.action("open", 0);
        }
    }

    HorizontalLayout {
        padding: 12px;
        spacing: 16px;
        Rectangle {
            width: root.art;
            height: root.art * 1.5;
            border-radius: 6px;
            background: Theme.raised;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: #00000055;
            Rectangle {
                border-radius: 6px;
                clip: true;
                if root.card.cover.width == 0: Text {
                    text: "作";
                    color: Theme.text-faint;
                    font-size: 22px;
                }
                Image {
                    source: root.card.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
            }
            if root.card.playing: Rectangle {
                x: parent.width - 30px;
                y: 8px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: Theme.bg.with-alpha(0.78);
                PlayingBars {
                    width: 11px;
                    height: 11px;
                }
            }
            if area.has-hover: Rectangle {
                x: parent.width - 42px;
                y: parent.height - 42px;
                width: 34px;
                height: 34px;
                border-radius: 17px;
                background: play-area.has-hover ? Theme.accent.brighter(15%) : Theme.accent;
                Icon {
                    kind: IconKind.play;
                    width: 14px;
                    height: 14px;
                    color: #ffffff;
                }
                play-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.action("play", 0);
                    }
                }
            }
        }
        VerticalLayout {
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;
            horizontal-stretch: 1;
            Text {
                text: root.card.artist;
                font-family: Fonts.family(self.text);
                color: Theme.accent-text;
                font-size: 12.5px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.card.title;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: 16.5px;
                font-weight: 750;
                wrap: word-wrap;
                overflow: elide;
                max-height: 66px;
            }
            if root.card.note != "": HorizontalLayout {
                alignment: start;
                padding-top: 4px;
                Pill {
                    text: root.card.note;
                    accent: true;
                    max-width: root.card-width - root.art - 40px;
                }
            }
            if root.card.badge != "": Text {
                text: "系列：" + root.card.badge;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 12.5px;
                overflow: elide;
            }
            Rectangle {
                vertical-stretch: 1;
            }
            if root.card.added != "": Text {
                text: root.card.added;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 12.5px;
                overflow: elide;
            }
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.action("play", 0);
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.action("next", 0);
                }
            }
            MenuItem {
                title: "添加到队列末尾";
                activated => {
                    root.action("last", 0);
                }
            }
        }
    }
}

// One row of cards that pages sideways with arrow buttons (no nested
// scrolling inside the page). `kind` 5: horizontal work cards (`size` is
// the poster width, `card-w` the card width).
component ShelfArrow inherits Rectangle {
    in property <bool> left;
    callback clicked();
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: arrow-area.has-hover ? Theme.surface-hover : Theme.raised;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000066;
    Icon {
        kind: root.left ? IconKind.back : IconKind.chevron-right;
        width: 18px;
        height: 18px;
        color: Theme.text;
    }
    arrow-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component CardShelf inherits Rectangle {
    in property <[AlbumRow]> rows;
    in property <int> kind;
    in property <length> size: 150px;
    in property <length> card-w: 294px;
    in property <length> side: Shell.pad;
    in property <length> gap: root.kind == 5 ? 20px : 18px;
    in property <[PlaylistChoice]> playlists;
    callback layout-changed(length);
    callback action(string, int, int);
    property <length> offset: 0px;
    property <length> content: row.preferred-width;
    // Cards scroll inside the page padding (clipped at the content edge).
    property <length> view-w: root.width - 2 * root.side;
    property <length> max-offset: max(0px, root.content - root.view-w);
    property <length> art-h: root.kind == 5 ? root.size * 1.5 + 24px : root.kind == 3 || root.kind == 4 ? root.size * 1.5 : root.size;
    height: root.art-h + (root.kind == 5 ? 12px : 90px);
    init => {
        root.layout-changed(root.size);
    }
    changed size => {
        root.layout-changed(root.size);
    }
    changed width => {
        root.offset = min(root.offset, root.max-offset);
    }

    Rectangle {
        x: root.side;
        width: root.view-w;
        clip: true;
        row := HorizontalLayout {
            x: -root.offset;
            width: max(root.view-w, self.preferred-width);
            spacing: root.gap;
            alignment: start;
            animate x { duration: 250ms; easing: ease-out; }
            for r in root.rows: HorizontalLayout {
                spacing: root.gap;
                for card in r.items: HorizontalLayout {
                    if root.kind == 5: WorkCardH {
                        card: card;
                        art: root.size;
                        card-width: root.card-w;
                        action(what, arg) => {
                            root.action(what, card.id, arg);
                        }
                    }
                    if root.kind != 5: CardView {
                        card: card;
                        kind: root.kind;
                        size: root.size;
                        playlists: root.playlists;
                        action(what, arg) => {
                            root.action(what, card.id, arg);
                        }
                    }
                }
            }
        }
    }

    if root.offset > 0: ShelfArrow {
        x: root.side + 8px;
        y: (root.art-h - self.height) / 2;
        left: true;
        clicked => {
            root.offset = max(0px, root.offset - root.view-w * 0.8);
        }
    }
    if root.offset < root.max-offset: ShelfArrow {
        x: root.width - root.side - 8px - self.width;
        y: (root.art-h - self.height) / 2;
        clicked => {
            root.offset = min(root.max-offset, root.offset + root.view-w * 0.8);
        }
    }
}

component Cover inherits Rectangle {
    in property <image> source;
    in property <string> placeholder: "032";
    border-radius: 5px;
    background: Theme.raised;
    clip: true;
    if root.source.width == 0: Text {
        text: root.placeholder;
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
        font-size: 12px;
    }
    Image {
        source: root.source;
        width: 100%;
        height: 100%;
        image-fit: ImageFit.cover;
    }
}

// A row of 今日推荐 (`mix`), 最近播放, 主题曲 (`item.tag`), or a 接着听 card
// (`card`). (action, argument): play, album (id), link (id), last, open,
// and the track menu actions.
export component HomeRowView inherits Rectangle {
    in property <HomeRow> item;
    in property <bool> playing;
    in property <bool> mix;
    in property <bool> card;
    in property <bool> show-add;
    // Narrow layouts drop the work link and the time column.
    in property <bool> hide-link;
    in property <bool> hide-note;
    in property <[PlaylistChoice]> playlists;
    callback action(string, int);
    property <bool> song: root.item.tag != "";
    property <length> art: root.card ? 84px : root.mix ? (Shell.tier == 0 ? 52px : 64px) : 48px;
    height: root.card ? 108px : root.mix ? (Shell.tier == 0 ? 66px : 80px) : root.song ? 68px : 64px;
    border-radius: root.card ? 12px : 0px;
    background: root.card ? (row-area.has-hover ? Theme.surface-hover : Theme.surface) : row-area.has-hover ? Theme.surface-hover.with-alpha(0.6) : transparent;
    opacity: root.item.dimmed ? 0.55 : 1;

    row-area := TouchArea {
        mouse-cursor: root.mix ? pointer : default;
        clicked => {
            if root.mix {
                root.action("open", 0);
            }
        }
        double-clicked => {
            root.action(root.mix ? "open" : "play", 0);
        }
    }

    if !root.card: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding: root.card ? 12px : 0px;
        spacing: root.card ? 16px : root.mix ? 16px : 16px;
        Rectangle {
            width: root.art;
            height: root.art;
            y: (parent.height - self.height) / 2;
            if root.item.covers.length < 4: Cover {
                border-radius: root.mix || root.card ? 6px : 5px;
                source: root.item.cover;
                placeholder: root.mix ? "♪" : "032";
            }
            if root.item.covers.length >= 4: Rectangle {
                border-radius: 6px;
                background: Theme.raised;
                clip: true;
                for img[i] in root.item.covers: Image {
                    x: mod(i, 2) * parent.width / 2;
                    y: floor(i / 2) * parent.height / 2;
                    width: parent.width / 2;
                    height: parent.height / 2;
                    source: img;
                    image-fit: ImageFit.cover;
                }
            }
            if !root.card: Rectangle {
                border-radius: 5px;
                background: art-area.has-hover || root.playing ? #0000008c : transparent;
                if root.playing && !art-area.has-hover: PlayingBars {
                    width: 16px;
                    height: 14px;
                    bar-color: #ffffff;
                }
                Icon {
                    visible: art-area.has-hover;
                    kind: IconKind.play;
                    width: 16px;
                    height: 16px;
                    color: #ffffff;
                }
            }
            // 接着听: a white play button on the cover.
            if root.card: Rectangle {
                x: parent.width - 36px;
                y: parent.height - 36px;
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: art-area.has-hover ? #ffffff : #ffffffeb;
                if root.playing: PlayingBars {
                    width: 12px;
                    height: 11px;
                }
                if !root.playing: Icon {
                    kind: IconKind.play;
                    width: 13px;
                    height: 13px;
                    color: #111113;
                }
            }
            art-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.action("play", 0);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: root.mix ? 4px : 3px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.item.title;
                font-family: Fonts.family(self.text);
                color: root.playing ? Theme.accent-text : Theme.text;
                font-size: root.card ? 15.5px : root.mix ? (Shell.tier == 0 ? 14.5px : 16px) : 15px;
                font-weight: root.card || root.mix ? 650 : 600;
                overflow: elide;
            }
            Text {
                text: root.item.subtitle;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: root.mix ? 13.5px : 13px;
                overflow: elide;
            }
            if root.item.percent >= 0: HorizontalLayout {
                padding-top: root.card ? 9px : 2px;
                spacing: 10px;
                Rectangle {
                    height: 3px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 2px;
                    background: Theme.raised;
                    horizontal-stretch: 1;
                    Rectangle {
                        x: 0;
                        width: parent.width * min(100, root.item.percent) / 100;
                        border-radius: 2px;
                        background: Theme.accent;
                    }
                }
                Text {
                    text: root.item.duration;
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: 12px;
                    font-weight: 500;
                }
            }
        }
        if root.song: VerticalLayout {
            alignment: center;
            UseTag {
                text: root.item.tag;
                accent: root.item.tag-accent;
            }
        }
        if root.item.link != "" && !root.hide-link: Rectangle {
            width: 240px;
            Text {
                x: 0;
                width: min(self.preferred-width, parent.width);
                text: root.item.link;
                font-family: Fonts.family(self.text);
                color: link-area.has-hover ? Theme.text : Theme.text-dim;
                font-size: 13.5px;
                overflow: elide;
                vertical-alignment: center;
                link-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.action("link", root.item.link-id);
                    }
                }
            }
        }
        if !root.card && !root.mix && !root.song && !root.hide-note && (root.item.note != "" || root.playing): Text {
            text: root.playing ? "正在播放" : root.item.note;
            font-family: Fonts.family(self.text);
            color: root.playing ? Theme.accent-text : Theme.text-faint;
            font-size: 13px;
            font-weight: 500;
            width: 100px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        if !root.card && root.item.percent < 0 && root.item.duration != "": Text {
            text: root.item.duration;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            width: 48px;
            horizontal-alignment: right;
        }
        if root.show-add: Rectangle {
            width: 28px;
            Icon {
                kind: IconKind.list-plus;
                width: 18px;
                height: 18px;
                color: add-area.has-hover ? Theme.text : Theme.text-faint;
            }
            add-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.action("last", 0);
                }
            }
        }
        if root.mix: Rectangle {
            width: 24px;
            Icon {
                kind: IconKind.chevron-right;
                width: 18px;
                height: 18px;
                color: row-area.has-hover ? Theme.text : Theme.text-faint;
            }
        }
    }

    if !root.mix: ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.action("play", 0);
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.action("next", 0);
                }
            }
            MenuItem {
                title: "添加到队列末尾";
                activated => {
                    root.action("last", 0);
                }
            }
            Menu {
                title: "添加到歌单";
                MenuItem {
                    title: "新建歌单…";
                    activated => {
                        root.action("new-playlist", 0);
                    }
                }
                for p in root.playlists: MenuItem {
                    title: p.name;
                    activated => {
                        root.action("add", p.id);
                    }
                }
            }
            MenuItem {
                title: root.item.favorite ? "取消收藏" : "收藏";
                activated => {
                    root.action("favorite", root.item.favorite ? 0 : 1);
                }
            }
            MenuItem {
                title: "相似歌曲";
                activated => {
                    root.action("similar", 0);
                }
            }
            if root.item.album-id > 0: MenuItem {
                title: "转到专辑";
                activated => {
                    root.action("album", root.item.album-id);
                }
            }
            if root.item.artist-id > 0: MenuItem {
                title: "转到艺人";
                activated => {
                    root.action("artist", root.item.artist-id);
                }
            }
        }
    }
}

// A preview row of the spotlight (tracks or related albums).
component PreviewRow inherits Rectangle {
    in property <string> number;
    in property <string> title;
    in property <string> sub;
    in property <string> end;
    in property <bool> playing;
    in property <image> cover;
    in property <bool> has-cover;
    callback clicked();
    height: 62px;
    background: pr-area.has-hover ? Theme.surface-hover.with-alpha(0.5) : transparent;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    pr-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        spacing: 12px;
        if !root.has-cover: Rectangle {
            width: 28px;
            if !root.playing: Text {
                x: 0;
                text: root.number;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if root.playing: PlayingBars {
                x: 2px;
                width: 12px;
                height: 11px;
            }
        }
        if root.has-cover: Cover {
            width: 44px;
            height: 44px;
            y: (parent.height - self.height) / 2;
            source: root.cover;
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            min-width: 0px;
            Text {
                text: root.title;
                font-family: Fonts.family(self.text);
                color: root.playing ? Theme.accent-text : Theme.text;
                font-size: 15.5px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.sub;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 13px;
                overflow: elide;
            }
        }
        Text {
            text: root.end;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 13px;
            font-weight: 500;
            width: 48px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Home spotlight (v3 Editorial): a full-bleed neutral band (D3) with the
// cover, segmented tabs over the title, and on wide windows the
// preview list on the right.
component Spotlight inherits Rectangle {
    in property <int> playing-id;
    // The preview list shows on the right (wide windows).
    in property <bool> wide;
    in property <length> art: 340px;
    in property <length> pad-x: 40px;
    in property <length> pad-y: 44px;
    in property <length> gap: 44px;
    in property <length> title-size: 64px;
    in property <length> side-w: 520px;
    callback track-action(int, string, int, int);
    callback navigate(int, int);
    property <bool> has-side: root.wide && (Home.tab == 2 ? Home.series-albums.length > 0 : Home.pane-tracks.length > 0);
    height: max(root.art, info.preferred-height) + 2 * root.pad-y;
    background: @linear-gradient(90deg, Theme.hero-from 0%, Theme.hero-to 60%, Theme.hero-to 100%);

    HorizontalLayout {
        padding-left: root.pad-x;
        padding-right: root.pad-x;
        padding-top: root.pad-y;
        padding-bottom: root.pad-y;
        spacing: root.gap;

        // Art: the album cover, or up to three covers fanned out.
        if Home.tab != 2: Rectangle {
            width: root.art;
            height: root.art;
            y: (parent.height - self.height) / 2;
            background: Theme.raised;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 24px;
            drop-shadow-color: #000000a0;
            Image {
                source: Home.pane.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    Home.action("open-album", Home.pane.album-id);
                }
            }
        }
        if Home.tab == 2: Rectangle {
            width: root.art;
            // Three covers fanned out inside the art box.
            property <length> fan: floor(root.art * 0.77 / 1px) * 1px;
            for img[i] in Home.series-fan: Rectangle {
                x: i * (root.art - parent.fan) / 2;
                y: (parent.height - root.art) / 2 + i * (root.art - parent.fan) / 2;
                width: parent.fan;
                height: parent.fan;
                background: Theme.raised;
                drop-shadow-blur: 16px;
                drop-shadow-color: #00000080;
                Image {
                    source: img;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
            }
        }

        info := VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            spacing: 0px;
            // Segmented tabs (Electron `SegmentedControl`).
            HorizontalLayout {
                alignment: start;
                Rectangle {
                    border-radius: 12px;
                    background: Theme.dark ? #0000004d : #0000000f;
                    width: seg-row.preferred-width;
                    height: 40px;
                    seg-row := HorizontalLayout {
                        padding: 4px;
                        spacing: 2px;
                        for label[i] in Home.tab-labels: Rectangle {
                            property <bool> on: Home.tab-ids[i] == Home.tab;
                            width: seg-text.preferred-width + 28px;
                            border-radius: 8px;
                            background: self.on ? (Theme.dark ? #ffffff1f : #ffffff) : seg-area.has-hover ? (Theme.dark ? #ffffff10 : #0000000a) : transparent;
                            seg-text := Text {
                                text: label;
                                font-family: Fonts.family(self.text);
                                color: parent.on ? Theme.text : Theme.text-dim;
                                font-size: 13.5px;
                                font-weight: parent.on ? 600 : 400;
                            }
                            seg-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Home.tab-selected(Home.tab-ids[i]);
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                min-height: 16px;
            }

            if Home.tab != 2: VerticalLayout {
                spacing: 0px;
                BigTitle {
                    text: Home.pane.title;
                    max-size: root.title-size;
                    text-color: title-area.has-hover ? Theme.accent-text : Theme.text;
                    title-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            Home.action("open-album", Home.pane.album-id);
                        }
                    }
                }
                HorizontalLayout {
                    alignment: start;
                    padding-top: Shell.tier == 2 ? 14px : 8px;
                    Text {
                        text: Home.pane.artist;
                        font-family: Fonts.family(self.text);
                        color: artist-area.has-hover && Home.pane.artist-id > 0 ? Theme.accent-text : Theme.text;
                        font-size: Shell.tier == 2 ? 24px : Shell.tier == 1 ? 20px : 18px;
                        font-weight: 600;
                        overflow: elide;
                        artist-area := TouchArea {
                            mouse-cursor: Home.pane.artist-id > 0 ? pointer : default;
                            clicked => {
                                if Home.pane.artist-id > 0 {
                                    root.navigate(11, Home.pane.artist-id);
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    padding-top: 12px;
                    Text {
                        text: Home.pane.facts;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-dim;
                        font-size: 14.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if Home.pane.spec != "": Pill {
                        y: (parent.height - self.height) / 2;
                        text: Home.pane.spec;
                    }
                    if Home.pane.note != "": Text {
                        text: Home.pane.note;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-dim;
                        font-size: 14.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    padding-top: Shell.tier == 2 ? 26px : 16px;
                    PrimaryButton {
                        text: Home.pane.resume != "" ? Home.pane.resume : "播放";
                        has-icon: true;
                        clicked => {
                            Home.action(Home.pane.resume != "" ? "resume" : "play-pane", 0);
                        }
                    }
                    GhostButton {
                        height: 40px;
                        has-icon: true;
                        icon: Home.pane.resume != "" ? IconKind.play : IconKind.list-plus;
                        text: Home.pane.resume != "" ? "从头播放" : "加入队列";
                        clicked => {
                            Home.action(Home.pane.resume != "" ? "play-pane" : "append-pane", 0);
                        }
                    }
                    RoundIconButton {
                        kind: Home.pane.favorite ? IconKind.heart : IconKind.heart-outline;
                        active: Home.pane.favorite;
                        clicked => {
                            Home.action("favorite", Home.pane.favorite ? 0 : 1);
                        }
                    }
                    if Home.tab == 3: GhostButton {
                        height: 40px;
                        text: "换一张";
                        clicked => {
                            Home.action("reroll", 0);
                        }
                    }
                    if !root.has-side: MoreLink {
                        y: (parent.height - self.height) / 2;
                        text: "专辑详情";
                        clicked => {
                            Home.action("open-album", Home.pane.album-id);
                        }
                    }
                }
            }

            if Home.tab == 2: VerticalLayout {
                spacing: 0px;
                BigTitle {
                    text: Home.series.title;
                    max-size: root.title-size;
                }
                Text {
                    text: Home.series.by;
                    font-family: Fonts.family(self.text);
                    color: Theme.text;
                    font-size: Shell.tier == 2 ? 24px : Shell.tier == 1 ? 20px : 18px;
                    font-weight: 600;
                    overflow: elide;
                }
                HorizontalLayout {
                    padding-top: 12px;
                    Text {
                        text: Home.series.facts;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-dim;
                        font-size: 14.5px;
                        overflow: elide;
                    }
                }
                // Work capsules, clipped: their width must not widen the band.
                Rectangle {
                    height: Home.series-works.length > 0 ? 50px : 0px;
                    min-width: 0px;
                    preferred-width: 0px;
                    clip: true;
                    HorizontalLayout {
                        x: 0;
                        y: 14px;
                        height: 36px;
                        width: max(parent.width, self.preferred-width);
                        spacing: 8px;
                        alignment: start;
                        for w in Home.series-works: Rectangle {
                            height: 36px;
                            width: chip-row.preferred-width;
                            border-radius: 18px;
                            background: chip-area.has-hover ? Theme.surface-hover : Theme.raised;
                            chip-row := HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 8px;
                                Text {
                                    text: w.title;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text;
                                    font-size: 13.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 220px;
                                }
                                Text {
                                    text: w.meta;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-faint;
                                    font-size: 12.5px;
                                    vertical-alignment: center;
                                }
                            }
                            chip-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.navigate(13, w.id);
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    padding-top: Shell.tier == 2 ? 22px : 14px;
                    PrimaryButton {
                        text: Home.series.is-series ? "播放系列全部歌曲" : "播放作品全部歌曲";
                        has-icon: true;
                        clicked => {
                            Home.action("play-series", 0);
                        }
                    }
                    GhostButton {
                        height: 40px;
                        text: Home.series.is-series ? "查看系列" : "查看作品";
                        clicked => {
                            Home.action("open-series", 0);
                        }
                    }
                    MoreLink {
                        y: (parent.height - self.height) / 2;
                        text: "全部作品";
                        clicked => {
                            root.navigate(21, 0);
                        }
                    }
                }
            }
        }

        // Preview tracks / related albums (wide windows), after a rule.
        if root.has-side: HorizontalLayout {
            width: root.side-w;
            spacing: 32px;
            Rectangle {
                width: 1px;
                background: Theme.border;
            }
            VerticalLayout {
                alignment: end;
                spacing: 0px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    padding-bottom: 8px;
                    Text {
                        text: Home.tab == 2 ? "关联专辑" : "曲目";
                        color: Theme.text-faint;
                        font-size: 13px;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: Home.tab == 2 ? Home.series.album-count + " 张专辑" : Home.pane.track-count + " 首";
                        font-family: Fonts.family(self.text);
                        color: Theme.text-faint;
                        font-size: 13px;
                    }
                }
                if Home.tab != 2: VerticalLayout {
                    for t[i] in Home.pane-tracks: PreviewRow {
                        visible: i < 4;
                        height: i < 4 ? 62px : 0px;
                        number: t.number;
                        title: t.title;
                        sub: t.artist;
                        end: t.duration;
                        playing: t.id == root.playing-id;
                        clicked => {
                            root.track-action(Home.pane.list, "play", t.index, 0);
                        }
                    }
                }
                if Home.tab == 2: VerticalLayout {
                    for a[i] in Home.series-albums: PreviewRow {
                        visible: i < 4;
                        height: i < 4 ? 62px : 0px;
                        has-cover: true;
                        cover: a.cover;
                        title: a.title;
                        sub: a.meta;
                        end: a.year;
                        clicked => {
                            root.navigate(10, a.id);
                        }
                    }
                }
                HorizontalLayout {
                    padding-top: 14px;
                    alignment: start;
                    if Home.tab != 2: MoreLink {
                        text: "专辑详情";
                        clicked => {
                            Home.action("open-album", Home.pane.album-id);
                        }
                    }
                    if Home.tab == 2 && Home.series.is-series: MoreLink {
                        text: "查看系列";
                        clicked => {
                            Home.action("open-series", 0);
                        }
                    }
                }
            }
        }
    }
}

// Card grid ids of the home page (see app.slint `card-action`).
export global HomeGrids {
    out property <int> works: 10;
    out property <int> recent-albums: 11;
    out property <int> chronicle: 12;
    out property <int> playlists: 13;
}

export component HomePage inherits Flickable {
    in property <[PlaylistChoice]> playlists;
    in property <int> playing-id: -1;
    in property <int> playing-mix: -1;
    callback card-action(int, string, int, int);
    callback card-layout(int, int, length);
    callback card-limit(int, int);
    callback track-action(int, string, int, int);
    callback navigate(int, int);
    callback open-web(string);
    content-height: page.preferred-height;

    // Window breakpoints (`Shell`), and the page width for the columns.
    property <int> tier: Shell.tier;
    property <length> pad: Shell.pad;
    property <length> content-w: root.width - 2 * root.pad;
    property <bool> tiny: root.width <= 700px;
    // Spotlight: cover 340 / 252 / 220; the preview needs room beside the title.
    property <length> hero-art: root.tier == 2 ? 340px : root.tier == 1 ? 252px : 220px;
    property <bool> hero-wide: root.tier == 2 && root.content-w >= root.hero-art + 520px + 88px + 380px;
    changed hero-art => {
        hero-timer.restart();
    }
    // Reload the art once the resize settles.
    hero-timer := Timer {
        interval: 200ms;
        running: false;
        triggered => {
            self.running = false;
            if Home.hero-art != root.hero-art {
                Home.hero-art = root.hero-art;
                Home.action("hero-art", 0);
            }
        }
    }
    init => {
        if Home.hero-art != root.hero-art {
            Home.hero-art = root.hero-art;
            Home.action("hero-art", 0);
        }
    }
    // Two columns: 今日推荐 / 最近播放 (at most 760) and 最近添加 (852 / 520
    // / 452); one column when the left would be narrower than 380.
    property <length> duo-gap: root.tier == 2 ? 56px : root.tier == 1 ? 36px : 28px;
    property <length> side-base: root.tier == 2 ? 852px : root.tier == 1 ? 520px : 452px;
    property <bool> stack: root.content-w - root.duo-gap - root.side-base < 380px;
    property <length> duo-side-w: root.stack ? root.content-w : root.tier == 2 ? max(root.side-base, root.content-w - root.duo-gap - 760px) : root.side-base;
    property <length> duo-main-w: root.stack ? root.content-w : root.content-w - root.duo-gap - root.duo-side-w;
    property <length> recent-gap: root.tier == 0 ? 16px : 17px;
    // 最近添加: 4 columns of 200 (more when the page is wider), 3 otherwise;
    // one row of up to 6 when the columns stack.
    property <int> recent-cols: root.stack ? max(3, min(6, floor((root.content-w + 16px) / 156px))) : root.tier == 2 ? max(4, floor((root.duo-side-w + 17px) / 217px)) : 3;
    property <int> recent-max: root.stack && !root.tiny ? root.recent-cols : root.recent-cols * 2;
    // 按作品漫游: cards of at least 280 (five at 2300), posters 128 / 104.
    property <int> work-cols: max(2, min(5, floor((root.content-w + 20px) / 300px)));
    property <length> work-w: floor((root.content-w - (root.work-cols - 1) * 20px) / root.work-cols / 1px) * 1px;
    property <length> work-art: root.work-w >= 290px ? 128px : 104px;
    // 接着听 cards: four per row when they are at least 250 wide.
    property <int> resume-cols: max(1, min(4, floor((root.content-w + 20px) / 270px)));
    property <length> resume-w: (root.content-w - (root.resume-cols - 1) * 20px) / root.resume-cols;
    // Shelf cards: clamp(150px, 10.5cqi, 232px), whole physical pixels.
    property <length> shelf-card: floor(clamp(root.width * 0.105, 150px, 232px) / 1phx) * 1phx;
    property <length> section-gap: root.tier == 2 ? 52px : 40px;

    page := VerticalLayout {
        width: root.width;
        padding-bottom: 48px;
        spacing: 0px;
        alignment: start;

        // No page title (Electron home starts with the spotlight).
        if Home.loading && !Home.unavailable: Text {
            x: root.pad;
            height: 80px;
            text: "加载中…";
            color: Theme.text-faint;
            vertical-alignment: center;
        }

        if Home.unavailable: VerticalLayout {
            padding-left: root.pad;
            padding-top: 40px;
            spacing: 12px;
            Text {
                text: "此服务端没有 032 主页接口";
                color: Theme.text;
                font-size: 16px;
            }
            Text {
                text: "升级 032 服务端后，这里会显示最近添加、作品和播放进度。";
                color: Theme.text-dim;
            }
            HorizontalLayout {
                alignment: start;
                GhostButton {
                    text: "浏览专辑";
                    clicked => {
                        root.navigate(0, 0);
                    }
                }
            }
        }

        // First run: the library is empty.
        if !Home.loading && Home.empty: VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 40px;
            spacing: 12px;
            Text {
                text: "曲库还是空的";
                color: Theme.text;
                font-size: 26px;
                font-weight: 780;
            }
            Text {
                text: "在控制台确认音乐目录并运行一次扫描。扫描只读取文件和标签，不会改写、移动或删除源文件；完成后，这里会出现最近添加、作品和你的播放进度。";
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                PrimaryButton {
                    text: "前往控制台扫描";
                    clicked => {
                        root.open-web("/admin");
                    }
                }
                GhostButton {
                    height: 40px;
                    text: "配置数据来源";
                    clicked => {
                        root.open-web("/admin/settings/metadata");
                    }
                }
            }
            for f in [
                { label: "支持格式", value: "FLAC · MP3 · M4A/AAC · Ogg · Opus" },
                { label: "歌词", value: "读取同名 .lrc 与内嵌歌词" },
                { label: "在线增强", value: "MusicBrainz · Last.fm · Bangumi，可选、需人工审核" },
            ]: HorizontalLayout {
                spacing: 12px;
                Text {
                    text: f.label;
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    width: 80px;
                    font-size: 13px;
                }
                Text {
                    text: f.value;
                    font-family: Fonts.family(self.text);
                    color: Theme.text-dim;
                    font-size: 13px;
                }
            }
        }

        if !Home.loading && !Home.empty && !Home.unavailable: VerticalLayout {
            spacing: 0px;

            if Home.tab-labels.length > 0: Spotlight {
                playing-id: root.playing-id;
                wide: root.hero-wide;
                art: root.hero-art;
                pad-x: root.pad;
                pad-y: root.tier == 2 ? 44px : 36px;
                gap: root.tier == 2 ? 44px : root.tier == 1 ? 32px : 28px;
                title-size: root.tier == 2 ? Theme.font-hero : root.tier == 1 ? 52px : 44px;
                track-action(list, what, i, arg) => {
                    root.track-action(list, what, i, arg);
                }
                navigate(page, id) => {
                    root.navigate(page, id);
                }
            }

            // Daily mixes (or 最近播放 first) next to 最近添加; one column
            // when narrow.
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: root.tier == 2 ? 44px : root.tier == 1 ? 32px : 26px;
                duo := Rectangle {
                    height: root.stack ? main.preferred-height + (Home.recent-albums.length > 0 ? root.duo-gap + side.preferred-height : 0px) : max(main.preferred-height, side.preferred-height);
                    main := VerticalLayout {
                        x: 0;
                        y: 0;
                        width: root.duo-main-w;
                        height: self.preferred-height;
                        spacing: 0px;
                        alignment: start;
                        if Home.mixes.length > 0 || Home.mixes-generating: SectionHead {
                            title: "今日推荐";
                            count: "每日 6:00 更新";
                        }
                        if Home.mixes.length > 0 || Home.mixes-generating: Rectangle {
                            height: 10px;
                        }
                        if Home.mixes.length == 0 && Home.mixes-generating: VerticalLayout {
                            padding-bottom: 12px;
                            Text {
                                text: "正在生成今天的推荐";
                                color: Theme.text;
                            }
                            Text {
                                text: "稍等片刻，生成好后会自动出现。";
                                color: Theme.text-faint;
                                font-size: 13px;
                            }
                        }
                        for m in Home.mixes: HomeRowView {
                            item: m;
                            mix: true;
                            playing: m.id == root.playing-mix;
                            action(what, arg) => {
                                Home.action(what == "play" ? "mix-play" : "mix-open", m.id);
                            }
                        }
                        if Home.mixes.length > 0 || Home.mixes-generating: Rectangle {
                            height: 40px;
                        }
                        SectionHead {
                            title: "最近播放";
                            MoreLink {
                                y: (parent.height - self.height) / 2;
                                text: "播放记录";
                                clicked => {
                                    root.navigate(23, 0);
                                }
                            }
                        }
                        Rectangle {
                            height: 10px;
                        }
                        if Home.recent.length == 0: VerticalLayout {
                            Text {
                                text: "还没有播放记录";
                                color: Theme.text;
                            }
                            Text {
                                text: "播放过的歌曲会出现在这里。";
                                color: Theme.text-faint;
                                font-size: 13px;
                            }
                        }
                        for r in Home.recent: HomeRowView {
                            item: r;
                            playing: r.id == root.playing-id;
                            hide-note: root.duo-main-w < 480px;
                            playlists: root.playlists;
                            action(what, arg) => {
                                root.track-action(8, what, r.index, arg);
                            }
                        }
                    }
                    side := VerticalLayout {
                        x: root.stack ? 0 : root.duo-main-w + root.duo-gap;
                        y: root.stack ? main.preferred-height + root.duo-gap : 0;
                        width: root.duo-side-w;
                        height: self.preferred-height;
                        visible: Home.recent-albums.length > 0;
                        spacing: 0px;
                        alignment: start;
                        SectionHead {
                            title: "最近添加";
                            MoreLink {
                                y: (parent.height - self.height) / 2;
                                text: "查看全部";
                                clicked => {
                                    root.navigate(0, 0);
                                }
                            }
                        }
                        Rectangle {
                            height: 18px;
                        }
                        CardRows {
                            width: root.duo-side-w;
                            rows: Home.recent-albums;
                            kind: 0;
                            side: 0px;
                            gap: root.recent-gap;
                            row-gap: root.tier == 2 ? 28px : root.tier == 1 ? 22px : 16px;
                            fixed-columns: root.recent-cols;
                            max-items: root.recent-max;
                            playlists: root.playlists;
                            layout-changed(n, size) => {
                                root.card-layout(HomeGrids.recent-albums, n, size);
                            }
                            limit-changed(n) => {
                                root.card-limit(HomeGrids.recent-albums, n);
                            }
                            action(what, id, arg) => {
                                root.card-action(HomeGrids.recent-albums, what, id, arg);
                            }
                        }
                    }
                }
            }

            // 接着听 (shown when there are no daily mixes, as before): cards.
            if Home.mixes.length == 0 && !Home.mixes-generating && Home.resume.length > 0: VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: root.section-gap;
                spacing: 18px;
                SectionHead {
                    title: "接着听";
                    count: Home.resume.length + " 首未听完";
                }
                resume-grid := Rectangle {
                    height: ceil(Home.resume.length / root.resume-cols) * 128px - 20px;
                    for r[i] in Home.resume: HomeRowView {
                        x: mod(i, root.resume-cols) * (root.resume-w + 20px);
                        y: floor(i / root.resume-cols) * 128px;
                        width: root.resume-w;
                        item: r;
                        card: true;
                        playing: r.id == root.playing-id;
                        playlists: root.playlists;
                        action(what, arg) => {
                            root.track-action(7, what, r.index, arg);
                        }
                    }
                }
            }

            if Home.works-count > 0: VerticalLayout {
                padding-top: root.section-gap;
                spacing: 18px;
                HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    SectionHead {
                        title: "按作品漫游";
                        count: Home.works-count + " 部作品";
                        HorizontalLayout {
                            spacing: 4px;
                            for label[i] in ["全部", "动画", "游戏", "电影"]: SegItem {
                                text: label;
                                selected: Home.works-type == i;
                                clicked => {
                                    Home.action("works-type", i);
                                }
                            }
                        }
                        if Home.works-pages > 1: MoreLink {
                            y: (parent.height - self.height) / 2;
                            text: "换一批";
                            clicked => {
                                Home.action("works-next", 0);
                            }
                        }
                    }
                }
                if Home.works.length == 0: Text {
                    x: root.pad;
                    text: "这个类型下还没有关联歌曲的作品";
                    color: Theme.text-faint;
                }
                CardShelf {
                    rows: Home.works;
                    kind: 5;
                    size: root.work-art;
                    card-w: root.work-w;
                    side: root.pad;
                    playlists: root.playlists;
                    layout-changed(size) => {
                        root.card-layout(HomeGrids.works, 1000, size);
                    }
                    action(what, id, arg) => {
                        root.card-action(HomeGrids.works, what, id, arg);
                    }
                }
            }

            if Home.songs-count > 0: VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: root.section-gap;
                spacing: 10px;
                SectionHead {
                    title: "主题曲与插曲";
                    count: "来自作品关联的歌曲角色 · 每日轮换";
                    if Home.songs-pages > 1: MoreLink {
                        y: (parent.height - self.height) / 2;
                        text: "换一批";
                        clicked => {
                            Home.action("songs-next", 0);
                        }
                    }
                    MoreLink {
                        y: (parent.height - self.height) / 2;
                        text: "歌曲";
                        clicked => {
                            root.navigate(1, 0);
                        }
                    }
                }
                // Two columns (row-major) when wide.
                songs := Rectangle {
                    property <int> cols: root.content-w >= 1200px ? 2 : 1;
                    property <length> col-gap: 56px;
                    property <length> col-w: (self.width - (self.cols - 1) * self.col-gap) / self.cols;
                    height: ceil(Home.songs.length / self.cols) * 68px;
                    for r[i] in Home.songs: HomeRowView {
                        x: mod(i, songs.cols) * (songs.col-w + songs.col-gap);
                        y: floor(i / songs.cols) * 68px;
                        width: songs.col-w;
                        item: r;
                        playing: r.id == root.playing-id;
                        show-add: true;
                        hide-link: songs.col-w < 620px;
                        playlists: root.playlists;
                        action(what, arg) => {
                            if what == "link" {
                                root.navigate(13, arg);
                            } else {
                                root.track-action(9, what, r.index, arg);
                            }
                        }
                    }
                }
            }

            if Home.years.length > 0: VerticalLayout {
                padding-top: root.section-gap;
                spacing: 18px;
                HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    SectionHead {
                        title: "编年";
                        count: "按发行年份 · 点击柱子查看那一年";
                    }
                }
                // Year chart: the bars share the whole width, 120px high over
                // a baseline, the count above the hovered / selected bar;
                // axis labels every five years (ten when narrow).
                Rectangle {
                    height: 120px + 26px + 8px;
                    chart := Rectangle {
                        x: root.pad;
                        y: 26px;
                        width: parent.width - 2 * root.pad;
                        height: 120px + 22px;
                        property <int> n: max(1, Home.years.length);
                        property <length> gap: self.width / self.n >= 24px ? 8px : self.width / self.n >= 12px ? 4px : 2px;
                        property <length> pitch: (self.width + self.gap) / self.n;
                        property <int> step: self.pitch * 5 >= 40px ? 5 : 10;
                        property <length> plot: 120px;
                        Rectangle {
                            y: chart.plot;
                            height: 1px;
                            background: Theme.border;
                        }
                        for bar[i] in Home.years: Rectangle {
                            x: i * chart.pitch;
                            y: 0;
                            width: chart.pitch - chart.gap;
                            height: chart.plot;
                            property <length> h: max(4px, chart.plot * max(3, bar.height) / 100);
                            bar-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    Home.action("year", bar.year);
                                }
                            }
                            Rectangle {
                                y: parent.height - parent.h;
                                height: parent.h;
                                border-top-left-radius: 3px;
                                border-top-right-radius: 3px;
                                background: bar.year == Home.year ? Theme.accent : bar-area.has-hover ? Theme.text-faint.with-alpha(0.55) : Theme.bar;
                                animate background { duration: 140ms; }
                            }
                            if bar-area.has-hover || bar.year == Home.year: Text {
                                x: (parent.width - self.width) / 2;
                                y: parent.height - parent.h - 20px;
                                width: 48px;
                                height: 16px;
                                text: bar.count;
                                font-family: Fonts.family(self.text);
                                color: bar.year == Home.year ? Theme.accent-text : Theme.text-dim;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                        }
                        for bar[i] in Home.years: Text {
                            visible: bar.year == Home.year || mod(bar.year, chart.step) == 0;
                            x: i * chart.pitch + (chart.pitch - chart.gap - self.width) / 2;
                            y: chart.plot + 8px;
                            width: 40px;
                            height: 16px;
                            text: bar.year;
                            font-family: Fonts.family(self.text);
                            color: bar.year == Home.year ? Theme.accent-text : Theme.text-faint;
                            font-size: 12px;
                            font-weight: bar.year == Home.year ? 700 : 500;
                            horizontal-alignment: center;
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    padding-top: 22px;
                    SectionHead {
                        title: Home.year + " 年";
                        count: Home.year-total + " 张专辑";
                        MoreLink {
                            y: (parent.height - self.height) / 2;
                            text: "查看全部";
                            clicked => {
                                Home.action("year-all", Home.year);
                            }
                        }
                    }
                }
                if Home.chronicle.length == 0: Text {
                    x: root.pad;
                    text: Home.year + " 年没有专辑";
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                }
                CardShelf {
                    rows: Home.chronicle;
                    kind: 0;
                    size: root.shelf-card;
                    side: root.pad;
                    playlists: root.playlists;
                    layout-changed(size) => {
                        root.card-layout(HomeGrids.chronicle, 1000, size);
                    }
                    action(what, id, arg) => {
                        root.card-action(HomeGrids.chronicle, what, id, arg);
                    }
                }
            }

            if Home.playlists.length > 0: VerticalLayout {
                padding-top: root.section-gap - 18px;
                spacing: 18px;
                HorizontalLayout {
                    padding-left: root.pad;
                    padding-right: root.pad;
                    SectionHead {
                        title: "歌单";
                        MoreLink {
                            y: (parent.height - self.height) / 2;
                            text: "全部歌单";
                            clicked => {
                                root.navigate(4, 0);
                            }
                        }
                    }
                }
                CardShelf {
                    rows: Home.playlists;
                    kind: 2;
                    size: root.shelf-card;
                    side: root.pad;
                    layout-changed(size) => {
                        root.card-layout(HomeGrids.playlists, 1000, size);
                    }
                    action(what, id, arg) => {
                        root.card-action(HomeGrids.playlists, what, id, arg);
                    }
                }
            }

            // Footer statistics.
            HorizontalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                padding-top: 24px;
                spacing: 16px;
                alignment: start;
                Text {
                    text: Home.stats.albums + " 张专辑 · " + Home.stats.tracks + " 首歌曲 · " + Home.stats.works + " 部作品";
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                if Home.stats.last-scan != "": Text {
                    text: Home.stats.last-scan;
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: 13px;
                    vertical-alignment: center;
                }
                LinkText {
                    text: "作品关联待审核" + (Home.stats.pending > 0 ? "（" + Home.stats.pending + "）" : "");
                    clicked => {
                        root.open-web("/admin/work-review");
                    }
                }
            }
        }
    }
}

// Virtualized poster / card grid with an empty hint.
component CardGridPoster inherits Rectangle {
    in property <[AlbumRow]> rows;
    in property <int> kind;
    in property <[PlaylistChoice]> playlists;
    in property <string> empty-text;
    in property <string> empty-hint;
    in property <bool> loading;
    callback layout-changed(int, length);
    callback action(string, int, int);
    property <length> pad: Shell.pad;
    property <length> gap: Shell.tier == 2 ? 26px : 22px;
    property <length> row-gap: Shell.tier == 2 ? 36px : 28px;
    out property <int> columns: max(1, floor((self.width - 2 * root.pad + root.gap) / (160px + root.gap)));
    // Whole physical pixels, so covers decoded at this size draw 1:1.
    out property <length> card-size: floor(((self.width - 2 * root.pad - (root.columns - 1) * root.gap) / root.columns) / 1phx) * 1phx;
    changed card-size => {
        root.layout-changed(root.columns, root.card-size);
    }
    init => {
        root.layout-changed(root.columns, root.card-size);
    }

    if root.rows.length == 0: VerticalLayout {
        alignment: center;
        spacing: 6px;
        Text {
            text: root.loading ? "加载中…" : root.empty-text;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            horizontal-alignment: center;
        }
        if !root.loading && root.empty-hint != "": Text {
            text: root.empty-hint;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }

    ListView {
        for row in root.rows: HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: root.gap;
            alignment: start;
            height: (root.kind == 3 || root.kind == 4 ? root.card-size * 1.5 : root.card-size) + 91px + root.row-gap;
            for card in row.items: CardView {
                card: card;
                kind: root.kind;
                size: root.card-size;
                playlists: root.playlists;
                action(what, arg) => {
                    root.action(what, card.id, arg);
                }
            }
        }
    }
}

// Works page: search, type and sort, a poster grid (grid 8).
export component WorksPage inherits VerticalLayout {
    in property <[PlaylistChoice]> playlists;
    callback card-action(string, int, int);
    callback card-layout(int, length);
    property <string> search;
    property <int> kind;
    property <int> sort;
    function commit() {
        Lib032.query-works(root.search, root.kind, root.sort);
    }

    debounce := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            root.commit();
        }
    }

    PageHeader {
        title: "作品";
        count: Lib032.works-total > 0 ? Lib032.works-total + " 个作品" : "";
        HorizontalLayout {
            spacing: 10px;
            alignment: start;
            height: 40px;
            SearchField {
                width: 300px;
                height: 40px;
                placeholder: "原文、译名、假名或罗马音…";
                text <=> root.search;
                edited => {
                    debounce.restart();
                }
                accepted => {
                    debounce.running = false;
                    root.commit();
                }
            }
            ComboBox {
                width: 150px;
                height: 40px;
                model: Lib032.work-types;
                current-index: root.kind;
                selected => {
                    root.kind = self.current-index;
                    root.commit();
                }
            }
            for label[i] in ["标题", "年份", "最近更新"]: Tab {
                y: 3px;
                text: label;
                selected: root.sort == i;
                clicked => {
                    root.sort = i;
                    root.commit();
                }
            }
        }
    }

    CardGridPoster {
        vertical-stretch: 1;
        rows: Lib032.works;
        kind: 3;
        loading: Lib032.works-loading;
        empty-text: root.search == "" ? "没有找到作品" : "没有找到作品";
        empty-hint: "扫描含 OP/ED/OST 标签的音乐，或在网页端新建作品。";
        playlists: root.playlists;
        layout-changed(n, size) => {
            root.card-layout(n, size);
        }
        action(what, id, arg) => {
            root.card-action(what, id, arg);
        }
    }
}

// Series page: search and a poster grid (grid 9).
export component SeriesPage inherits VerticalLayout {
    callback card-action(string, int, int);
    callback card-layout(int, length);
    property <string> search;

    debounce := Timer {
        interval: 300ms;
        running: false;
        triggered => {
            self.running = false;
            Lib032.query-series(root.search);
        }
    }

    PageHeader {
        title: "系列";
        count: Lib032.series-total > 0 ? Lib032.series-total + " 个系列" : "";
        if Lib032.series-supported: HorizontalLayout {
            alignment: start;
            height: 40px;
            SearchField {
                width: 300px;
                height: 40px;
                placeholder: "系列名或成员名…";
                text <=> root.search;
                edited => {
                    debounce.restart();
                }
                accepted => {
                    debounce.running = false;
                    Lib032.query-series(root.search);
                }
            }
        }
    }

    if !Lib032.series-supported: VerticalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: "此服务端暂不支持系列接口";
            color: Theme.text;
            horizontal-alignment: center;
        }
        Text {
            text: "升级 032 服务端，或在网页中管理系列。";
            color: Theme.text-faint;
            font-size: 13px;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            GhostButton {
                text: "在网页中打开";
                clicked => {
                    Lib032.open-web("/admin/series");
                }
            }
        }
    }

    if Lib032.series-supported: CardGridPoster {
        vertical-stretch: 1;
        rows: Lib032.series;
        kind: 4;
        loading: Lib032.series-loading;
        empty-text: "没有找到系列";
        empty-hint: "自动归组或在网页端手动新建后，系列会出现在这里。";
        layout-changed(n, size) => {
            root.card-layout(n, size);
        }
        action(what, id, arg) => {
            root.card-action(what, id, arg);
        }
    }
}

// Playback history (track list 10).
export component HistoryPage inherits VerticalLayout {
    in property <int> playing-id;
    in property <[PlaylistChoice]> playlists;
    callback track-action(string, int, int);
    callback clear();

    PageHeader {
        title: "播放记录";
        count: Lib032.history-total > 0 ? Lib032.history-total + " 首有播放记录的歌曲" : "";
        HorizontalLayout {
            height: 40px;
            Rectangle {
                horizontal-stretch: 1;
            }
            if Lib032.history-total > 0: GhostButton {
                height: 40px;
                text: "清空播放历史";
                clicked => {
                    root.clear();
                }
            }
        }
    }

    TrackList {
        vertical-stretch: 1;
        rows: Lib032.history;
        mode: 3;
        loading: Lib032.history-loading;
        empty-text: "还没有播放记录";
        playing-id: root.playing-id;
        playlists: root.playlists;
        action(what, i, arg) => {
            root.track-action(what, i, arg);
        }
    }
}

component DetailHero inherits HorizontalLayout {
    in property <image> poster;
    in property <length> poster-w: 160px;
    in property <length> poster-h: 240px;
    padding-left: Shell.pad;
    padding-right: Shell.pad;
    padding-top: 48px;
    spacing: 24px;
    Cover {
        width: root.poster-w;
        height: root.poster-h;
        source: root.poster;
        placeholder: "作";
    }
    VerticalLayout {
        alignment: end;
        spacing: 6px;
        horizontal-stretch: 1;
        @children
    }
}

// Work page: hero, series banner, linked albums (grid 14) and tracks
// collected on other albums (track list 2).
export component WorkPage inherits Flickable {
    in property <[TrackRow]> tracks;
    in property <bool> loading;
    in property <int> playing-id;
    in property <[PlaylistChoice]> playlists;
    callback card-action(string, int, int);
    callback card-layout(int, length);
    callback track-action(string, int, int);
    callback navigate(int, int);
    property <length> flex: max(0px, self.width - 2 * Shell.pad - 44px - 40px - 64px - 80px);
    content-height: page.preferred-height;

    page := VerticalLayout {
        width: root.width;
        alignment: start;
        spacing: 16px;
        padding-bottom: 32px;

        DetailHero {
            poster: Lib032.work-poster;
            Text {
                text: "作品";
                color: Theme.text-dim;
                font-size: 13px;
            }
            Text {
                text: root.loading && Lib032.work.title == "" ? "加载中…" : Lib032.work.title;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: 28px;
                font-weight: 700;
                wrap: word-wrap;
            }
            if Lib032.work.translated != "": Text {
                text: Lib032.work.translated;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: 16px;
            }
            if Lib032.work.reading != "": Text {
                text: Lib032.work.reading;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 13px;
            }
            Text {
                text: Lib032.work.facts;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 13px;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-top: 6px;
                PrimaryButton {
                    text: "播放全部";
                    width: 96px;
                    height: 32px;
                    clicked => {
                        Lib032.detail-action("play", 0);
                    }
                }
                GhostButton {
                    text: "加入队列";
                    clicked => {
                        Lib032.detail-action("last", 0);
                    }
                }
                GhostButton {
                    text: "在网页中打开";
                    clicked => {
                        Lib032.detail-action("web", 0);
                    }
                }
                if Lib032.work.bangumi-url != "": GhostButton {
                    text: "在 Bangumi 查看 ↗";
                    clicked => {
                        Lib032.detail-action("bangumi", 0);
                    }
                }
            }
        }

        if Lib032.work.series-id > 0: HorizontalLayout {
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            Rectangle {
                height: 52px;
                border-radius: 10px;
                background: banner-area.has-hover ? Theme.surface-hover : Theme.surface;
                banner-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.navigate(14, Lib032.work.series-id);
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: "所属系列";
                            accent: true;
                        }
                    }
                    Text {
                        text: Lib032.work.series-title;
                        font-family: Fonts.family(self.text);
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: Lib032.work.series-meta;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-dim;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "›";
                        color: Theme.text-faint;
                        font-size: 18px;
                        vertical-alignment: center;
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            SectionHead {
                title: "关联专辑";
                count: Lib032.work.album-count + " 张整张关联专辑";
            }
        }
        if !root.loading && Lib032.work-albums.length == 0: Text {
            x: Shell.pad;
            text: "尚无关联专辑";
            color: Theme.text-faint;
        }
        CardRows {
            width: root.width;
            rows: Lib032.work-albums;
            kind: 0;
            playlists: root.playlists;
            layout-changed(n, size) => {
                root.card-layout(n, size);
            }
            action(what, id, arg) => {
                root.card-action(what, id, arg);
            }
        }

        VerticalLayout {
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            spacing: 2px;
            SectionHead {
                title: "收录于精选集 / 原创专辑";
                count: Lib032.work.collected + " 首曲目";
            }
            Text {
                text: "曲目级关联、但专辑本身未整张关联本作品的曲目：";
                color: Theme.text-faint;
                font-size: 13px;
            }
        }
        if !root.loading && root.tracks.length == 0: Text {
            x: Shell.pad;
            text: "还没有独立收录曲目";
            color: Theme.text-faint;
        }
        for track in root.tracks: TrackRowView {
            track: track;
            mode: 0;
            playing: track.id == root.playing-id;
            playlists: root.playlists;
            title-w: root.flex * 0.42;
            artist-w: root.flex * 0.24;
            album-w: root.flex * 0.34;
            action(what, arg) => {
                root.track-action(what, track.index, arg);
            }
        }
    }
}

// Series page: hero, members (grid 15) and albums (grid 16).
export component SeriesDetailPage inherits Flickable {
    in property <bool> loading;
    in property <[PlaylistChoice]> playlists;
    callback card-action(int, string, int, int);
    callback card-layout(int, int, length);
    content-height: page.preferred-height;

    page := VerticalLayout {
        width: root.width;
        alignment: start;
        spacing: 16px;
        padding-bottom: 32px;

        DetailHero {
            poster: Lib032.series-poster;
            Text {
                text: "系列";
                color: Theme.text-dim;
                font-size: 13px;
            }
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                if Lib032.series-info.playing: PlayingBars {
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.loading && Lib032.series-info.title == "" ? "加载中…" : Lib032.series-info.title;
                    font-family: Fonts.family(self.text);
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 700;
                    overflow: elide;
                }
                if Lib032.series-info.renamed: VerticalLayout {
                    alignment: center;
                    Pill {
                        text: "已改名";
                    }
                }
            }
            Text {
                text: Lib032.series-info.facts;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 13px;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-top: 6px;
                PrimaryButton {
                    text: "播放全部";
                    width: 96px;
                    height: 32px;
                    clicked => {
                        Lib032.detail-action("play", 0);
                    }
                }
                GhostButton {
                    text: "加入队列";
                    clicked => {
                        Lib032.detail-action("last", 0);
                    }
                }
                GhostButton {
                    text: "在网页中打开";
                    clicked => {
                        Lib032.detail-action("web", 0);
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            SectionHead {
                title: "系列成员";
                count: Lib032.series-info.member-count + " 部作品";
            }
        }
        if !root.loading && Lib032.series-members.length == 0: Text {
            x: Shell.pad;
            text: "没有找到系列";
            color: Theme.text-faint;
        }
        CardRows {
            width: root.width;
            rows: Lib032.series-members;
            kind: 3;
            playlists: root.playlists;
            layout-changed(n, size) => {
                root.card-layout(15, n, size);
            }
            action(what, id, arg) => {
                root.card-action(15, what, id, arg);
            }
        }

        HorizontalLayout {
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            SectionHead {
                title: "系列专辑";
                count: Lib032.series-info.album-count + " 张专辑";
            }
        }
        if !root.loading && Lib032.series-albums.length == 0: Text {
            x: Shell.pad;
            text: "尚无关联专辑";
            color: Theme.text-faint;
        }
        CardRows {
            width: root.width;
            rows: Lib032.series-albums;
            kind: 0;
            playlists: root.playlists;
            layout-changed(n, size) => {
                root.card-layout(16, n, size);
            }
            action(what, id, arg) => {
                root.card-action(16, what, id, arg);
            }
        }
    }
}

// Daily mix page: hero, tracks (track list 2, mode 4) and the feedback
// column (rating, 换一个, 另存为歌单, today's other mixes).
export component MixPage inherits VerticalLayout {
    in property <[TrackRow]> tracks;
    in property <bool> loading;
    in property <int> playing-id;
    in property <int> playing-mix: -1;
    in property <[PlaylistChoice]> playlists;
    callback track-action(string, int, int);
    callback open-mix(int);
    callback play-mix(int);
    property <bool> reasons-open;
    property <image> no-image;

    HorizontalLayout {
        vertical-stretch: 0;
        padding-left: Shell.pad;
        padding-right: Shell.pad;
        padding-top: 48px;
        padding-bottom: 16px;
        spacing: 24px;
        Rectangle {
            width: 180px;
            height: 180px;
            border-radius: Theme.radius;
            background: Theme.raised;
            clip: true;
            if Lib032.mix-covers.length < 4: Cover {
                source: Lib032.mix-covers.length > 0 ? Lib032.mix-covers[0] : root.no-image;
                placeholder: "♪";
            }
            if Lib032.mix-covers.length >= 4: Rectangle {
                for img[i] in Lib032.mix-covers: Image {
                    x: mod(i, 2) * 90px;
                    y: floor(i / 2) * 90px;
                    width: 90px;
                    height: 90px;
                    source: img;
                    image-fit: ImageFit.cover;
                }
            }
        }
        VerticalLayout {
            alignment: end;
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: Lib032.mix.kicker;
                font-family: Fonts.family(self.text);
                color: Theme.accent;
                font-size: 13px;
            }
            Text {
                text: root.loading && Lib032.mix.title == "" ? "加载中…" : Lib032.mix.title;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: 28px;
                font-weight: 700;
                overflow: elide;
            }
            if Lib032.mix.description != "": Text {
                text: Lib032.mix.description;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
                max-height: 36px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for tag in Lib032.mix-tags: Pill {
                    text: tag.label;
                    accent: tag.style;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-top: 6px;
                PrimaryButton {
                    text: "播放全部";
                    width: 96px;
                    height: 32px;
                    clicked => {
                        Lib032.detail-action("play", 0);
                    }
                }
                GhostButton {
                    text: "随机播放";
                    has-icon: true;
                    icon: IconKind.shuffle;
                    clicked => {
                        Lib032.detail-action("shuffle", 0);
                    }
                }
                GhostButton {
                    text: "加入播放队列";
                    clicked => {
                        Lib032.detail-action("last", 0);
                    }
                }
            }
            Text {
                text: Lib032.mix.subtitle;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 13px;
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 0px;
        TrackList {
            width: root.width - 280px;
            rows: root.tracks;
            mode: 4;
            loading: root.loading;
            playing-id: root.playing-id;
            playlists: root.playlists;
            action(what, i, arg) => {
                root.track-action(what, i, arg);
            }
        }
        Flickable {
            width: 280px;
            content-height: aside.preferred-height;
            aside := VerticalLayout {
                width: parent.width;
                padding-right: 24px;
                spacing: 16px;
                alignment: start;
                Rectangle {
                    border-radius: 10px;
                    background: Theme.surface;
                    height: feedback.preferred-height;
                    feedback := VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "这个歌单怎么样？";
                            color: Theme.text;
                            font-weight: 600;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            GhostButton {
                                text: "喜欢";
                                active: Lib032.mix.rating == 1;
                                clicked => {
                                    Lib032.detail-action(Lib032.mix.rating == 1 ? "undo" : "like", 0);
                                }
                            }
                            GhostButton {
                                text: Lib032.mix.rating == -1 ? "不喜欢" : "不喜欢…";
                                active: Lib032.mix.rating == -1;
                                clicked => {
                                    if Lib032.mix.rating == -1 {
                                        Lib032.detail-action("undo", 0);
                                    } else {
                                        root.reasons-open = !root.reasons-open;
                                    }
                                }
                            }
                        }
                        if Lib032.mix.disliked-note != "": Text {
                            text: Lib032.mix.disliked-note;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-dim;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.reasons-open && Lib032.mix.rating != -1: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "哪里不满意？（可多选，也可不选）";
                                color: Theme.text-dim;
                                font-size: 13px;
                            }
                            for label[i] in ["太重复", "不喜欢这个主题", "歌不好听", "风格太跳", "歌和主题不符"]: CheckBox {
                                text: label;
                                checked: Lib032.mix-reasons[i];
                                toggled => {
                                    Lib032.mix-reasons[i] = self.checked;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                GhostButton {
                                    text: "提交";
                                    clicked => {
                                        root.reasons-open = false;
                                        Lib032.detail-action("dislike", 0);
                                    }
                                }
                            }
                        }
                        if Lib032.mix.current: VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: start;
                                GhostButton {
                                    text: "换一个";
                                    enabled: Lib032.mix.replacements-left > 0;
                                    clicked => {
                                        Lib032.detail-action("replace", 0);
                                    }
                                }
                            }
                            Text {
                                text: Lib032.mix.replacements-left > 0 ? "今天还可以换 " + Lib032.mix.replacements-left + " 次" : "今天的次数已用完";
                                font-family: Fonts.family(self.text);
                                color: Theme.text-faint;
                                font-size: 12px;
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            GhostButton {
                                text: Lib032.mix.saved-playlist-id > 0 ? "再存一份为歌单" : "另存为歌单";
                                clicked => {
                                    Lib032.detail-action("save", 0);
                                }
                            }
                            if Lib032.mix.saved-playlist-id > 0: LinkText {
                                text: "查看已保存的歌单";
                                clicked => {
                                    Lib032.detail-action("saved", Lib032.mix.saved-playlist-id);
                                }
                            }
                        }
                        Text {
                            text: "“不再推荐”和评价从下一次生成开始生效。";
                            color: Theme.text-faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                if Lib032.mix-others.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "今天的其他推荐";
                        color: Theme.text;
                        font-weight: 600;
                    }
                    for m in Lib032.mix-others: HomeRowView {
                        item: m;
                        mix: true;
                        playing: m.id == root.playing-mix;
                        action(what, arg) => {
                            if what == "play" {
                                root.play-mix(m.id);
                            } else {
                                root.open-mix(m.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// Online lyrics search: results on the left, the selected one's lyrics on
// the right; 确定 uses it for this track on the server.
export component LyricsSearchDialog inherits Rectangle {
    callback close();
    background: #00000099;

    TouchArea { }

    debounce := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            LyricsSearch.search(LyricsSearch.name, LyricsSearch.artist);
        }
    }

    Rectangle {
        width: min(760px, root.width - 64px);
        height: min(560px, root.height - 64px);
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text {
                text: "搜索歌词";
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Field {
                    label: "歌曲名";
                    text <=> LyricsSearch.name;
                    edited => {
                        debounce.restart();
                    }
                    accepted => {
                        debounce.running = false;
                        LyricsSearch.search(LyricsSearch.name, LyricsSearch.artist);
                    }
                }
                Field {
                    label: "艺人";
                    text <=> LyricsSearch.artist;
                    edited => {
                        debounce.restart();
                    }
                    accepted => {
                        debounce.running = false;
                        LyricsSearch.search(LyricsSearch.name, LyricsSearch.artist);
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    if LyricsSearch.results.length == 0: Text {
                        text: LyricsSearch.searching ? "搜索中…" : "没有结果";
                        font-family: Fonts.family(self.text);
                        color: Theme.text-faint;
                    }
                    ListView {
                        for r[i] in LyricsSearch.results: Rectangle {
                            height: 62px;
                            border-radius: Theme.radius;
                            background: i == LyricsSearch.selected ? Theme.accent-dim : r-area.has-hover ? Theme.surface-hover : transparent;
                            r-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    LyricsSearch.selected = i;
                                    LyricsSearch.select(i);
                                }
                            }
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: r.title;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: r.artist;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: r.meta;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text-faint;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: r.score;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 280px;
                    border-radius: Theme.radius;
                    background: Theme.bg;
                    if LyricsSearch.preview.length == 0: Text {
                        text: LyricsSearch.selected < 0 ? "选择一条结果预览歌词" : "加载中…";
                        font-family: Fonts.family(self.text);
                        color: Theme.text-faint;
                        font-size: 13px;
                    }
                    ListView {
                        for line in LyricsSearch.preview: Text {
                            height: 24px;
                            text: line;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-dim;
                            font-size: 13px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Text {
                    text: "选中的歌词会保存到服务端，对所有设备生效。";
                    color: Theme.text-faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                GhostButton {
                    text: "取消";
                    clicked => {
                        root.close();
                    }
                }
                PrimaryButton {
                    text: "确定";
                    enabled: LyricsSearch.selected >= 0;
                    width: 96px;
                    height: 32px;
                    clicked => {
                        LyricsSearch.apply(LyricsSearch.selected);
                        root.close();
                    }
                }
            }
        }
    }
}
