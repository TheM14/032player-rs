import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { PlayingBars, Field, PrimaryButton, ValueBar, IconButton, IconKind, Icon, SearchField } from "controls.slint";

// `badge`: relation on an artist page; `artist-id` 0 = none. `note`: an
// extra line (track uses on a work page); `playing`: the current track
// belongs to it (works, series).
export struct AlbumCard {
    id: int,
    title: string,
    artist: string,
    year: string,
    cover: image,
    artist-id: int,
    favorite: bool,
    badge: string,
    note: string,
    // Muted last line ("入库于 3 天前").
    added: string,
    playing: bool,
}

export struct AlbumRow {
    items: [AlbumCard],
}

// A piece of a credits line: label / separator (id 0) or an artist link.
export struct CreditPart {
    text: string,
    id: int,
}

// `index`: row in its list; `number`: album track number ("1-03").
// `tag`: a label after the title (use on a work, history state, 新发现),
// `note`: replaces the album column (history), `disabled`: the file is
// missing, `blocked`: 不再推荐 (daily mixes).
export struct TrackRow {
    id: int,
    index: int,
    title: string,
    artist: string,
    album: string,
    duration: string,
    album-id: int,
    artist-id: int,
    favorite: bool,
    number: string,
    tag: string,
    tag-accent: bool,
    note: string,
    disabled: bool,
    blocked: bool,
    // Album pages: "作词 A · 作曲 B" under the title, and the work use
    // ("OP") with the number of linked works.
    credits: [CreditPart],
    tieup: string,
    tieup-count: int,
    tieup-tooltip: string,
}

// `translation`: shown under the line (bilingual).
export struct LyricLine {
    text: string,
    translation: string,
}

export struct QueueRow {
    uid: int,
    // Position in the queue (1-based; search keeps the queue numbers).
    number: int,
    title: string,
    artist: string,
    duration: string,
    cover: image,
}

export struct PlaylistChoice {
    id: int,
    name: string,
}

export component LoginView inherits Rectangle {
    in-out property <string> server;
    in-out property <string> api-token;
    in-out property <string> media-token;
    // A token is saved for the server: an empty field reuses it.
    in property <bool> api-token-saved;
    in property <bool> media-token-saved;
    in property <string> error;
    in property <bool> busy;
    callback login(string, string, string);
    background: Theme.bg;

    function submit() {
        if !root.busy {
            root.login(root.server, root.api-token, root.media-token);
        }
    }

    Rectangle {
        width: 420px;
        height: card.preferred-height;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        card := VerticalLayout {
            padding: 32px;
            spacing: 18px;

            Text {
                text: "连接 032 Music Server";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }

            Field {
                label: "服务器地址";
                placeholder: "https://music.example.com";
                text <=> root.server;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "API Token";
                placeholder: root.api-token-saved ? "已保存，留空即沿用" : "";
                password: true;
                text <=> root.api-token;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "媒体凭据";
                placeholder: root.media-token-saved ? "已保存，留空即沿用" : "";
                password: true;
                text <=> root.media-token;
                accepted => {
                    root.submit();
                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                wrap: word-wrap;
            }

            PrimaryButton {
                text: root.busy ? "连接中…" : "登录";
                enabled: !root.busy;
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

// Album / artist / playlist card. Clicking opens it; the round button plays.
export component CardView inherits Rectangle {
    in property <AlbumCard> card;
    // 0 album, 1 artist, 2 playlist, 3 work (2:3 poster), 4 series (poster).
    in property <int> kind;
    in property <length> size: 168px;
    in property <[PlaylistChoice]> playlists;
    // (action, argument): see `card-action` in app.slint.
    callback action(string, int);
    property <bool> poster: root.kind == 3 || root.kind == 4;
    property <length> art-h: root.poster ? root.size * 1.5 : root.size;
    // The pointer is on the round play button (bottom right of the cover).
    property <bool> over-play: area.has-hover && area.mouse-x >= root.size - 52px && area.mouse-x <= root.size - 12px
        && area.mouse-y >= root.art-h - 52px && area.mouse-y <= root.art-h - 12px;
    // The artist of an album card is a link (Electron `albumArtists` row).
    property <bool> artist-link: root.kind == 0 && root.card.artist-id > 0 && root.card.artist != "";
    width: root.size;
    height: root.art-h + 64px + (root.card.note != "" ? 18px : 0px) + (root.card.added != "" ? 18px : 0px);

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: root.size;
            height: root.art-h;
            border-radius: root.kind == 1 ? root.size / 2 : Theme.radius;
            background: Theme.raised;
            clip: true;

            if (root.kind == 1 || root.poster) && root.card.cover.width == 0: Text {
                text: root.poster ? "作" : root.card.title == "" ? "?" : "♪";
                color: Theme.text-faint;
                font-size: root.size / 3;
            }

            Image {
                source: root.card.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }

            Rectangle {
                background: area.has-hover ? #00000059 : transparent;
                animate background { duration: 120ms; }
            }

            if area.has-hover && root.kind != 4: Rectangle {
                x: parent.width - 52px;
                y: parent.height - 52px;
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: root.over-play ? Theme.accent.brighter(15%) : Theme.accent;
                Icon {
                    kind: IconKind.play;
                    width: 16px;
                    height: 16px;
                    color: #ffffff;
                }
            }

            if root.card.playing: Rectangle {
                // Electron `.card-badge`: dark pill, accent bars.
                x: parent.width - 30px;
                y: 8px;
                width: 22px;
                height: 22px;
                border-radius: 11px;
                background: Theme.bg.with-alpha(0.78);
                drop-shadow-blur: 8px;
                drop-shadow-color: #00000040;
                PlayingBars {
                    width: 11px;
                    height: 11px;
                }
            }

            if root.card.badge != "": Rectangle {
                x: 8px;
                y: 8px;
                width: badge-text.preferred-width + 12px;
                height: 20px;
                border-radius: 4px;
                background: #000000a0;
                badge-text := Text {
                    text: root.card.badge;
                    color: #ffffff;
                    font-size: 12px;
                }
            }
        }

        Text {
            text: root.card.title;
            color: Theme.text;
            font-weight: 600;
            overflow: elide;
            width: root.size;
            horizontal-alignment: root.kind == 1 ? center : left;
        }

        sub := HorizontalLayout {
            width: root.size;
            alignment: root.kind == 1 ? center : start;
            artist-text := Text {
                text: root.card.artist;
                visible: root.card.artist != "";
                color: artist-area.has-hover ? Theme.text : Theme.text-dim;
                font-size: 13px;
                overflow: elide;
                max-width: root.size - (year-text.visible ? year-text.preferred-width : 0px);
            }
            year-text := Text {
                visible: root.card.year != "";
                text: root.card.artist == "" ? root.card.year : " · " + root.card.year;
                color: Theme.text-dim;
                font-size: 13px;
            }
        }

        if root.card.note != "": Text {
            text: root.card.note;
            color: Theme.accent;
            font-size: 13px;
            overflow: elide;
            width: root.size;
        }

        if root.card.added != "": Text {
            text: root.card.added;
            color: Theme.text-faint;
            font-size: 13px;
            overflow: elide;
            width: root.size;
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.action("play", 0);
                }
            }
            MenuItem {
                title: "随机播放";
                activated => {
                    root.action("shuffle", 0);
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.action("next", 0);
                }
            }
            MenuItem {
                title: "添加到队列末尾";
                activated => {
                    root.action("last", 0);
                }
            }
            if root.kind != 2 && root.kind != 4: Menu {
                title: "添加到歌单";
                MenuItem {
                    title: "新建歌单…";
                    activated => {
                        root.action("new-playlist", 0);
                    }
                }
                for p in root.playlists: MenuItem {
                    title: p.name;
                    activated => {
                        root.action("add", p.id);
                    }
                }
            }
            if root.kind < 2: MenuItem {
                title: root.card.favorite ? "取消收藏" : "收藏";
                activated => {
                    root.action("favorite", root.card.favorite ? 0 : 1);
                }
            }
            if root.kind == 0 && root.card.artist-id > 0: MenuItem {
                title: "转到艺人";
                activated => {
                    root.action("artist", root.card.artist-id);
                }
            }
            if root.kind == 2: MenuItem {
                title: "删除歌单";
                activated => {
                    root.action("delete", 0);
                }
            }
        }

        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.action(root.over-play && root.kind != 4 ? "play" : "open", 0);
            }
        }
    }

    artist-area := TouchArea {
        x: sub.x + artist-text.x;
        y: sub.y + artist-text.y;
        width: root.artist-link ? artist-text.width : 0px;
        height: artist-text.height;
        mouse-cursor: pointer;
        clicked => {
            root.action("artist", root.card.artist-id);
        }
    }
}

// Virtualized grid of cards; the rows come from a Rust model that chunks
// the items by `columns` and loads covers for visible rows only.
export component CardGrid inherits Rectangle {
    in property <[AlbumRow]> rows;
    in property <int> kind;
    in property <[PlaylistChoice]> playlists;
    in property <string> empty-text: "没有内容";
    in property <bool> loading;
    // Columns and the card size (logical) whenever the layout changes.
    callback layout-changed(int, length);
    // (action, card id, argument)
    callback action(string, int, int);
    // Cards at least 160px with 24px gaps and 32px side padding; the
    // columns then share the width.
    out property <int> columns: max(1, floor((self.width - 64px + 24px) / 184px));
    // Whole physical pixels, so covers decoded at this size draw 1:1.
    out property <length> card-size: floor(((self.width - 64px - (root.columns - 1) * 24px) / root.columns) / 1phx) * 1phx;
    changed card-size => {
        root.layout-changed(root.columns, root.card-size);
    }
    init => {
        root.layout-changed(root.columns, root.card-size);
    }

    if root.rows.length == 0: Text {
        text: root.loading ? "加载中…" : root.empty-text;
        color: Theme.text-faint;
    }

    ListView {
        for row in root.rows: HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            spacing: 24px;
            alignment: start;
            height: (root.kind == 3 || root.kind == 4 ? root.card-size * 1.5 : root.card-size) + 86px;
            for card in row.items: CardView {
                card: card;
                kind: root.kind;
                size: root.card-size;
                playlists: root.playlists;
                action(what, arg) => {
                    root.action(what, card.id, arg);
                }
            }
        }
    }
}

// Column widths shared by the track header and rows.
export global TrackColumns {
    out property <length> number: 48px;
    out property <length> heart: 28px;
    out property <length> duration: 56px;
}

// One track row. `mode`: 0 list, 1 album (track numbers, no album
// column), 2 playlist (removable, draggable), 3 history (`note` instead
// of the album), 4 daily mix (不再推荐 button).
export component TrackRowView inherits Rectangle {
    in property <TrackRow> track;
    in property <int> mode;
    in property <bool> playing;
    in property <[PlaylistChoice]> playlists;
    in property <length> title-w;
    in property <length> artist-w;
    in property <length> album-w;
    // Drop marker above (-1) / below (1) the row while dragging.
    in property <int> drop-mark;
    // (action, argument)
    callback action(string, int);
    // Drag in progress: rows moved from the press point (playlist mode).
    callback drag(int);
    callback drop();
    property <length> press-y;
    property <bool> dragging;
    // Album and playlist pages show the credits under the title.
    property <bool> two-line: (root.mode == 1 || root.mode == 2) && root.track.credits.length > 0;
    height: root.two-line ? 50px : 36px;
    background: root.dragging ? Theme.accent-dim : row-area.has-hover ? Theme.surface-hover : transparent;

    // Row menu, double click and drag. Declared first so the links,
    // heart and tags in the row (drawn above it) get their clicks.
    ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.action("play", 0);
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.action("next", 0);
                }
            }
            MenuItem {
                title: "添加到队列末尾";
                activated => {
                    root.action("last", 0);
                }
            }
            Menu {
                title: "添加到歌单";
                MenuItem {
                    title: "新建歌单…";
                    activated => {
                        root.action("new-playlist", 0);
                    }
                }
                for p in root.playlists: MenuItem {
                    title: p.name;
                    activated => {
                        root.action("add", p.id);
                    }
                }
            }
            MenuItem {
                title: root.track.favorite ? "取消收藏" : "收藏";
                activated => {
                    root.action("favorite", root.track.favorite ? 0 : 1);
                }
            }
            MenuItem {
                title: "相似歌曲";
                activated => {
                    root.action("similar", 0);
                }
            }
            if root.track.album-id > 0: MenuItem {
                title: "转到专辑";
                activated => {
                    root.action("album", root.track.album-id);
                }
            }
            if root.track.artist-id > 0: MenuItem {
                title: "转到艺人";
                activated => {
                    root.action("artist", root.track.artist-id);
                }
            }
            if root.mode == 2: MenuItem {
                title: "从歌单移除";
                activated => {
                    root.action("remove", 0);
                }
            }
        }

        row-area := TouchArea {
            double-clicked => {
                if !root.track.disabled {
                    root.action("play", 0);
                }
            }
            pointer-event(e) => {
                if root.mode == 2 && e.button == PointerEventButton.left {
                    if e.kind == PointerEventKind.down {
                        root.press-y = self.mouse-y;
                    }
                    if e.kind == PointerEventKind.up && root.dragging {
                        root.dragging = false;
                        root.drop();
                    }
                }
            }
            moved => {
                if root.mode == 2 && self.pressed && (root.dragging || abs(self.mouse-y - root.press-y) > 6px) {
                    root.dragging = true;
                    root.drag(round((self.mouse-y - root.press-y) / root.height));
                }
            }
        }
    }

    add-track-menu := PopupWindow {
        x: max(0px, root.width - 280px);
        y: root.height;
        width: 220px;
        height: min(360px, 70px + root.playlists.length * 32px);
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            ScrollView {
            VerticalLayout {
                padding: 6px;
                Text { text: "添加到歌单"; color: Theme.text-dim; }
                Rectangle {
                    height: 32px;
                    Text { text: "新建歌单…"; color: Theme.text; vertical-alignment: center; height: 100%; }
                    TouchArea { clicked => { add-track-menu.close(); root.action("new-playlist", 0); } }
                }
                for p in root.playlists: Rectangle {
                    height: 32px;
                    background: add-area.has-hover ? Theme.surface-hover : transparent;
                    Text { text: p.name; color: Theme.text; overflow: elide; vertical-alignment: center; height: 100%; }
                    add-area := TouchArea { clicked => { add-track-menu.close(); root.action("add", p.id); } }
                }
            }
            }
        }
    }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 16px;
        Rectangle {
            width: TrackColumns.number;
            if !root.playing: Text {
                x: 0;
                text: root.mode == 1 ? root.track.number : root.track.index + 1;
                color: Theme.text-faint;
                vertical-alignment: center;
            }
            if root.playing: PlayingBars {
                x: 2px;
                width: 13px;
                height: 12px;
            }
        }
        HorizontalLayout {
            width: root.title-w;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.track.title;
                    color: root.track.disabled || root.track.blocked ? Theme.text-faint : root.playing ? Theme.accent : Theme.text;
                    overflow: elide;
                }
                // Credits: names link to the artist (web album page).
                // Fixed min / preferred width: a long credits line must not
                // widen the title column (it is clipped at the column edge).
                if root.two-line: Rectangle {
                    height: 16px;
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    clip: true;
                    HorizontalLayout {
                        x: 0;
                        width: self.preferred-width;
                        alignment: start;
                        for part in root.track.credits: Text {
                            text: part.text;
                            color: part.id > 0 && credit-area.has-hover ? Theme.accent : part.id > 0 ? Theme.text-dim : Theme.text-faint;
                            font-size: 13px;
                            credit-area := TouchArea {
                                enabled: part.id > 0;
                                mouse-cursor: part.id > 0 ? pointer : default;
                                clicked => {
                                    root.action("artist", part.id);
                                }
                            }
                        }
                    }
                }
            }
            // "◆ OP": the track is used in a work (click: the work).
            if root.track.tieup != "": Rectangle {
                width: tieup-row.preferred-width + 12px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                border-radius: 10px;
                background: tieup-area.has-hover ? Theme.accent-dim : transparent;
                Tooltip {
                    Rectangle {
                        background: Theme.raised;
                        border-width: 1px;
                        border-color: Theme.border;
                        border-radius: Theme.radius;
                        width: 340px;
                        height: tip.preferred-height + 24px;
                        tip := Text {
                            x: 12px; y: 12px; width: parent.width - 24px;
                            text: root.track.tieup-tooltip;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                    }
                }
                border-width: 1px;
                border-color: Theme.accent-dim;
                tieup-row := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    Text {
                        text: "◆ " + root.track.tieup;
                        color: Theme.accent;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    if root.track.tieup-count > 1: Text {
                        text: root.track.tieup-count;
                        color: Theme.text-dim;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
                tieup-area := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.action("tieup", 0);
                    }
                }
            }
            if root.track.tag != "": Rectangle {
                width: tag-text.preferred-width + 10px;
                height: 18px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: root.track.tag-accent ? Theme.accent-dim : Theme.raised;
                tag-text := Text {
                    text: root.track.tag;
                    color: root.track.tag-accent ? Theme.accent : Theme.text-dim;
                    font-size: 12px;
                }
            }
        }
        // Artist and album link to their pages (the text only, not the
        // empty part of the column).
        Rectangle {
            width: root.artist-w;
            Text {
                x: 0;
                width: min(self.preferred-width, root.artist-w);
                text: root.track.artist;
                color: root.track.artist-id > 0 && artist-area.has-hover ? Theme.accent : Theme.text-dim;
                overflow: elide;
                vertical-alignment: center;
                artist-area := TouchArea {
                    enabled: root.track.artist-id > 0;
                    mouse-cursor: root.track.artist-id > 0 ? pointer : default;
                    clicked => {
                        root.action("artist", root.track.artist-id);
                    }
                }
            }
        }
        if root.mode != 1: album-col := Rectangle {
            width: root.album-w;
            property <bool> link: root.mode != 3 && root.track.album-id > 0;
            Text {
                x: 0;
                width: min(self.preferred-width, root.album-w);
                text: root.mode == 3 ? root.track.note : root.track.album;
                color: album-col.link && album-area.has-hover ? Theme.accent : Theme.text-dim;
                overflow: elide;
                vertical-alignment: center;
                album-area := TouchArea {
                    enabled: album-col.link;
                    mouse-cursor: album-col.link ? pointer : default;
                    clicked => {
                        root.action("album", root.track.album-id);
                    }
                }
            }
        }
        if root.mode == 4: Rectangle {
            width: 64px;
            Text {
                text: root.track.blocked ? "已不再推荐" : "不再推荐";
                color: root.track.blocked ? Theme.accent : block-area.has-hover ? Theme.text : Theme.text-faint;
                font-size: 12px;
                visible: root.track.blocked || row-area.has-hover || block-area.has-hover;
            }
            block-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.action("block", root.track.blocked ? 0 : 1);
                }
            }
        }
        Rectangle {
            width: TrackColumns.heart;
            if root.mode == 1: IconButton {
                kind: IconKind.playlist-add;
                size: 28px;
                icon-size: 16px;
                y: (parent.height - self.height) / 2;
                Tooltip { text: @markdown("添加到歌单"); }
                clicked => { add-track-menu.show(); }
            }
        }
        Rectangle {
            width: TrackColumns.heart;
            Icon {
                visible: root.track.favorite || row-area.has-hover || heart-area.has-hover;
                kind: root.track.favorite ? IconKind.heart : IconKind.heart-outline;
                width: 14px;
                height: 14px;
                color: root.track.favorite ? Theme.accent : heart-area.has-hover ? Theme.text : Theme.text-faint;
            }
            heart-area := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.action("favorite", root.track.favorite ? 0 : 1);
                }
            }
        }
        Text {
            text: root.track.duration;
            width: TrackColumns.duration;
            color: Theme.text-dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    if root.drop-mark != 0: Rectangle {
        y: root.drop-mark < 0 ? 0 : parent.height - 2px;
        height: 2px;
        background: Theme.accent;
    }

}

// Track list with a column header. `mode` as in `TrackRowView`.
export component TrackList inherits Rectangle {
    in property <[TrackRow]> rows;
    in property <int> mode;
    in property <int> playing-id: -1;
    in property <[PlaylistChoice]> playlists;
    in property <string> empty-text: "没有曲目";
    in property <bool> loading;
    // (action, row index, argument)
    callback action(string, int, int);
    // 32px side padding, fixed columns, 5 gaps of 16px.
    property <length> flex: max(0px, self.width - 64px - TrackColumns.number - TrackColumns.heart - TrackColumns.duration - 80px - (root.mode == 1 ? 44px : 0px) - (root.mode == 4 ? 80px : 0px));
    property <length> title-w: root.mode == 1 ? root.flex * 0.62 : root.flex * 0.42;
    property <length> artist-w: root.mode == 1 ? root.flex * 0.38 - 16px : root.flex * 0.24;
    property <length> album-w: root.flex * 0.34;
    // Playlist drag and drop: dragged row and where it would land.
    property <int> drag-from: -1;
    property <int> drop-at: -1;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            height: 28px;
            spacing: 16px;
            Text { text: "#"; width: TrackColumns.number; color: Theme.text-faint; font-size: 13px; vertical-alignment: center; }
            Text { text: "标题"; width: root.title-w; color: Theme.text-faint; font-size: 13px; vertical-alignment: center; }
            Text { text: "艺人"; width: root.artist-w; color: Theme.text-faint; font-size: 13px; vertical-alignment: center; }
            if root.mode != 1: Text { text: root.mode == 3 ? "播放记录" : "专辑"; width: root.album-w; color: Theme.text-faint; font-size: 13px; vertical-alignment: center; }
            if root.mode == 4: Rectangle { width: 64px; }
            if root.mode == 1: Rectangle { width: TrackColumns.heart; }
            Rectangle { width: TrackColumns.heart; }
            Text { text: "时长"; width: TrackColumns.duration; color: Theme.text-faint; font-size: 13px; horizontal-alignment: right; vertical-alignment: center; }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.rows.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: root.loading ? "加载中…" : root.empty-text;
                color: Theme.text-faint;
            }
        }

        if root.rows.length > 0: ListView {
            vertical-stretch: 1;
            for track[i] in root.rows: TrackRowView {
                track: track;
                mode: root.mode;
                playing: track.id == root.playing-id;
                playlists: root.playlists;
                title-w: root.title-w;
                artist-w: root.artist-w;
                album-w: root.album-w;
                drop-mark: root.drag-from < 0 || root.drop-at != i || root.drop-at == root.drag-from ? 0 : root.drop-at < root.drag-from ? -1 : 1;
                action(what, arg) => {
                    root.action(what, track.index, arg);
                }
                drag(offset) => {
                    root.drag-from = i;
                    root.drop-at = max(0, min(root.rows.length - 1, i + offset));
                }
                drop => {
                    if root.drop-at >= 0 && root.drop-at != root.drag-from {
                        root.action("move", track.index, root.drop-at);
                    }
                    root.drag-from = -1;
                    root.drop-at = -1;
                }
            }
        }
    }
}

export component QueuePanel inherits Rectangle {
    in property <[QueueRow]> rows;
    // Entries in the whole queue (`rows` may be filtered).
    in property <int> total;
    in property <int> current: -1;
    // The search text (rows are filtered in Rust; no dragging then).
    in-out property <string> search;
    callback search-changed(string);
    callback play(int);
    callback remove(int);
    callback clear();
    // Save the queue as a new playlist.
    callback save();
    // (uid, new play-order position)
    callback move(int, int);
    property <int> drag-from: -1;
    property <int> drop-at: -1;
    background: Theme.surface;

    function locate() {
        if root.current >= 0 {
            list.content-y = -min(max(0px, root.current * 52px - (list.visible-height - 52px) / 2), max(0px, list.content-height - list.visible-height));
        }
    }

    if root.rows.length == 0: Text {
        y: 120px;
        width: root.width;
        horizontal-alignment: center;
        text: root.search != "" ? "没有匹配的曲目" : "队列为空";
        color: Theme.text-faint;
    }

    VerticalLayout {
        // Toolbar (Electron `play-queue-list-controls`).
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-top: 10px;
            padding-bottom: 4px;
            spacing: 2px;
            Text {
                text: "播放队列";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.total == 0 ? "" : "  " + root.total + " 首";
                color: Theme.text-faint;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            IconButton {
                kind: IconKind.locate;
                size: 30px;
                icon-size: 16px;
                enabled: root.current >= 0;
                clicked => {
                    root.locate();
                }
            }
            IconButton {
                kind: IconKind.playlist-add;
                size: 30px;
                icon-size: 16px;
                enabled: root.total > 0;
                clicked => {
                    root.save();
                }
            }
            IconButton {
                kind: IconKind.trash;
                size: 30px;
                icon-size: 16px;
                enabled: root.total > 0;
                clicked => {
                    root.clear();
                }
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 8px;
            SearchField {
                height: 30px;
                placeholder: "搜索队列";
                text <=> root.search;
                edited => {
                    root.search-changed(self.text);
                }
                accepted => {
                    root.search-changed(self.text);
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        list := ListView {
            for row[i] in root.rows: Rectangle {
                property <length> press-y;
                property <bool> dragging: root.drag-from == i;
                height: 52px;
                background: self.dragging ? Theme.accent-dim : i == root.current ? Theme.accent-dim : area.has-hover ? Theme.surface-hover : transparent;

                area := TouchArea {
                    double-clicked => {
                        root.play(row.uid);
                    }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left {
                            if e.kind == PointerEventKind.down {
                                parent.press-y = self.mouse-y;
                            }
                            if e.kind == PointerEventKind.up && root.drag-from == i {
                                if root.drop-at >= 0 && root.drop-at != i {
                                    root.move(row.uid, root.drop-at);
                                }
                                root.drag-from = -1;
                                root.drop-at = -1;
                            }
                        }
                    }
                    moved => {
                        if self.pressed && root.search == "" && (root.drag-from == i || abs(self.mouse-y - parent.press-y) > 6px) {
                            root.drag-from = i;
                            root.drop-at = max(0, min(root.rows.length - 1, i + round((self.mouse-y - parent.press-y) / parent.height)));
                        }
                    }
                }

                if root.drag-from >= 0 && root.drop-at == i && i != root.drag-from: Rectangle {
                    y: root.drop-at < root.drag-from ? 0 : parent.height - 2px;
                    height: 2px;
                    background: Theme.accent;
                }

                // Electron queue table: number, cover, title / artist, time.
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 12px;
                    spacing: 10px;
                    Rectangle {
                        width: 28px;
                        if i != root.current: Text {
                            text: row.number;
                            color: Theme.text-faint;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if i == root.current: PlayingBars {
                            width: 12px;
                            height: 11px;
                        }
                    }
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Theme.raised;
                        clip: true;
                        Image {
                            source: row.cover;
                            width: 100%;
                            height: 100%;
                            image-fit: ImageFit.cover;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: row.title;
                            color: i == root.current ? Theme.accent : Theme.text;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: row.artist;
                            color: Theme.text-dim;
                            font-size: 12px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: row.duration;
                        color: Theme.text-faint;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 28px;
                        Icon {
                            visible: area.has-hover || remove-area.has-hover;
                            kind: IconKind.close;
                            width: 14px;
                            height: 14px;
                            color: remove-area.has-hover ? Theme.text : Theme.text-faint;
                        }
                        remove-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.remove(row.uid);
                            }
                        }
                    }
                }
            }
        }
    }
}

component LyricsTool inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 26px;
    width: max(30px, label.preferred-width + 16px);
    border-radius: 4px;
    background: area.has-hover ? Theme.surface-hover : transparent;
    label := Text {
        text: root.text;
        color: root.active ? Theme.accent : area.has-hover ? Theme.text : Theme.text-dim;
        font-size: 13px;
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Lyrics of the current track: synced lines follow playback (scrolling by
// hand pauses that for a few seconds), clicking a synced line seeks to it.
// The toolbar searches online lyrics, shifts them and translates.
export component LyricsPanel inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> active: -1;
    in property <bool> synced;
    in property <string> source;
    in property <bool> has-track;
    in property <bool> can-search;
    in property <bool> can-translate;
    in property <bool> translation-shown;
    in property <bool> translating;
    in property <int> offset-ms;
    callback seek-line(int);
    // search, clear, translate; offset (ms)
    callback tool(string);
    callback offset(int);
    // Panel controls in the right panel (Electron `PanelReorderControls`):
    // move up (-1) / down (1), close.
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    callback move-panel(int);
    callback close-panel();
    in property <bool> lines-have-translation;
    background: Theme.surface;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 8px;
            padding-top: 10px;
            padding-bottom: 6px;
            spacing: 2px;
            Text {
                text: "歌词";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.source;
                color: Theme.text-faint;
                font-size: 12px;
                horizontal-alignment: right;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Rectangle {
                width: 6px;
            }
            IconButton {
                kind: IconKind.arrow-up;
                size: 26px;
                icon-size: 14px;
                enabled: root.can-move-up;
                clicked => {
                    root.move-panel(-1);
                }
            }
            IconButton {
                kind: IconKind.arrow-down;
                size: 26px;
                icon-size: 14px;
                enabled: root.can-move-down;
                clicked => {
                    root.move-panel(1);
                }
            }
            IconButton {
                kind: IconKind.close;
                size: 26px;
                icon-size: 14px;
                clicked => {
                    root.close-panel();
                }
            }
        }

        if root.lines.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: root.has-track ? "暂无歌词" : "";
                color: Theme.text-faint;
            }
        }

        // Synced lyrics (Electron sidebar lyrics: left aligned, bold, the
        // other lines faded; long lines wrap). The active line stays at 40%
        // of the height unless the user scrolled in the last 4 seconds.
        if root.lines.length > 0 && root.synced: synced-flick := Flickable {
            vertical-stretch: 1;
            // Not from the content (its padding follows this height).
            min-height: 0px;
            max-height: 100000px;
            preferred-height: 0px;
            property <bool> follow: true;
            // Top of the active line in the column.
            property <length> target;
            function recenter() {
                self.content-y = -max(0px, min(self.target - self.height * 0.4, self.content-height - self.height));
            }
            content-height: synced-col.preferred-height;
            flicked => {
                self.follow = false;
                resume.restart();
            }
            resume := Timer {
                interval: 4s;
                running: false;
                triggered => {
                    self.running = false;
                    synced-flick.follow = true;
                    synced-flick.recenter();
                }
            }
            changed height => {
                if self.follow {
                    self.recenter();
                }
            }
            animate content-y { duration: 380ms; easing: ease-out; }

            synced-col := VerticalLayout {
                width: synced-flick.width;
                padding-top: synced-flick.height * 0.4;
                padding-bottom: synced-flick.height * 0.5;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 4px;
                for line[i] in root.lines: Rectangle {
                    property <bool> on: i == root.active;
                    function track() {
                        if self.on {
                            synced-flick.target = self.y;
                            if synced-flick.follow {
                                synced-flick.recenter();
                            }
                        }
                    }
                    init => {
                        self.track();
                    }
                    changed on => {
                        self.track();
                    }
                    changed y => {
                        self.track();
                    }
                    height: line-col.preferred-height;
                    border-radius: Theme.radius;
                    background: line-area.has-hover ? Theme.surface-hover : transparent;
                    line-col := VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 2px;
                        Text {
                            text: line.text;
                            wrap: word-wrap;
                            font-size: 18px;
                            font-weight: 700;
                            color: on ? Theme.text : Theme.text.with-alpha(0.32);
                            animate color { duration: 300ms; }
                        }
                        if line.translation != "": Text {
                            text: line.translation;
                            wrap: word-wrap;
                            font-size: 15px;
                            font-weight: 600;
                            color: on ? Theme.text-dim : Theme.text.with-alpha(0.25);
                            animate color { duration: 300ms; }
                        }
                    }
                    line-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.seek-line(i);
                        }
                    }
                }
            }
        }

        // Plain lyrics: free scrolling.
        if root.lines.length > 0 && !root.synced: plain-flick := Flickable {
            vertical-stretch: 1;
            content-height: plain-col.preferred-height;
            plain-col := VerticalLayout {
                width: plain-flick.width;
                padding: 16px;
                spacing: 10px;
                for line in root.lines: VerticalLayout {
                    spacing: 2px;
                    Text {
                        text: line.text;
                        wrap: word-wrap;
                        font-size: 16px;
                        font-weight: 600;
                        color: Theme.text-dim;
                    }
                    if line.translation != "": Text {
                        text: line.translation;
                        wrap: word-wrap;
                        font-size: 14px;
                        color: Theme.text-faint;
                    }
                }
            }
        }

        if root.has-track: Rectangle {
            height: 1px;
            background: Theme.border;
        }

        if root.has-track: HorizontalLayout {
            padding: 8px;
            spacing: 2px;
            alignment: center;
            if root.can-search: LyricsTool {
                text: "搜索";
                clicked => {
                    root.tool("search");
                }
            }
            if root.synced: LyricsTool {
                text: "−";
                clicked => {
                    root.offset(root.offset-ms - 50);
                }
            }
            if root.synced: Text {
                text: (root.offset-ms > 0 ? "+" : "") + root.offset-ms + " ms";
                color: root.offset-ms == 0 ? Theme.text-faint : Theme.accent;
                font-size: 13px;
                width: 64px;
                horizontal-alignment: center;
                vertical-alignment: center;
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.offset(0);
                    }
                }
            }
            if root.synced: LyricsTool {
                text: "+";
                clicked => {
                    root.offset(root.offset-ms + 50);
                }
            }
            if root.can-translate: LyricsTool {
                text: root.translating ? "翻译中…" : "翻译";
                active: root.translation-shown;
                clicked => {
                    root.tool("translate");
                }
            }
            if root.can-search && root.lines.length > 0: LyricsTool {
                text: "清除";
                clicked => {
                    root.tool("clear");
                }
            }
        }
    }
}

export component PlayerBar inherits Rectangle {
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> quality;
    in property <image> cover;
    // The cover shows here only when the sidebar has no room for it.
    in property <bool> show-cover: true;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <string> position-text;
    in property <string> duration-text;
    in property <bool> paused: true;
    in property <bool> buffering;
    in property <float> volume: 100;
    in property <bool> lyrics-open;
    in property <bool> queue-open;
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    in property <bool> favorite;
    callback toggle-favorite();
    callback open-album();
    callback open-artist();
    // WASAPI exclusive output, switchable while playing; `exclusive-busy`
    // while a change is applied.
    in property <bool> exclusive;
    in property <bool> exclusive-busy;
    callback toggle-exclusive(bool);
    in property <bool> sleep-active;
    // Remaining time or the mode, next to the button.
    in property <string> sleep-label;
    // (0 off, 1 end of track, 2 end of album, 3 minutes; minutes)
    callback set-sleep(int, int);
    callback toggle-pause();
    callback toggle-queue();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback next();
    callback previous();
    callback seek(int);
    callback volume-changed(float);
    callback toggle-lyrics();
    height: 84px;
    background: Theme.surface;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        // Now playing.
        HorizontalLayout {
            width: 30%;
            spacing: 12px;
            alignment: start;
            if root.show-cover: Rectangle {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Theme.raised;
                clip: true;
                Image {
                    source: root.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
            }

            // Electron player bar: the title, then the quality tag and
            // "artist · album" links.
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: root.has-track ? root.title : "未在播放";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                    overflow: elide;
                }
                if root.has-track: HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    if root.quality != "": Rectangle {
                        width: quality-text.preferred-width + 10px;
                        height: 18px;
                        y: (parent.height - self.height) / 2;
                        border-radius: 4px;
                        background: Theme.raised;
                        quality-text := Text {
                            text: root.quality;
                            color: Theme.text-dim;
                            font-size: 11px;
                            font-weight: 600;
                        }
                    }
                    Text {
                        text: root.artist;
                        color: artist-area.has-hover ? Theme.accent.brighter(20%) : Theme.accent;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                        artist-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-artist();
                            }
                        }
                    }
                    if root.album != "": Text {
                        text: "·";
                        color: Theme.text-faint;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    if root.album != "": Text {
                        text: root.album;
                        color: album-area.has-hover ? Theme.accent.brighter(20%) : Theme.accent;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                        album-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-album();
                            }
                        }
                    }
                }
            }

            if root.has-track: IconButton {
                kind: root.favorite ? IconKind.heart : IconKind.heart-outline;
                active: root.favorite;
                icon-size: 16px;
                size: 32px;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-favorite();
                }
            }
        }

        // Transport + progress.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                IconButton {
                    kind: IconKind.shuffle;
                    active: root.shuffle;
                    icon-size: 20px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.toggle-shuffle();
                    }
                }
                IconButton {
                    kind: IconKind.previous;
                    enabled: root.has-track;
                    clicked => {
                        root.previous();
                    }
                }
                IconButton {
                    kind: root.paused ? IconKind.play : IconKind.pause;
                    filled: true;
                    size: 40px;
                    enabled: root.has-track;
                    clicked => {
                        root.toggle-pause();
                    }
                }
                IconButton {
                    kind: IconKind.next;
                    enabled: root.has-track;
                    clicked => {
                        root.next();
                    }
                }
                IconButton {
                    kind: IconKind.repeat;
                    badge: root.repeat == 2 ? "1" : "";
                    active: root.repeat != 0;
                    icon-size: 20px;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        root.cycle-repeat();
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: seek-bar.dragging ? root.preview-text : root.position-text;
                    width: 48px;
                    color: Theme.text-dim;
                    font-size: 12px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                seek-bar := ValueBar {
                    enabled: root.has-track && root.duration-ms > 0;
                    value: root.duration-ms > 0 ? root.position-ms / root.duration-ms : 0;
                    live(v) => {
                        root.preview-ms = v * root.duration-ms;
                    }
                    committed(v) => {
                        root.seek(v * root.duration-ms);
                    }
                }
                Text {
                    text: root.buffering ? "缓冲中" : root.duration-text;
                    width: 48px;
                    color: Theme.text-dim;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        // Exclusive mode, sleep timer, queue, lyrics, volume.
        HorizontalLayout {
            width: 30%;
            alignment: end;
            spacing: 12px;
            Rectangle {
                width: excl-text.preferred-width + 16px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                border-radius: 12px;
                border-width: 1px;
                border-color: root.exclusive ? Theme.accent : Theme.border;
                background: root.exclusive ? Theme.accent-dim : excl-area.has-hover ? Theme.surface-hover : transparent;
                opacity: root.exclusive-busy ? 0.5 : 1;
                excl-text := Text {
                    text: root.exclusive-busy ? "切换中…" : "独占";
                    color: root.exclusive ? Theme.accent : Theme.text-dim;
                    font-size: 12px;
                    font-weight: 600;
                }
                excl-area := TouchArea {
                    enabled: !root.exclusive-busy;
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-exclusive(!root.exclusive);
                    }
                }
            }
            HorizontalLayout {
                spacing: 2px;
                sleep-button := IconButton {
                    kind: IconKind.sleep;
                    active: root.sleep-active;
                    y: (parent.height - self.height) / 2;
                    clicked => {
                        sleep-menu.show();
                    }
                }
                if root.sleep-active: Text {
                    text: root.sleep-label;
                    color: Theme.accent;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
            IconButton {
                kind: IconKind.queue;
                active: root.queue-open;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-queue();
                }
            }
            IconButton {
                kind: IconKind.lyrics;
                active: root.lyrics-open;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-lyrics();
                }
            }
            ValueBar {
                width: 120px;
                y: (parent.height - self.height) / 2;
                value: root.volume / 100;
                live(v) => {
                    root.volume-changed(v * 100);
                }
                committed(v) => {
                    root.volume-changed(v * 100);
                }
            }
        }
    }

    sleep-menu := PopupWindow {
        x: root.width - 380px;
        y: -self.height - 8px;
        width: 180px;
        Rectangle {
            background: Theme.raised;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                Text {
                    text: "睡眠定时";
                    color: Theme.text-faint;
                    font-size: 12px;
                    height: 24px;
                    vertical-alignment: center;
                    x: 10px;
                }
                for option in [
                    { label: "本曲结束后", mode: 1, minutes: 0 },
                    { label: "本专辑结束后", mode: 2, minutes: 0 },
                    { label: "5 分钟", mode: 3, minutes: 5 },
                    { label: "10 分钟", mode: 3, minutes: 10 },
                    { label: "15 分钟", mode: 3, minutes: 15 },
                    { label: "30 分钟", mode: 3, minutes: 30 },
                    { label: "45 分钟", mode: 3, minutes: 45 },
                    { label: "1 小时", mode: 3, minutes: 60 },
                    { label: "2 小时", mode: 3, minutes: 120 },
                    { label: "3 小时", mode: 3, minutes: 180 },
                    { label: "4 小时", mode: 3, minutes: 240 },
                    { label: "关闭定时", mode: 0, minutes: 0 },
                ]: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    visible: option.mode != 0 || root.sleep-active;
                    background: item-area.has-hover ? Theme.surface-hover : transparent;
                    Text {
                        x: 10px;
                        text: option.label;
                        color: Theme.text;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    item-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-sleep(option.mode, option.minutes);
                        }
                    }
                }
            }
        }
    }

    // Seek preview while dragging.
    property <int> preview-ms;
    property <string> preview-text: floor(root.preview-ms / 60000) + ":" + (mod(floor(root.preview-ms / 1000), 60) < 10 ? "0" : "") + mod(floor(root.preview-ms / 1000), 60);
}
