import { ListView, ScrollView } from "std-widgets.slint";
import { ArtFit, Fonts, Shell, Theme } from "theme.slint";
import { PlayingBars, Field, PrimaryButton, ValueBar, IconButton, IconKind, Icon, SearchField, CastState } from "controls.slint";

// A name with its server-side identity (also used in credits).
export struct CreditPart {
    text: string,
    id: int,
}

export global ArtistLayout {
    pure callback fit-count([CreditPart], length, length, int) -> int;
    pure callback full-width([CreditPart], length, int) -> length;
    pure callback chip-width(int, length) -> length;
    pure callback cap-width(string, length, length) -> length;
}

component ArtistPopoverPanel inherits Rectangle {
    in property <[CreditPart]> artists;
    callback open(int);
    property <int> active-index: -1;
    out property <bool> hovered: panel-area.has-hover || root.active-index >= 0;
    property <length> list-h: min(root.artists.length * 32px, 224px);
    width: 248px;
    height: content.preferred-height;
    background: Theme.popover;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.popover-border;
    drop-shadow-blur: 28px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: #00000099;
    panel-area := TouchArea {
        width: 100%;
        height: 100%;
    }
    content := VerticalLayout {
        padding: 8px;
        spacing: 4px;
        Text {
            text: "全部艺人 (" + root.artists.length + ")";
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 11.5px;
            font-weight: 600;
            height: 22px;
            vertical-alignment: center;
        }
        ScrollView {
            height: root.list-h;
            VerticalLayout {
                alignment: start;
                for artist[i] in root.artists: Rectangle {
                    height: 32px;
                    border-radius: 6px;
                    background: artist.id > 0 && item-area.has-hover ? (Theme.dark ? #ffffff0d : #0000000a) : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        Text {
                            text: artist.text;
                            font-family: Fonts.family(self.text);
                            color: artist.id > 0 && item-area.has-hover ? Theme.accent-text : Theme.text;
                            font-size: 13px;
                            overflow: elide;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if artist.id > 0: Icon {
                            kind: IconKind.chevron-right;
                            width: 13px;
                            height: 13px;
                            y: (parent.height - self.height) / 2;
                            color: item-area.has-hover ? Theme.accent-text : Theme.text-faint;
                        }
                    }
                    item-area := TouchArea {
                        enabled: artist.id > 0;
                        mouse-cursor: artist.id > 0 ? pointer : default;
                        changed has-hover => {
                            if self.has-hover {
                                root.active-index = i;
                            } else if root.active-index == i {
                                root.active-index = -1;
                            }
                        }
                        clicked => {
                            root.active-index = -1;
                            root.open(artist.id);
                        }
                    }
                }
            }
        }
    }
}

// Every identity has its own hit target; separators never navigate.
// When the list exceeds `root.width`, fits as many full names as possible and
// collapses the remainder into a `+N` chip with a hover/click popover.
export component ArtistLinks inherits Rectangle {
    in property <[CreditPart]> artists;
    in property <string> fallback;
    in property <length> font-size: 14px;
    in property <int> font-weight: 400;
    in property <color> text-color: Theme.text-dim;
    callback open(int);
    property <int> raw-fit: root.artists.length == 0 ? 0 : ArtistLayout.fit-count(root.artists, root.width, root.font-size, root.font-weight);
    property <int> shown-count: root.artists.length == 0 ? 0 : clamp(root.raw-fit <= 0 ? root.artists.length : root.raw-fit, 1, root.artists.length);
    property <int> hidden-count: max(0, root.artists.length - root.shown-count);
    property <length> chip-font-size: max(11px, root.font-size * 0.82);
    property <length> chip-gap: max(6px, root.font-size * 0.45);
    property <length> chip-w: root.hidden-count > 0 ? ArtistLayout.chip-width(root.hidden-count, root.font-size) : 0px;
    property <length> chip-h: max(20px, root.font-size * 1.35);
    property <length> full-w: root.artists.length == 0 ? measure.preferred-width : ArtistLayout.full-width(root.artists, root.font-size, root.font-weight);
    min-width: 0px;
    preferred-width: root.full-w > 0px ? root.full-w : measure.preferred-width;
    preferred-height: max(root.font-size * 1.5, root.chip-h);
    clip: true;
    measure := Text { visible: false; x: 0px; y: 0px; text: root.fallback; font-size: root.font-size; font-weight: root.font-weight; font-family: Fonts.family(self.text); }
    if root.artists.length == 0: Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.fallback;
        font-family: Fonts.family(self.text);
        font-size: root.font-size;
        font-weight: root.font-weight;
        color: root.text-color;
        overflow: elide;
        vertical-alignment: center;
    }
    if root.artists.length > 0: HorizontalLayout {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        alignment: start;
        spacing: 0px;
        for artist[i] in root.artists: HorizontalLayout {
            spacing: 0px;
            if i < root.shown-count && i > 0: Text {
                text: " | ";
                font-size: root.font-size;
                color: Theme.text-faint;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            if i < root.shown-count: Text {
                text: artist.text;
                font-family: Fonts.family(self.text);
                font-size: root.font-size;
                font-weight: root.font-weight;
                color: artist.id > 0 && link.has-hover ? Theme.accent-text : root.text-color;
                overflow: elide;
                vertical-alignment: center;
                max-width: (root.shown-count == 1 && root.hidden-count > 0) ? max(0px, root.width - root.chip-w - root.chip-gap) : 10000px;
                horizontal-stretch: 0;
                link := TouchArea {
                    enabled: artist.id > 0;
                    mouse-cursor: artist.id > 0 ? pointer : default;
                    clicked => { root.open(artist.id); }
                }
            }
        }
        if root.hidden-count > 0: HorizontalLayout {
            padding-left: root.chip-gap;
            horizontal-stretch: 0;
            chip := Rectangle {
                width: root.chip-w;
                height: root.chip-h;
                y: (parent.height - self.height) / 2;
                border-radius: self.height / 2;
                background: chip-area.has-hover || chip-area.previewing ? Theme.accent-dim : Theme.raised;
                border-width: chip-area.has-hover || chip-area.previewing ? 1px : 0px;
                border-color: Theme.accent;
                property <bool> panel-hovered;
                changed panel-hovered => {
                    if self.panel-hovered {
                        hover-close.running = false;
                    } else if chip-area.previewing && !chip-area.has-hover {
                        hover-close.running = true;
                    }
                }
                Text {
                    text: "+" + root.hidden-count;
                    font-size: root.chip-font-size;
                    font-weight: 600;
                    color: chip-area.has-hover || chip-area.previewing ? Theme.accent-text : root.text-color;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
                artists-popup := PopupWindow {
                    property <length> pop-w: 248px;
                    property <length> pop-h: min(266px, 42px + root.artists.length * 32px);
                    property <bool> open-above: chip.absolute-position.y + chip.height + pop-h + 16px > Shell.window-height;
                    x: -64px;
                    y: open-above ? -pop-h - 4px : chip.height + 4px;
                    width: pop-w;
                    height: pop-h;
                    close-policy: PopupClosePolicy.close-on-click-outside;
                    popup-panel := ArtistPopoverPanel {
                        artists: root.artists;
                        changed hovered => { chip.panel-hovered = self.hovered; }
                        open(id) => {
                            hover-open.running = false;
                            hover-close.running = false;
                            chip-area.previewing = false;
                            chip.panel-hovered = false;
                            artists-popup.close();
                            root.open(id);
                        }
                    }
                }
                hover-open := Timer {
                    running: false;
                    interval: 150ms;
                    triggered => {
                        self.running = false;
                        if chip-area.has-hover {
                            chip-area.previewing = true;
                            artists-popup.show();
                        }
                    }
                }
                hover-close := Timer {
                    running: false;
                    interval: 220ms;
                    triggered => {
                        self.running = false;
                        if chip-area.previewing && !chip-area.has-hover && !chip.panel-hovered {
                            artists-popup.close();
                            chip-area.previewing = false;
                        }
                    }
                }
                chip-area := TouchArea {
                    property <bool> previewing;
                    changed has-hover => {
                        if self.has-hover {
                            hover-close.running = false;
                            if !self.previewing { hover-open.running = true; }
                        } else {
                            hover-open.running = false;
                            if self.previewing && !chip.panel-hovered { hover-close.running = true; }
                        }
                    }
                    mouse-cursor: pointer;
                    clicked => {
                        hover-open.running = false;
                        hover-close.running = false;
                        chip-area.previewing = true;
                        artists-popup.show();
                    }
                }
            }
        }
    }
}

// `badge`: relation on an artist page; `artist-id` 0 = none. `note`: an
// extra line (track uses on a work page); `playing`: the current track
// belongs to it (works, series).
export struct AlbumCard {
    id: int,
    title: string,
    artist: string,
    year: string,
    cover: image,
    artist-id: int,
    artists: [CreditPart],
    favorite: bool,
    badge: string,
    note: string,
    // Muted last line ("入库于 3 天前").
    added: string,
    playing: bool,
    disc-count: int,
}

export struct AlbumRow {
    items: [AlbumCard],
}

// `index`: row in its list; `number`: album track number ("1-03").
// `tag`: a label after the title (use on a work, history state, 新发现),
// `note`: replaces the album column (history), `disabled`: the file is
// missing, `blocked`: 不再推荐 (daily mixes).
component TrackMenuItem inherits Rectangle {
    in property <string> text;
    callback triggered();
    height: 34px;
    border-radius: 5px;
    background: area.has-hover ? Theme.surface-hover : transparent;
    Text { x: 12px; width: parent.width - 24px; height: 100%; text: root.text; color: Theme.text; vertical-alignment: center; overflow: elide; }
    area := TouchArea { mouse-cursor: pointer; clicked => { root.triggered(); } }
}

export struct TieupWork {
    id: int,
    title: string,
    translated: string,
    meta: string,
    usage: string,
    poster: image,
}

// The OP / ED popover (v3 Editorial): 72 x 108 poster, title, translated
// title, use and type · year, "查看作品".
component TieupCards inherits Rectangle {
    in property <[TieupWork]> works;
    callback open-work(int);
    property <int> active-work: -1;
    out property <bool> hovered: panel-area.has-hover || root.active-work >= 0;
    width: 420px;
    height: content.preferred-height;
    background: Theme.popover;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.popover-border;
    drop-shadow-blur: 36px;
    drop-shadow-offset-y: 18px;
    drop-shadow-color: #000000a0;
    panel-area := TouchArea {
        width: 100%;
        height: 100%;
    }
    content := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        for work[i] in root.works: VerticalLayout {
            spacing: 8px;
            if i > 0: Rectangle { height: 1px; background: Theme.popover-border; }
            Rectangle {
                height: max(120px, info.preferred-height + 12px);
                border-radius: 9px;
                background: work-area.has-hover ? (Theme.dark ? #ffffff0d : #0000000a) : transparent;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 14px;
                    Rectangle {
                        width: 72px; height: 108px;
                        border-radius: 5px;
                        background: Theme.raised;
                        drop-shadow-blur: 6px;
                        drop-shadow-offset-y: 2px;
                        drop-shadow-color: #00000066;
                        Rectangle {
                            border-radius: 5px;
                            clip: true;
                            Image { source: work.poster; width: 100%; height: 100%; image-fit: cover; }
                        }
                    }
                    info := VerticalLayout {
                        alignment: start;
                        spacing: 3px;
                        Text { text: work.title; font-family: Fonts.family(self.text); color: Theme.text; font-size: 15.5px; font-weight: 750; wrap: word-wrap; }
                        if work.translated != "": Text { text: work.translated; font-family: Fonts.family(self.text); color: Theme.text-dim; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            padding-top: 5px;
                            Rectangle {
                                height: 20px;
                                width: role.preferred-width + 16px;
                                border-radius: 10px;
                                background: Theme.accent-dim;
                                role := Text { text: work.usage; font-family: Fonts.family(self.text); color: Theme.accent-text; font-size: 11.5px; font-weight: 700; }
                            }
                            Text { text: work.meta; font-family: Fonts.family(self.text); color: Theme.text-dim; font-size: 12.5px; vertical-alignment: center; overflow: elide; }
                        }
                        HorizontalLayout {
                            alignment: start;
                            padding-top: 7px;
                            spacing: 3px;
                            Text { text: "查看作品"; color: Theme.accent-text; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                            Icon { kind: IconKind.chevron-right; width: 14px; height: 14px; y: (parent.height - self.height) / 2; color: Theme.accent-text; }
                        }
                    }
                }
                work-area := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if self.has-hover {
                            root.active-work = i;
                        } else if root.active-work == i {
                            root.active-work = -1;
                        }
                    }
                    clicked => {
                        root.active-work = -1;
                        root.open-work(work.id);
                    }
                }
            }
        }
    }
}

export struct TrackRow {
    id: int,
    index: int,
    title: string,
    artist: string,
    album: string,
    duration: string,
    album-id: int,
    artist-id: int,
    artists: [CreditPart],
    favorite: bool,
    number: string,
    tag: string,
    tag-accent: bool,
    note: string,
    disabled: bool,
    blocked: bool,
    // Album pages: "作词 A · 作曲 B" under the title, and the work use
    // ("OP") with the number of linked works.
    credits: [CreditPart],
    tieup: string,
    tieup-count: int,
    tieup-tooltip: string,
    tieup-works: [TieupWork],
    disc: int,
    year: string,
    cover: image,
    version-count: int,
}

// `translation`: shown under the line (bilingual).
export struct LyricLine {
    text: string,
    translation: string,
}

export struct QueueRow {
    uid: int,
    // Position in the queue (1-based; search keeps the queue numbers).
    number: int,
    title: string,
    artist: string,
    duration: string,
    cover: image,
}

export struct PlaylistChoice {
    id: int,
    name: string,
}

export component LoginView inherits Rectangle {
    in-out property <string> server;
    in-out property <string> api-token;
    in-out property <string> media-token;
    // A token is saved for the server: an empty field reuses it.
    in property <bool> api-token-saved;
    in property <bool> media-token-saved;
    in property <string> error;
    in property <bool> busy;
    callback login(string, string, string);
    background: Theme.bg;

    function submit() {
        if !root.busy {
            root.login(root.server, root.api-token, root.media-token);
        }
    }

    Rectangle {
        width: 420px;
        height: card.preferred-height;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        card := VerticalLayout {
            padding: 32px;
            spacing: 18px;

            Text {
                text: "连接 032 Music Server";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }

            Field {
                label: "服务器地址";
                placeholder: "https://music.example.com";
                text <=> root.server;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "API Token";
                placeholder: root.api-token-saved ? "已保存，留空即沿用" : "";
                password: true;
                text <=> root.api-token;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "媒体凭据";
                placeholder: root.media-token-saved ? "已保存，留空即沿用" : "";
                password: true;
                text <=> root.media-token;
                accepted => {
                    root.submit();
                }
            }

            if root.error != "": Text {
                text: root.error;
                font-family: Fonts.family(self.text);
                color: Theme.danger;
                wrap: word-wrap;
            }

            PrimaryButton {
                text: root.busy ? "连接中…" : "登录";
                enabled: !root.busy;
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

// Album / artist / playlist card. Clicking opens it; the round button plays
// (not on round artist covers, which would clip it).
export component CardView inherits Rectangle {
    in property <AlbumCard> card;
    // 0 album, 1 artist, 2 playlist, 3 work (2:3 poster), 4 series (poster).
    in property <int> kind;
    in property <length> size: 168px;
    in property <[PlaylistChoice]> playlists;
    // (action, argument): see `card-action` in app.slint.
    callback action(string, int);
    property <bool> poster: root.kind == 3 || root.kind == 4;
    property <bool> adaptive: !root.poster && root.kind != 1;
    // Whole physical pixels (Rust decodes posters at round(size x 1.5)).
    property <length> art-h: root.poster ? round(root.size * 1.5 / 1phx) * 1phx : root.size;
    property <length> img-w: root.adaptive ? ArtFit.width(root.size, root.art-h, root.card.cover) : root.size;
    property <length> img-h: root.adaptive ? ArtFit.height(root.size, root.art-h, root.card.cover) : root.art-h;
    property <length> img-x: (root.size - root.img-w) / 2;
    property <length> img-y: root.art-h - root.img-h;
    property <bool> center-meta: root.kind == 1;
    // The pointer is on the round play button (bottom right of the cover).
    property <bool> has-play: root.kind != 1 && root.kind != 4;
    property <bool> over-play: root.has-play && area.has-hover
        && area.mouse-x >= root.img-x + root.img-w - 52px
        && area.mouse-x <= root.img-x + root.img-w - 12px
        && area.mouse-y >= root.img-y + root.img-h - 52px
        && area.mouse-y <= root.img-y + root.img-h - 12px;
    // The artist of an album card is a link (Electron `albumArtists` row).
    property <bool> artist-link: root.kind == 0 && root.card.artist-id > 0 && root.card.artist != "";
    width: root.size;
    height: card-col.preferred-height;

    card-col := VerticalLayout {
        spacing: 0px;
        alignment: start;

        Rectangle {
            width: root.size;
            height: root.art-h;

            Rectangle {
                x: root.img-x;
                y: root.img-y;
                width: root.img-w;
                height: root.img-h;
                // Square album covers (editorial); round artists; posters 6px.
                border-radius: root.kind == 1 ? root.size / 2 : root.poster ? 6px : 0px;
                background: root.card.cover.width == 0 ? Theme.raised : transparent;
                clip: true;

                if (root.kind == 1 || root.poster) && root.card.cover.width == 0: Text {
                    text: root.poster ? "作" : root.card.title == "" ? "?" : "♪";
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: root.size / 3;
                }

                Image {
                    source: root.card.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }

                Rectangle {
                    background: area.has-hover ? #00000059 : transparent;
                    animate background { duration: 120ms; }
                }

                if area.has-hover && root.has-play: Rectangle {
                    x: parent.width - 52px;
                    y: parent.height - 52px;
                    width: 40px;
                    height: 40px;
                    border-radius: 20px;
                    background: root.over-play ? Theme.accent.brighter(15%) : Theme.accent;
                    Icon {
                        kind: IconKind.play;
                        width: 16px;
                        height: 16px;
                        color: #ffffff;
                    }
                }

                if root.kind == 0 && root.card.disc-count > 1: Rectangle {
                    x: parent.width - 36px;
                    y: 0px;
                    width: 36px;
                    height: 36px;
                    Path {
                        width: 36px;
                        height: 36px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 36;
                        viewbox-height: 36;
                        fill: #00000088;
                        commands: "M 0 0 L 36 0 L 36 36 Z";
                    }
                    Path {
                        width: 36px;
                        height: 36px;
                        viewbox-x: 0;
                        viewbox-y: 0;
                        viewbox-width: 36;
                        viewbox-height: 36;
                        fill: #ffffff44;
                        commands: "M 0 0 L 10 10 L 0 10 Z";
                    }
                    Text {
                        x: 15px;
                        y: 4px;
                        width: 19px;
                        text: root.card.disc-count;
                        font-family: Fonts.family(self.text);
                        color: #ffffff;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                    }
                }

                if root.card.playing: Rectangle {
                    // Bottom-left playback state, independent of top metadata badges.
                    x: 8px;
                    y: parent.height - self.height - 8px;
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: Theme.bg.with-alpha(0.78);
                    drop-shadow-blur: 8px;
                    drop-shadow-color: #00000040;
                    PlayingBars {
                        width: 11px;
                        height: 11px;
                    }
                }

                if root.card.badge != "": Rectangle {
                    x: 8px;
                    y: 8px;
                    width: badge-text.preferred-width + 12px;
                    height: 20px;
                    border-radius: 5px;
                    background: #000000a0;
                    badge-text := Text {
                        text: root.card.badge;
                        font-family: Fonts.family(self.text);
                        color: #ffffff;
                        font-size: 12px;
                    }
                }
            }
        }

        Text {
            height: 12px + self.preferred-height;
            vertical-alignment: bottom;
            text: root.card.title;
            font-family: Fonts.family(self.text);
            color: Theme.text;
            font-size: 15px;
            font-weight: 650;
            overflow: elide;
            width: root.size;
            horizontal-alignment: root.center-meta ? center : left;
        }

        sub := HorizontalLayout {
            width: root.size;
            padding-top: 4px;
            alignment: root.center-meta ? center : start;
            ArtistLinks {
                fallback: root.card.artist;
                artists: root.kind == 0 ? root.card.artists : [];
                visible: root.card.artist != "";
                font-size: 13px;
                max-width: root.size;
                open(id) => { root.action("artist", id); }
            }
        }

        if root.card.year != "": Text {
            height: 3px + self.preferred-height;
            vertical-alignment: bottom;
            text: root.card.year;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 12.5px;
            font-weight: 500;
            overflow: elide;
            width: root.size;
            horizontal-alignment: root.center-meta ? center : left;
        }

        if root.card.note != "": Text {
            height: 3px + self.preferred-height;
            vertical-alignment: bottom;
            text: root.card.note;
            font-family: Fonts.family(self.text);
            color: Theme.accent-text;
            font-size: 12.5px;
            overflow: elide;
            width: root.size;
            horizontal-alignment: root.center-meta ? center : left;
        }

        if root.card.added != "": Text {
            height: 3px + self.preferred-height;
            vertical-alignment: bottom;
            text: root.card.added;
            font-family: Fonts.family(self.text);
            color: Theme.text-faint;
            font-size: 12px;
            font-weight: 500;
            overflow: elide;
            width: root.size;
            horizontal-alignment: root.center-meta ? center : left;
        }
    }

    ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.action("play", 0);
                }
            }
            MenuItem {
                title: "随机播放";
                activated => {
                    root.action("shuffle", 0);
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.action("next", 0);
                }
            }
            MenuItem {
                title: "添加到队列末尾";
                activated => {
                    root.action("last", 0);
                }
            }
            if root.kind != 2 && root.kind != 4: Menu {
                title: "添加到歌单";
                MenuItem {
                    title: "新建歌单…";
                    activated => {
                        root.action("new-playlist", 0);
                    }
                }
                for p in root.playlists: MenuItem {
                    title: p.name;
                    activated => {
                        root.action("add", p.id);
                    }
                }
            }
            if root.kind < 2: MenuItem {
                title: root.card.favorite ? "取消收藏" : "收藏";
                activated => {
                    root.action("favorite", root.card.favorite ? 0 : 1);
                }
            }
            if root.kind == 0 && root.card.artist-id > 0: MenuItem {
                title: "转到艺人";
                activated => {
                    root.action("artists", root.card.artist-id);
                }
            }
            if root.kind == 2: MenuItem {
                title: "删除歌单";
                activated => {
                    root.action("delete", 0);
                }
            }
        }

        area := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.action(root.over-play ? "play" : "open", 0);
            }
        }
    }

}

// Virtualized grid of cards; the rows come from a Rust model that chunks
// the items by `columns` and loads covers for visible rows only.
export component CardGrid inherits Rectangle {
    in property <[AlbumRow]> rows;
    in-out property <length> scroll-y;
    in property <int> kind;
    in property <[PlaylistChoice]> playlists;
    in property <string> empty-text: "没有内容";
    in property <bool> loading;
    // Columns and the card size (logical) whenever the layout changes.
    callback layout-changed(int, length);
    // (action, card id, argument)
    callback action(string, int, int);
    // Cards at least 200px (posters 160) with 26px gaps inside the page
    // padding; the columns then share the width.
    property <length> pad: Shell.pad;
    property <length> gap: Shell.tier == 2 ? 26px : 22px;
    property <length> row-gap: Shell.tier == 2 ? 36px : 28px;
    property <length> min-card: root.kind == 3 || root.kind == 4 ? 160px : 200px;
    out property <int> columns: max(1, floor((self.width - 2 * root.pad + root.gap) / (root.min-card + root.gap)));
    // Whole physical pixels, so covers decoded at this size draw 1:1.
    out property <length> card-size: floor(((self.width - 2 * root.pad - (root.columns - 1) * root.gap) / root.columns) / 1phx) * 1phx;
    changed card-size => {
        root.layout-changed(root.columns, root.card-size);
    }
    init => {
        root.layout-changed(root.columns, root.card-size);
    }

    if root.rows.length == 0: Text {
        text: root.loading ? "加载中…" : root.empty-text;
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
    }

    ListView {
        content-y <=> root.scroll-y;
        for row in root.rows: HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            spacing: root.gap;
            alignment: start;
            // Cover, three text lines (title, artist, year) and the row gap.
            height: (root.kind == 3 || root.kind == 4 ? root.card-size * 1.5 : root.card-size) + 72px + (root.kind == 3 || root.kind == 4 ? 19px : 0px) + root.row-gap;
            for card in row.items: CardView {
                card: card;
                kind: root.kind;
                size: root.card-size;
                playlists: root.playlists;
                action(what, arg) => {
                    root.action(what, card.id, arg);
                }
            }
        }
    }
}

// Column widths shared by the track header and rows.
export global TrackColumns {
    out property <length> number: 44px;
    out property <length> heart: 40px;
    out property <length> duration: 64px;
}

// One track row. `mode`: 0 list, 1 album (track numbers, no album
// column), 2 playlist (removable, draggable), 3 history (`note` instead
// of the album), 4 daily mix (不再推荐 button).
export component TrackRowView inherits Rectangle {
    in property <TrackRow> track;
    in property <int> mode;
    in property <bool> playing;
    in property <[PlaylistChoice]> playlists;
    in property <length> title-w;
    in property <length> artist-w;
    in property <length> album-w;
    // Drop marker above (-1) / below (1) the row while dragging.
    in property <int> drop-mark;
    // (action, argument)
    callback action(string, int);
    // Drag in progress: rows moved from the press point (playlist mode).
    callback drag(int);
    callback drop();
    property <length> press-y;
    property <bool> dragging;
    // Album and playlist pages show the credits under the title.
    property <bool> two-line: (root.mode == 1 || root.mode == 2) && root.track.credits.length > 0;
    // Side padding (the page's).
    in property <length> pad: Shell.pad;
    property <bool> roomy: root.mode == 1 || root.mode == 2;
    height: root.two-line ? 64px : root.roomy ? 58px : 50px;

    // Hover / current row (accent wash) and the rule under the row.
    Rectangle {
        x: root.pad - 14px;
        width: root.width - 2 * root.pad + 28px;
        border-radius: 8px;
        background: root.dragging ? Theme.accent-dim
            : root.playing ? @linear-gradient(90deg, Theme.accent-dim 0%, Theme.accent-dim.with-alpha(0) 100%)
            : row-area.has-hover ? Theme.surface-hover : transparent;
    }
    if !root.playing: Rectangle {
        x: root.pad;
        y: root.height - 1px;
        width: root.width - 2 * root.pad;
        height: 1px;
        background: Theme.border;
    }

    // TouchAreas consume right clicks, so each interactive child forwards
    // them explicitly to the shared row menu.
    property <length> menu-x;
    property <length> menu-y;
    function row-menu(e: PointerEvent, x: length, y: length) {
        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down {
            root.menu-x = x;
            root.menu-y = y;
            track-popup.show();
        }
    }
    function menu-action(action: string, arg: int) {
        track-popup.close();
        playlist-popup.close();
        root.action(action, arg);
    }
    // Slint sizes a popup once when it is shown and a plain click inside
    // closes it, so the playlist list is a second popup opened in place
    // of the main menu instead of a page swapped inside it.
    track-popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 240px;
        height: 12px + (9 + (root.mode == 2 ? 1 : 0) + (root.track.version-count > 1 ? 1 : 0)) * 34px;
        Rectangle {
            background: Theme.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                VerticalLayout {
                    TrackMenuItem { text: "播放"; triggered => { root.menu-action("play", 0); } }
                    TrackMenuItem { text: "下一首播放"; triggered => { root.menu-action("next", 0); } }
                    TrackMenuItem { text: "添加到播放队列末尾"; triggered => { root.menu-action("last", 0); } }
                    TrackMenuItem { text: "添加到歌单 ›"; triggered => { track-popup.close(); playlist-popup.show(); } }
                    TrackMenuItem { text: root.track.favorite ? "取消收藏" : "收藏"; triggered => { root.menu-action("favorite", root.track.favorite ? 0 : 1); } }
                    if root.track.version-count > 1: TrackMenuItem { text: "同名演奏版本"; triggered => { root.menu-action("versions", 0); } }
                    TrackMenuItem { text: "相似歌曲"; triggered => { root.menu-action("similar", 0); } }
                    TrackMenuItem { text: "查看信息"; triggered => { root.menu-action("info", 0); } }
                    TrackMenuItem { text: "转到专辑"; triggered => { root.menu-action("album", root.track.album-id); } }
                    TrackMenuItem { text: "转到艺人"; triggered => { root.menu-action("artists", root.track.artist-id); } }
                    if root.mode == 2: TrackMenuItem { text: "从歌单移除"; triggered => { root.menu-action("remove", 0); } }
                }
            }
        }
    }
    // Clicks on the scroll bar must not close the list.
    playlist-popup := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 240px;
        height: min(380px, 12px + (2 + root.playlists.length) * 34px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.raised;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                TrackMenuItem { text: "‹ 返回"; triggered => { playlist-popup.close(); track-popup.show(); } }
                TrackMenuItem { text: "新建歌单…"; triggered => { root.menu-action("new-playlist", 0); } }
                if root.playlists.length > 0: ScrollView {
                    VerticalLayout {
                        alignment: start;
                        for p in root.playlists: TrackMenuItem { text: p.name; triggered => { root.menu-action("add", p.id); } }
                    }
                }
            }
        }
    }
    track-menu := ContextMenuArea {
        Menu {
            MenuItem {
                title: "播放";
                activated => {
                    root.action("play", 0);
                }
            }
            MenuItem {
                title: "下一首播放";
                activated => {
                    root.action("next", 0);
                }
            }
            MenuItem {
                title: "添加到播放队列末尾";
                activated => {
                    root.action("last", 0);
                }
            }
            Menu {
                title: "添加到歌单";
                MenuItem {
                    title: "新建歌单…";
                    activated => {
                        root.action("new-playlist", 0);
                    }
                }
                for p in root.playlists: MenuItem {
                    title: p.name;
                    activated => {
                        root.action("add", p.id);
                    }
                }
            }
            MenuItem {
                title: root.track.favorite ? "取消收藏" : "收藏";
                activated => {
                    root.action("favorite", root.track.favorite ? 0 : 1);
                }
            }
            if root.track.version-count > 1: MenuItem {
                title: "同名演奏版本";
                activated => {
                    root.action("versions", 0);
                }
            }
            MenuItem {
                title: "相似歌曲";
                activated => {
                    root.action("similar", 0);
                }
            }
            MenuItem {
                title: "查看信息";
                activated => {
                    root.action("info", 0);
                }
            }
            if root.track.album-id > 0: MenuItem {
                title: "转到专辑";
                activated => {
                    root.action("album", root.track.album-id);
                }
            }
            if root.track.artist-id > 0: MenuItem {
                title: "转到艺人";
                activated => {
                    root.action("artists", root.track.artist-id);
                }
            }
            if root.mode == 2: MenuItem {
                title: "从歌单移除";
                activated => {
                    root.action("remove", 0);
                }
            }
        }

        row-area := TouchArea {
            double-clicked => {
                if !root.track.disabled {
                    root.action("play", 0);
                }
            }
            pointer-event(e) => {
                root.row-menu(e, self.mouse-x, self.mouse-y);
                if root.mode == 2 && e.button == PointerEventButton.left {
                    if e.kind == PointerEventKind.down {
                        root.press-y = self.mouse-y;
                    }
                    if e.kind == PointerEventKind.up && root.dragging {
                        root.dragging = false;
                        root.drop();
                    }
                }
            }
            moved => {
                if root.mode == 2 && self.pressed && (root.dragging || abs(self.mouse-y - root.press-y) > 6px) {
                    root.dragging = true;
                    root.drag(round((self.mouse-y - root.press-y) / root.height));
                }
            }
        }
    }

    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        spacing: 16px;
        Rectangle {
            width: TrackColumns.number;
            if !root.playing && root.mode != 1: Text {
                x: 0;
                text: root.track.index + 1;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 14px;
                font-weight: 600;
                vertical-alignment: center;
            }
            if !root.playing && root.mode == 1: Rectangle {
                x: 0;
                y: (parent.height - self.height) / 2;
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: row-play-area.has-hover ? Theme.accent : Theme.accent.with-alpha(row-area.has-hover ? 0.85 : 0.65);
                opacity: root.track.disabled ? 0.35 : 1.0;
                Icon {
                    kind: IconKind.play;
                    width: 10px;
                    height: 10px;
                    color: #ffffff;
                }
                row-play-area := TouchArea {
                    enabled: !root.track.disabled;
                    mouse-cursor: pointer;
                    pointer-event(e) => { root.row-menu(e, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y); }
                    clicked => {
                        root.action("play", 0);
                    }
                }
            }
            if root.playing: PlayingBars {
                x: 2px;
                width: 15px;
                height: 14px;
                bar-color: Theme.accent-text;
            }
        }
        VerticalLayout {
            width: root.title-w;
            alignment: center;
            spacing: 2px;
            // Title, then the "◆ OP" chip and the tag right after it.
            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: root.track.title;
                    font-family: Fonts.family(self.text);
                    color: root.track.disabled || root.track.blocked ? Theme.text-faint : root.playing ? Theme.accent-text : Theme.text;
                    font-size: root.roomy ? 16px : 15px;
                    font-weight: 550;
                    overflow: elide;
                    vertical-alignment: center;
                }
                // "◆ OP": the track is used in a work (click: the work).
                if root.track.tieup != "": Rectangle {
                    property <bool> hot: tieup-area.has-hover || tieup-area.previewing;
                    width: tieup-row.preferred-width;
                    height: 24px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 12px;
                    background: self.hot ? Theme.accent.with-alpha(0.3) : Theme.accent-dim;
                    border-width: self.hot ? 1px : 0px;
                    border-color: Theme.accent-text.with-alpha(0.55);
                    tieup-row := HorizontalLayout {
                        padding-left: 9px;
                        padding-right: 9px;
                        spacing: 6px;
                        Text {
                            text: "◆";
                            color: tieup-area.has-hover || tieup-area.previewing ? Theme.text : Theme.accent-text;
                            font-size: 9px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.track.tieup;
                            font-family: Fonts.family(self.text);
                            color: tieup-area.has-hover || tieup-area.previewing ? Theme.text : Theme.accent-text;
                            font-size: 11.5px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                        if root.track.tieup-count > 1: Text {
                            text: root.track.tieup-count;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-dim;
                            font-size: 11.5px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                    tieup-badge := Rectangle {
                        width: 0px;
                        height: 0px;
                        property <bool> card-hovered;
                        changed card-hovered => {
                            if self.card-hovered {
                                hover-close.running = false;
                            } else if tieup-area.previewing && !tieup-area.has-hover {
                                hover-close.running = true;
                            }
                        }
                    }
                    tieup-popup := PopupWindow {
                        x: 0px;
                        y: parent.height + 8px;
                        popup-cards := TieupCards {
                            works: root.track.tieup-works;
                            changed hovered => { tieup-badge.card-hovered = self.hovered; }
                            open-work(id) => {
                                hover-open.running = false;
                                hover-close.running = false;
                                tieup-area.previewing = false;
                                tieup-badge.card-hovered = false;
                                tieup-popup.close();
                                root.action("work", id);
                            }
                        }
                    }
                    hover-open := Timer {
                        running: false;
                        interval: 150ms;
                        triggered => {
                            self.running = false;
                            if tieup-area.has-hover {
                                tieup-area.previewing = true;
                                tieup-popup.show();
                            }
                        }
                    }
                    hover-close := Timer {
                        running: false;
                        interval: 180ms;
                        triggered => {
                            self.running = false;
                            if tieup-area.previewing && !tieup-area.has-hover && !tieup-badge.card-hovered {
                                tieup-popup.close();
                                tieup-area.previewing = false;
                            }
                        }
                    }
                    tieup-area := TouchArea {
                        // Avoid the native Tooltip's extra background and padding.
                        property <bool> previewing;
                        changed has-hover => {
                            if self.has-hover {
                                hover-close.running = false;
                                if !self.previewing { hover-open.running = true; }
                            } else {
                                hover-open.running = false;
                                if self.previewing && !tieup-badge.card-hovered { hover-close.running = true; }
                            }
                        }
                        pointer-event(e) => {
                            root.row-menu(e, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y);
                        }
                        mouse-cursor: pointer;
                        clicked => {
                            hover-open.running = false;
                            hover-close.running = false;
                            tieup-area.previewing = true;
                            tieup-popup.show();
                        }
                    }
                }
                if root.track.tag != "": Rectangle {
                    width: tag-text.preferred-width + 14px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: root.track.tag-accent ? Theme.accent-dim : Theme.raised;
                    tag-text := Text {
                        text: root.track.tag;
                        font-family: Fonts.family(self.text);
                        color: root.track.tag-accent ? Theme.accent-text : Theme.text-dim;
                        font-size: 11.5px;
                        font-weight: 700;
                    }
                }
            }
                // Credits: names link to the artist (web album page).
                // Fixed min / preferred width: a long credits line must not
                // widen the title column (it is clipped at the column edge).
                if root.two-line: Rectangle {
                    height: 20px;
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    clip: true;
                    HorizontalLayout {
                        x: 0;
                        width: self.preferred-width;
                        alignment: start;
                        for part in root.track.credits: Text {
                            text: part.text;
                            font-family: Fonts.family(self.text);
                            color: part.id > 0 && credit-area.has-hover ? Theme.accent-text : Theme.text-faint;
                            font-size: 12.5px;
                            vertical-alignment: bottom;
                            credit-area := TouchArea {
                                pointer-event(e) => { root.row-menu(e, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y); }
                                enabled: part.id > 0;
                                mouse-cursor: part.id > 0 ? pointer : default;
                                clicked => {
                                    root.action("artist", part.id);
                                }
                            }
                        }
                    }
                }
        }
        // Artist and album link to their pages (the text only, not the
        // empty part of the column).
        ArtistLinks {
            width: root.artist-w;
            artists: root.track.artists;
            fallback: root.track.artist;
            open(id) => { root.action("artist", id); }
        }
        if root.mode != 1: album-col := Rectangle {
            width: root.album-w;
            property <bool> link: root.mode != 3 && root.track.album-id > 0;
            Text {
                x: 0;
                width: min(self.preferred-width, root.album-w);
                text: root.mode == 3 ? root.track.note : root.track.album;
                font-family: Fonts.family(self.text);
                color: album-col.link && album-area.has-hover ? Theme.accent-text : Theme.text-dim;
                font-size: 14px;
                overflow: elide;
                vertical-alignment: center;
                album-area := TouchArea {
                    pointer-event(e) => { root.row-menu(e, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y); }
                    enabled: album-col.link;
                    mouse-cursor: album-col.link ? pointer : default;
                    clicked => {
                        root.action("album", root.track.album-id);
                    }
                }
            }
        }
        if root.mode == 4: Rectangle {
            width: 64px;
            Text {
                text: root.track.blocked ? "已不再推荐" : "不再推荐";
                font-family: Fonts.family(self.text);
                color: root.track.blocked ? Theme.accent-text : block-area.has-hover ? Theme.text : Theme.text-faint;
                font-size: 12px;
                visible: root.track.blocked || row-area.has-hover || block-area.has-hover;
            }
            block-area := TouchArea {
                pointer-event(e) => { root.row-menu(e, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y); }
                mouse-cursor: pointer;
                clicked => {
                    root.action("block", root.track.blocked ? 0 : 1);
                }
            }
        }
        Rectangle {
            width: 46px;
            if root.track.version-count > 1: HorizontalLayout {
                alignment: center;
                spacing: 5px;
                Icon {
                    y: (parent.height - self.height) / 2;
                    kind: IconKind.versions;
                    width: 18px;
                    height: 18px;
                    stroke-width: 1.35px;
                    color: versions-area.has-hover ? Theme.accent : Theme.accent-text.with-alpha(0.9);
                }
                Text {
                    text: root.track.version-count;
                    font-family: Fonts.family(self.text);
                    color: versions-area.has-hover ? Theme.accent : Theme.accent-text.with-alpha(0.9);
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
            versions-area := TouchArea {
                enabled: root.track.version-count > 1;
                pointer-event(e) => { root.row-menu(e, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y); }
                mouse-cursor: root.track.version-count > 1 ? pointer : default;
                clicked => {
                    root.action("versions", 0);
                }
            }
        }
        Rectangle {
            width: TrackColumns.heart;
            Icon {
                visible: root.track.favorite || row-area.has-hover || heart-area.has-hover;
                kind: root.track.favorite ? IconKind.heart : IconKind.heart-outline;
                width: 17px;
                height: 17px;
                color: root.track.favorite ? Theme.accent-text : heart-area.has-hover ? Theme.text : Theme.text-faint;
            }
            heart-area := TouchArea {
                pointer-event(e) => { root.row-menu(e, self.absolute-position.x - root.absolute-position.x + self.mouse-x, self.absolute-position.y - root.absolute-position.y + self.mouse-y); }
                mouse-cursor: pointer;
                clicked => {
                    root.action("favorite", root.track.favorite ? 0 : 1);
                }
            }
        }
        Text {
            text: root.track.duration;
            font-family: Fonts.family(self.text);
            width: TrackColumns.duration;
            color: Theme.text-dim;
            font-size: 14px;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    if root.drop-mark != 0: Rectangle {
        x: root.pad;
        width: root.width - 2 * root.pad;
        y: root.drop-mark < 0 ? 0 : parent.height - 2px;
        height: 2px;
        background: Theme.accent;
    }

}

// Track list with a column header. `mode` as in `TrackRowView`.
export component TrackList inherits Rectangle {
    in property <[TrackRow]> rows;
    in-out property <length> scroll-y;
    in property <int> mode;
    in property <int> playing-id: -1;
    in property <[PlaylistChoice]> playlists;
    in property <string> empty-text: "没有曲目";
    in property <bool> loading;
    in property <bool> multi-disc;
    // (action, row index, argument)
    callback action(string, int, int);
    // Page side padding, fixed columns, gaps of 16px.
    in property <length> pad: Shell.pad;
    property <length> flex: max(0px, self.width - 2 * root.pad - TrackColumns.number - 46px - TrackColumns.heart - TrackColumns.duration - 96px - (root.mode == 4 ? 80px : 0px));
    // Album pages: artist column up to 316 (less when narrow).
    property <length> artist-w: root.mode == 1 ? min(316px, root.flex * 0.40) - 16px : root.flex * 0.24;
    property <length> title-w: root.mode == 1 ? root.flex - 16px - root.artist-w : root.flex * 0.42;
    property <length> album-w: root.flex * 0.34;
    // Playlist drag and drop: dragged row and where it would land.
    property <int> drag-from: -1;
    property <int> drop-at: -1;

    VerticalLayout {
        HorizontalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            height: 40px;
            spacing: 16px;
            Text { text: root.mode == 1 ? "" : "#"; width: TrackColumns.number; color: Theme.text-faint; font-size: 12.5px; vertical-alignment: center; }
            Text { text: "标题"; width: root.title-w; color: Theme.text-faint; font-size: 12.5px; vertical-alignment: center; }
            Text { text: "艺人"; width: root.artist-w; color: Theme.text-faint; font-size: 12.5px; vertical-alignment: center; }
            if root.mode != 1: Text { text: root.mode == 3 ? "播放记录" : "专辑"; width: root.album-w; color: Theme.text-faint; font-size: 12.5px; vertical-alignment: center; }
            if root.mode == 4: Rectangle { width: 64px; }
            Rectangle { width: 46px; }
            Rectangle { width: TrackColumns.heart; }
            Text { text: "时长"; width: TrackColumns.duration; color: Theme.text-faint; font-size: 12.5px; horizontal-alignment: right; vertical-alignment: center; }
        }

        Rectangle {
            height: 1px;
            Rectangle {
                x: root.pad;
                width: parent.width - 2 * root.pad;
                background: Theme.border;
            }
        }

        if root.rows.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: root.loading ? "加载中…" : root.empty-text;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
            }
        }

        if root.rows.length > 0 && !(root.mode == 1 && root.multi-disc): ListView {
            vertical-stretch: 1;
            content-y <=> root.scroll-y;
            for track[i] in root.rows: TrackRowView {
                track: track;
                mode: root.mode;
                playing: track.id == root.playing-id;
                playlists: root.playlists;
                pad: root.pad;
                title-w: root.title-w;
                artist-w: root.artist-w;
                album-w: root.album-w;
                drop-mark: root.drag-from < 0 || root.drop-at != i || root.drop-at == root.drag-from ? 0 : root.drop-at < root.drag-from ? -1 : 1;
                action(what, arg) => {
                    root.action(what, track.index, arg);
                }
                drag(offset) => {
                    root.drag-from = i;
                    root.drop-at = max(0, min(root.rows.length - 1, i + offset));
                }
                drop => {
                    if root.drop-at >= 0 && root.drop-at != root.drag-from {
                        root.action("move", track.index, root.drop-at);
                    }
                    root.drag-from = -1;
                    root.drop-at = -1;
                }
            }
        }

        if root.rows.length > 0 && root.mode == 1 && root.multi-disc: ScrollView {
            vertical-stretch: 1;
            content-y <=> root.scroll-y;
            VerticalLayout {
                alignment: start;
                padding-bottom: 16px;
                for track[i] in root.rows: VerticalLayout {
                    if i == 0 || track.disc != root.rows[i - 1].disc: HorizontalLayout {
                        padding-left: root.pad;
                        padding-right: root.pad;
                        padding-top: i == 0 ? 12px : 20px;
                        padding-bottom: 8px;
                        spacing: 14px;
                        alignment: start;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: 16px;
                            background: disc-play-area.has-hover ? Theme.accent.brighter(15%) : Theme.accent;
                            Icon {
                                kind: IconKind.play;
                                width: 13px;
                                height: 13px;
                                color: #ffffff;
                            }
                            disc-play-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.action("play-disc", track.index, track.disc);
                                }
                            }
                        }
                        Text {
                            text: "Disc " + track.disc;
                            font-family: Fonts.family(self.text);
                            color: Theme.text;
                            font-size: 15.5px;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                    }
                    TrackRowView {
                        track: track;
                        mode: root.mode;
                        playing: track.id == root.playing-id;
                        playlists: root.playlists;
                        pad: root.pad;
                        title-w: root.title-w;
                        artist-w: root.artist-w;
                        album-w: root.album-w;
                        action(what, arg) => {
                            root.action(what, track.index, arg);
                        }
                    }
                }
            }
        }
    }
}

export component QueuePanel inherits Rectangle {
    in property <[QueueRow]> rows;
    // Entries in the whole queue (`rows` may be filtered).
    in property <int> total;
    in property <int> current: -1;
    // The search text (rows are filtered in Rust; no dragging then).
    in-out property <string> search;
    callback search-changed(string);
    callback play(int);
    callback remove(int);
    callback clear();
    // Save the queue as a new playlist.
    callback save();
    // (uid, new play-order position)
    callback move(int, int);
    property <int> drag-from: -1;
    property <int> drop-at: -1;
    // The right panel tab hides the title row.
    in property <bool> show-title: true;
    in property <length> side-padding: 16px;
    background: Theme.surface;

    function locate() {
        if root.current >= 0 {
            list.content-y = -min(max(0px, root.current * 56px - (list.visible-height - 56px) / 2), max(0px, list.content-height - list.visible-height));
        }
    }

    if root.rows.length == 0: Text {
        y: 120px;
        width: root.width;
        horizontal-alignment: center;
        text: root.search != "" ? "没有匹配的曲目" : "队列为空";
        font-family: Fonts.family(self.text);
        color: Theme.text-faint;
    }

    VerticalLayout {
        // Toolbar (Electron `play-queue-list-controls`): the title only
        // outside the right panel (its tab says "队列").
        if root.show-title: HorizontalLayout {
            padding-left: root.side-padding;
            padding-right: root.side-padding - 8px;
            padding-top: 10px;
            padding-bottom: 4px;
            spacing: 2px;
            Text {
                text: "播放队列";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Text {
                text: root.total == 0 ? "" : "  " + root.total + " 首";
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 13px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            padding-left: root.side-padding;
            padding-right: root.side-padding - 6px;
            padding-top: root.show-title ? 4px : 6px;
            padding-bottom: 8px;
            spacing: 2px;
            SearchField {
                height: 32px;
                placeholder: "搜索队列";
                text <=> root.search;
                edited => {
                    root.search-changed(self.text);
                }
                accepted => {
                    root.search-changed(self.text);
                }
            }
            Rectangle {
                width: 4px;
            }
            IconButton {
                kind: IconKind.locate;
                size: 32px;
                icon-size: 17px;
                enabled: root.current >= 0;
                clicked => {
                    root.locate();
                }
            }
            IconButton {
                kind: IconKind.playlist-add;
                size: 32px;
                icon-size: 17px;
                enabled: root.total > 0;
                clicked => {
                    root.save();
                }
            }
            IconButton {
                kind: IconKind.trash;
                size: 32px;
                icon-size: 17px;
                enabled: root.total > 0;
                clicked => {
                    root.clear();
                }
            }
        }
        Rectangle {
            height: 1px;
            Rectangle {
                x: root.side-padding;
                width: parent.width - 2 * root.side-padding;
                background: Theme.border;
            }
        }

        list := ListView {
            for row[i] in root.rows: Rectangle {
                property <length> press-y;
                property <bool> dragging: root.drag-from == i;
                height: 56px;
                background: self.dragging ? Theme.accent-dim : i == root.current ? Theme.accent-dim : area.has-hover ? Theme.surface-hover : transparent;

                area := TouchArea {
                    double-clicked => {
                        root.play(row.uid);
                    }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left {
                            if e.kind == PointerEventKind.down {
                                parent.press-y = self.mouse-y;
                            }
                            if e.kind == PointerEventKind.up && root.drag-from == i {
                                if root.drop-at >= 0 && root.drop-at != i {
                                    root.move(row.uid, root.drop-at);
                                }
                                root.drag-from = -1;
                                root.drop-at = -1;
                            }
                        }
                    }
                    moved => {
                        if self.pressed && root.search == "" && (root.drag-from == i || abs(self.mouse-y - parent.press-y) > 6px) {
                            root.drag-from = i;
                            root.drop-at = max(0, min(root.rows.length - 1, i + round((self.mouse-y - parent.press-y) / parent.height)));
                        }
                    }
                }

                if root.drag-from >= 0 && root.drop-at == i && i != root.drag-from: Rectangle {
                    y: root.drop-at < root.drag-from ? 0 : parent.height - 2px;
                    height: 2px;
                    background: Theme.accent;
                }

                // Electron queue table: number, cover, title / artist, time.
                HorizontalLayout {
                    padding-left: root.side-padding - 10px;
                    padding-right: root.side-padding - 6px;
                    spacing: 10px;
                    Rectangle {
                        width: 28px;
                        if i != root.current: Text {
                            text: row.number;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-faint;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        if i == root.current: PlayingBars {
                            width: 12px;
                            height: 11px;
                        }
                    }
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        y: (parent.height - self.height) / 2;
                        Rectangle {
                            width: ArtFit.width(40px, 40px, row.cover);
                            height: ArtFit.height(40px, 40px, row.cover);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: 4px;
                            background: row.cover.width == 0 ? Theme.raised : transparent;
                            clip: true;
                            Image {
                                source: row.cover;
                                width: 100%;
                                height: 100%;
                                image-fit: ImageFit.cover;
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        Text {
                            text: row.title;
                            font-family: Fonts.family(self.text);
                            color: i == root.current ? Theme.accent-text : Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: row.artist;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-dim;
                            font-size: 12.5px;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: row.duration;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-faint;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 28px;
                        Icon {
                            visible: area.has-hover || remove-area.has-hover;
                            kind: IconKind.close;
                            width: 14px;
                            height: 14px;
                            color: remove-area.has-hover ? Theme.text : Theme.text-faint;
                        }
                        remove-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.remove(row.uid);
                            }
                        }
                    }
                }
            }
        }
    }
}

component LyricsTool inherits Rectangle {
    in property <string> text;
    in property <bool> has-icon;
    in property <IconKind> icon: IconKind.search;
    in property <bool> active;
    in property <bool> on-stage;
    callback clicked();
    height: 30px;
    width: max(30px, tool-row.preferred-width);
    border-radius: 8px;
    background: root.active ? Theme.accent-dim : area.has-hover ? (root.on-stage ? #ffffff1a : Theme.surface-hover) : transparent;
    tool-row := HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        alignment: center;
        if root.has-icon: Icon {
            kind: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            color: root.active ? Theme.accent-text : area.has-hover ? Theme.text : Theme.text-dim;
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.active ? Theme.accent-text : area.has-hover ? Theme.text : Theme.text-dim;
            font-size: 12.5px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component ToolSep inherits Rectangle {
    width: 9px;
    Rectangle {
        x: 4px;
        width: 1px;
        height: 14px;
        background: Theme.border;
    }
}

// Lyrics tools: search, offset (− value +; the value resets), translate,
// clear. Shared by the right panel (bottom) and the full-screen player.
export component LyricsTools inherits HorizontalLayout {
    in property <bool> synced;
    in property <bool> has-lines;
    in property <bool> can-search;
    in property <bool> can-translate;
    in property <bool> translation-shown;
    in property <bool> translating;
    in property <int> offset-ms;
    in property <bool> on-stage;
    // search, clear, translate
    callback tool(string);
    callback offset(int);
    spacing: 2px;
    alignment: center;
    height: 30px;
    if root.can-search: LyricsTool {
        has-icon: true;
        icon: IconKind.search;
        on-stage: root.on-stage;
        clicked => {
            root.tool("search");
        }
    }
    if root.can-search && root.synced: ToolSep { }
    if root.synced: LyricsTool {
        has-icon: true;
        icon: IconKind.minus;
        on-stage: root.on-stage;
        clicked => {
            root.offset(root.offset-ms - 50);
        }
    }
    if root.synced: Text {
        text: (root.offset-ms > 0 ? "+" : "") + root.offset-ms + " ms";
        font-family: Fonts.family(self.text);
        color: root.offset-ms == 0 ? Theme.text : Theme.accent-text;
        font-size: 12.5px;
        font-weight: 500;
        min-width: 44px;
        horizontal-alignment: center;
        vertical-alignment: center;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.offset(0);
            }
        }
    }
    if root.synced: LyricsTool {
        has-icon: true;
        icon: IconKind.plus;
        on-stage: root.on-stage;
        clicked => {
            root.offset(root.offset-ms + 50);
        }
    }
    if (root.can-search || root.synced) && (root.can-translate || (root.can-search && root.has-lines)): ToolSep { }
    if root.can-translate: LyricsTool {
        has-icon: true;
        icon: IconKind.lang;
        text: root.translating ? "翻译中…" : "翻译";
        active: root.translation-shown;
        on-stage: root.on-stage;
        clicked => {
            root.tool("translate");
        }
    }
    // Clears online lyrics.
    if root.can-search && root.has-lines: LyricsTool {
        has-icon: true;
        icon: IconKind.close;
        on-stage: root.on-stage;
        clicked => {
            root.tool("clear");
        }
    }
}

// Lyrics of the current track: synced lines follow playback (scrolling by
// hand pauses that for a few seconds), clicking a synced line seeks to it.
// `stage`: the full-screen lyrics column (left aligned, 44 / 34px);
// `large`: the full-screen lyrics tab (centered); otherwise the right
// panel. The tools sit at the bottom unless `show-tools` is off (the
// full-screen column has them in its header). `fades` with `fade` (the
// background color) fades the lines out at the top and bottom.
export component LyricsPanel inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> active: -1;
    in property <bool> synced;
    in property <string> source;
    in property <bool> has-track;
    in property <bool> can-search;
    in property <bool> can-translate;
    in property <bool> translation-shown;
    in property <bool> translating;
    in property <int> offset-ms;
    callback seek-line(int);
    // search, clear, translate; offset (ms)
    callback tool(string);
    callback offset(int);
    in property <bool> lines-have-translation;
    in property <bool> large;
    in property <bool> stage;
    in property <bool> show-tools: true;
    in property <color> fade: transparent;
    in property <bool> fades;
    in property <length> side-padding: 24px;
    property <bool> centered: root.large && !root.stage;
    property <length> line-size: root.stage ? 34px : root.large ? 26px : 17px;
    property <length> active-size: root.stage ? 44px : root.large ? 30px : 20px;
    property <length> tr-size: root.stage ? 19px : root.large ? 18px : 13px;
    property <length> tr-active-size: root.stage ? 21px : root.large ? 19px : 13px;
    property <length> gap: root.stage ? 22px : root.large ? 14px : 10px;
    property <color> dim-color: root.stage || root.large ? Theme.text.with-alpha(0.3) : Theme.text-faint;
    property <color> dim-tr-color: root.stage || root.large ? Theme.text.with-alpha(0.25) : Theme.text-faint;
    background: transparent;

    VerticalLayout {
        if root.lines.length == 0: Rectangle {
            vertical-stretch: 1;
            Text {
                text: root.has-track ? "暂无歌词" : "";
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
            }
        }

        // Synced lyrics: the active line stays at 42% of the height unless
        // the user scrolled in the last 4 seconds.
        if root.lines.length > 0 && root.synced: synced-flick := Flickable {
            vertical-stretch: 1;
            // Not from the content (its padding follows this height).
            min-height: 0px;
            max-height: 100000px;
            preferred-height: 0px;
            property <bool> follow: true;
            // Top of the active line in the column.
            property <length> target;
            function recenter() {
                self.content-y = -max(0px, min(self.target - self.height * 0.42, self.content-height - self.height));
            }
            content-height: synced-col.preferred-height;
            flicked => {
                self.follow = false;
                resume.restart();
            }
            resume := Timer {
                interval: 4s;
                running: false;
                triggered => {
                    self.running = false;
                    synced-flick.follow = true;
                    synced-flick.recenter();
                }
            }
            changed height => {
                if self.follow {
                    self.recenter();
                }
            }
            animate content-y { duration: 380ms; easing: ease-out; }

            synced-col := VerticalLayout {
                width: synced-flick.width;
                padding-top: synced-flick.height * 0.42;
                padding-bottom: synced-flick.height * 0.5;
                padding-left: root.side-padding - 8px;
                padding-right: root.side-padding - 8px;
                spacing: root.gap;
                for line[i] in root.lines: Rectangle {
                    property <bool> on: i == root.active;
                    function track() {
                        if self.on {
                            synced-flick.target = self.y;
                            if synced-flick.follow {
                                synced-flick.recenter();
                            }
                        }
                    }
                    init => {
                        self.track();
                    }
                    changed on => {
                        self.track();
                    }
                    changed y => {
                        self.track();
                    }
                    height: line-col.preferred-height;
                    border-radius: 8px;
                    background: line-area.has-hover ? (root.stage || root.large ? #ffffff0d : Theme.surface-hover) : transparent;
                    line-col := VerticalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: root.stage ? 6px : 3px;
                        Text {
                            text: line.text;
                            font-family: Fonts.family(self.text);
                            wrap: word-wrap;
                            horizontal-alignment: root.centered ? center : left;
                            font-size: on ? root.active-size : root.line-size;
                            font-weight: root.stage ? 780 : 700;
                            color: on ? Theme.text : root.dim-color;
                            animate color { duration: 300ms; }
                        }
                        if line.translation != "": Text {
                            text: line.translation;
                            font-family: Fonts.family(self.text);
                            wrap: word-wrap;
                            horizontal-alignment: root.centered ? center : left;
                            font-size: on ? root.tr-active-size : root.tr-size;
                            font-weight: root.stage ? 500 : 450;
                            color: on ? (root.stage || root.large ? Theme.text.with-alpha(0.75) : Theme.text-dim) : root.dim-tr-color;
                            animate color { duration: 300ms; }
                        }
                    }
                    line-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.seek-line(i);
                        }
                    }
                }
            }
        }

        // Plain lyrics: free scrolling.
        if root.lines.length > 0 && !root.synced: plain-flick := Flickable {
            vertical-stretch: 1;
            content-height: plain-col.preferred-height;
            plain-col := VerticalLayout {
                width: plain-flick.width;
                padding-left: root.side-padding;
                padding-right: root.side-padding;
                padding-top: 24px;
                padding-bottom: 24px;
                spacing: root.gap;
                for line in root.lines: VerticalLayout {
                    spacing: 3px;
                    Text {
                        text: line.text;
                        font-family: Fonts.family(self.text);
                        wrap: word-wrap;
                        horizontal-alignment: root.centered ? center : left;
                        font-size: root.line-size;
                        font-weight: 600;
                        color: Theme.text-dim;
                    }
                    if line.translation != "": Text {
                        text: line.translation;
                        font-family: Fonts.family(self.text);
                        wrap: word-wrap;
                        horizontal-alignment: root.centered ? center : left;
                        font-size: root.tr-size;
                        color: Theme.text-faint;
                    }
                }
            }
        }

        if root.has-track && root.show-tools: HorizontalLayout {
            padding-top: 6px;
            padding-bottom: 10px;
            alignment: center;
            LyricsTools {
                synced: root.synced;
                has-lines: root.lines.length > 0;
                can-search: root.can-search;
                can-translate: root.can-translate;
                translation-shown: root.translation-shown;
                translating: root.translating;
                offset-ms: root.offset-ms;
                on-stage: root.large || root.stage;
                tool(what) => {
                    root.tool(what);
                }
                offset(ms) => {
                    root.offset(ms);
                }
            }
        }
    }

    // Fades at the top and bottom of the lines (Slint has no masks).
    if root.fades && root.lines.length > 0: Rectangle {
        y: 0;
        height: min(64px, root.height * 0.14);
        background: @linear-gradient(180deg, root.fade 0%, root.fade.with-alpha(0) 100%);
    }
    if root.fades && root.lines.length > 0: Rectangle {
        y: root.height - self.height - (root.has-track && root.show-tools ? 46px : 0px);
        height: min(64px, root.height * 0.14);
        background: @linear-gradient(0deg, root.fade 0%, root.fade.with-alpha(0) 100%);
    }
}

// Player bar button (36px hot area, icon 20; `chip`: a filled pill with a
// label, for the exclusive / sleep states).
component BarButton inherits Rectangle {
    in property <IconKind> icon;
    in property <string> text;
    in property <bool> on;
    in property <bool> chip;
    in property <bool> enabled: true;
    in property <length> icon-size: 20px;
    callback clicked();
    height: 36px;
    width: max(36px, bar-row.preferred-width);
    border-radius: 10px;
    background: root.chip ? (bar-area.has-hover ? Theme.accent-dim.with-alpha(0.3) : Theme.accent-dim) : bar-area.has-hover ? Theme.surface-hover : transparent;
    opacity: root.enabled ? 1 : 0.5;
    bar-row := HorizontalLayout {
        padding-left: root.text == "" ? 8px : 9px;
        padding-right: root.text == "" ? 8px : 10px;
        spacing: 7px;
        alignment: center;
        Icon {
            kind: root.icon;
            width: root.chip ? 17px : root.icon-size;
            height: root.chip ? 17px : root.icon-size;
            y: (parent.height - self.height) / 2;
            color: root.on || root.chip ? Theme.accent-text : bar-area.has-hover ? Theme.text : Theme.text-dim;
        }
        if root.text != "": Text {
            text: root.text;
            font-family: Fonts.family(self.text);
            color: root.on || root.chip ? Theme.accent-text : Theme.text-dim;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    bar-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A row of the 投放 menu: this computer or a Sonos room.
component CastMenuRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <bool> active;
    in property <IconKind> icon: IconKind.speaker;
    callback clicked();
    height: 44px;
    border-radius: 6px;
    background: row-area.has-hover ? Theme.surface-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        Icon {
            kind: root.active ? IconKind.check : root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            color: root.active ? Theme.accent-text : Theme.text-dim;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.name;
                font-family: Fonts.family(self.text);
                color: root.active ? Theme.accent-text : Theme.text;
                font-size: 13.5px;
                font-weight: root.active ? 600 : 400;
                overflow: elide;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 11.5px;
                overflow: elide;
            }
        }
    }
    row-area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component BarSep inherits Rectangle {
    width: 17px;
    Rectangle {
        x: 8px;
        width: 1px;
        height: 22px;
        background: Theme.border;
    }
}

// Bottom player bar across the window: now playing (left), transport and
// progress (center, 820 / 600 / 480 wide by `tier`), then [exclusive,
// cast, sleep] | [lyrics, queue, full screen] | [volume].
export component PlayerBar inherits Rectangle {
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <[CreditPart]> artists;
    in property <string> album;
    in property <string> quality;
    in property <image> cover;
    // The right panel shows the cover: the bar leaves it out (D4).
    in property <bool> show-cover: true;
    // Window breakpoint: 2 wide, 1 medium, 0 narrow.
    in property <int> tier: 2;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <string> position-text;
    in property <string> duration-text;
    in property <bool> paused: true;
    in property <bool> buffering;
    in property <float> volume: 100;
    in property <bool> lyrics-open;
    in property <bool> queue-open;
    in property <bool> shuffle;
    // 0 off, 1 all, 2 one.
    in property <int> repeat;
    in property <bool> favorite;
    callback toggle-favorite();
    callback open-album();
    callback open-artist(int);
    // Exclusive output (WASAPI / ASIO), switchable while playing; `exclusive-busy`
    // while a change is applied.
    in property <bool> exclusive;
    in property <int> exclusive-mode;
    in property <bool> asio-available;
    in property <bool> asio-fallback;
    in property <bool> exclusive-busy;
    callback toggle-exclusive(bool);
    callback select-exclusive-mode(int);
    in property <bool> sleep-active;
    // Remaining time or the mode, next to the button.
    in property <string> sleep-label;
    // (0 off, 1 end of track, 2 end of album, 3 minutes; minutes)
    callback set-sleep(int, int);
    callback toggle-pause();
    callback toggle-queue();
    callback toggle-shuffle();
    callback cycle-repeat();
    callback next();
    callback previous();
    callback seek(int);
    callback volume-changed(float);
    callback toggle-lyrics();
    // The cover and the expand button open / close the full-screen player.
    in property <bool> full-open;
    callback toggle-full();
    property <length> pad: root.tier == 2 ? 24px : root.tier == 1 ? 16px : 14px;
    // Center column; narrow windows keep about 560px for the sides.
    property <length> center-w: max(300px, min(root.tier == 2 ? 820px : root.tier == 1 ? 600px : 480px, root.width - 2 * root.pad - 32px - 560px));
    property <length> side-w: (root.width - 2 * root.pad - 32px - root.center-w) / 2;
    // The right group: compact when narrow (shorter volume, icon-only chips).
    property <bool> compact: root.side-w < 460px;
    property <bool> tight: root.side-w < 300px;
    height: root.tier == 2 ? 92px : root.tier == 1 ? 84px : 80px;
    background: Theme.chrome;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
    padding-left: root.pad;
    padding-right: root.pad;
    spacing: 16px;

    // Now playing.
    HorizontalLayout {
        horizontal-stretch: 1;
        min-width: 0px;
        spacing: 14px;
        alignment: start;
        if root.show-cover: Rectangle {
            width: 56px;
            height: 56px;
            y: (parent.height - self.height) / 2;
            Rectangle {
                width: ArtFit.width(56px, 56px, root.cover);
                height: ArtFit.height(56px, 56px, root.cover);
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: root.cover.width == 0 ? Theme.raised : transparent;
                clip: true;
                Image {
                    source: root.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
                cover-area := TouchArea {
                    enabled: root.has-track;
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-full();
                    }
                }
                if cover-area.has-hover: Rectangle {
                    background: #00000066;
                    Icon {
                        kind: root.full-open ? IconKind.chevron-down : IconKind.expand;
                        width: 20px;
                        height: 20px;
                        color: #ffffff;
                    }
                }
            }
        }

        // Title with the heart, then the quality tag and "artist · album".
        VerticalLayout {
            alignment: center;
            spacing: 5px;
            horizontal-stretch: 1;
            min-width: 0px;
            HorizontalLayout {
                alignment: start;
                spacing: 10px;
                Text {
                    text: root.has-track ? root.title : "未在播放";
                    font-family: Fonts.family(self.text);
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 650;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if root.has-track: Rectangle {
                    width: 22px;
                    Icon {
                        kind: root.favorite ? IconKind.heart : IconKind.heart-outline;
                        width: 18px;
                        height: 18px;
                        color: root.favorite || fav-area.has-hover ? Theme.accent-text : Theme.text-dim;
                    }
                    fav-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.toggle-favorite();
                        }
                    }
                }
            }
            if root.has-track: HorizontalLayout {
                spacing: 10px;
                if root.quality != "": Rectangle {
                    horizontal-stretch: 0;
                    width: quality-text.preferred-width + 14px;
                    height: 20px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 5px;
                    background: Theme.raised;
                    quality-text := Text {
                        text: root.quality;
                        font-family: Fonts.family(self.text);
                        color: Theme.text-dim;
                        font-size: 11.5px;
                        font-weight: 600;
                    }
                }
                HorizontalLayout {
                    min-width: 0px;
                    horizontal-stretch: 1;
                    alignment: start;
                    ArtistLinks {
                        fallback: root.artist;
                        artists: root.artists;
                        font-size: 13.5px;
                        open(id) => { root.open-artist(id); }
                    }
                    if root.album != "": Text {
                        text: " · ";
                        color: Theme.text-dim;
                        font-size: 13.5px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    if root.album != "": Text {
                        text: root.album;
                        font-family: Fonts.family(self.text);
                        color: album-area.has-hover ? Theme.text : Theme.text-dim;
                        font-size: 13.5px;
                        overflow: elide;
                        min-width: ArtistLayout.cap-width(root.album, 13.5px, 36px);
                        vertical-alignment: center;
                        album-area := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.open-album();
                            }
                        }
                    }
                }
            }
        }
    }

    // Transport + progress.
    VerticalLayout {
        horizontal-stretch: 0;
        width: root.center-w;
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            spacing: root.tier == 0 ? 18px : 24px;
            BarButton {
                icon: IconKind.shuffle;
                on: root.shuffle;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-shuffle();
                }
            }
            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                opacity: root.has-track ? 1 : 0.4;
                Icon {
                    kind: IconKind.previous;
                    width: 24px;
                    height: 24px;
                    color: Theme.text;
                }
                TouchArea {
                    enabled: root.has-track;
                    mouse-cursor: pointer;
                    clicked => {
                        root.previous();
                    }
                }
            }
            Rectangle {
                width: 46px;
                height: 46px;
                border-radius: 23px;
                background: play-area.pressed ? Theme.text.darker(15%) : Theme.text;
                opacity: root.has-track ? 1 : 0.5;
                Icon {
                    kind: root.paused ? IconKind.play : IconKind.pause;
                    width: 20px;
                    height: 20px;
                    color: Theme.bg;
                }
                play-area := TouchArea {
                    enabled: root.has-track;
                    mouse-cursor: pointer;
                    clicked => {
                        root.toggle-pause();
                    }
                }
            }
            Rectangle {
                width: 36px;
                height: 36px;
                y: (parent.height - self.height) / 2;
                opacity: root.has-track ? 1 : 0.4;
                Icon {
                    kind: IconKind.next;
                    width: 24px;
                    height: 24px;
                    color: Theme.text;
                }
                TouchArea {
                    enabled: root.has-track;
                    mouse-cursor: pointer;
                    clicked => {
                        root.next();
                    }
                }
            }
            BarButton {
                icon: root.repeat == 2 ? IconKind.repeat-one : IconKind.repeat;
                on: root.repeat != 0;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.cycle-repeat();
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: seek-bar.dragging ? root.preview-text : root.position-text;
                font-family: Fonts.family(self.text);
                width: 40px;
                color: Theme.text-faint;
                font-size: 12px;
                font-weight: 500;
                vertical-alignment: center;
            }
            seek-bar := ValueBar {
                enabled: root.has-track && root.duration-ms > 0;
                value: root.duration-ms > 0 ? root.position-ms / root.duration-ms : 0;
                fill: Theme.text;
                knob: root.has-track && root.duration-ms > 0;
                live(v) => {
                    root.preview-ms = v * root.duration-ms;
                }
                committed(v) => {
                    root.seek(v * root.duration-ms);
                }
            }
            Text {
                text: root.buffering ? "缓冲中" : root.duration-text;
                font-family: Fonts.family(self.text);
                width: 40px;
                color: Theme.text-faint;
                font-size: 12px;
                font-weight: 500;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }

    // [Exclusive, cast, sleep] | [lyrics, queue, full screen] | [volume].
    HorizontalLayout {
        horizontal-stretch: 0;
        min-width: root.side-w;
        alignment: end;
        spacing: 4px;
        BarButton {
            y: (parent.height - self.height) / 2;
            icon: IconKind.speaker;
            text: root.tight ? "" : root.exclusive-busy ? "切换中…" : root.exclusive-mode == 2 ? (root.asio-fallback ? "WASAPI" : "ASIO") : "独占";
            chip: root.exclusive || root.exclusive-mode != 0;
            enabled: !root.exclusive-busy;
            clicked => {
                if root.asio-available {
                    root.select-exclusive-mode(root.exclusive-mode == 0 ? 1 : root.exclusive-mode == 1 ? 2 : 0);
                } else {
                    root.toggle-exclusive(!root.exclusive);
                }
            }
        }
        // Sonos output: the room's name while playing there.
        cast-button := BarButton {
            y: (parent.height - self.height) / 2;
            icon: IconKind.cast;
            text: root.compact ? "" : CastState.output-label;
            chip: CastState.output-id != "";
            clicked => {
                CastState.refresh();
                cast-menu.show();
            }
        }
        sleep-button := BarButton {
            y: (parent.height - self.height) / 2;
            icon: IconKind.sleep;
            text: root.sleep-active ? root.sleep-label : "";
            chip: root.sleep-active;
            clicked => {
                sleep-menu.show();
            }
        }
        BarSep { }
        BarButton {
            y: (parent.height - self.height) / 2;
            icon: IconKind.lyrics;
            on: root.lyrics-open;
            clicked => {
                root.toggle-lyrics();
            }
        }
        BarButton {
            y: (parent.height - self.height) / 2;
            icon: IconKind.queue;
            on: root.queue-open;
            clicked => {
                root.toggle-queue();
            }
        }
        BarButton {
            y: (parent.height - self.height) / 2;
            icon: IconKind.expand;
            on: root.full-open;
            enabled: root.has-track || root.full-open;
            clicked => {
                root.toggle-full();
            }
        }
        if !root.tight: BarSep { }
        HorizontalLayout {
            spacing: 10px;
            padding-left: 4px;
            Icon {
                kind: IconKind.volume;
                width: 20px;
                height: 20px;
                y: (parent.height - self.height) / 2;
                color: Theme.text-dim;
            }
            ValueBar {
                width: root.tight ? 56px : root.compact ? 70px : 110px;
                y: (parent.height - self.height) / 2;
                value: root.volume / 100;
                fill: Theme.text-dim;
                live(v) => {
                    root.volume-changed(v * 100);
                }
                committed(v) => {
                    root.volume-changed(v * 100);
                }
            }
        }
    }

    } // bar layout

    cast-menu := PopupWindow {
        x: min(cast-button.absolute-position.x - root.absolute-position.x, root.width - 280px);
        y: -self.height - 10px;
        width: 270px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                HorizontalLayout {
                    height: 28px;
                    padding-left: 10px;
                    padding-right: 8px;
                    Text {
                        text: "播放到";
                        color: Theme.text-faint;
                        font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: CastState.searching ? "搜索中…" : "重新搜索";
                        font-family: Fonts.family(self.text);
                        color: CastState.searching ? Theme.text-faint : refresh-area.has-hover ? Theme.text : Theme.accent-text;
                        font-size: 12px;
                        vertical-alignment: center;
                        refresh-area := TouchArea {
                            enabled: !CastState.searching;
                            mouse-cursor: pointer;
                            clicked => {
                                CastState.refresh();
                            }
                        }
                    }
                }
                CastMenuRow {
                    name: "本机";
                    detail: "mpv 输出（独占 / 输出设备）";
                    icon: IconKind.volume;
                    active: CastState.output-id == "";
                    clicked => {
                        CastState.select("");
                        cast-menu.close();
                    }
                }
                for room in CastState.rooms: CastMenuRow {
                    name: room.name;
                    detail: room.detail;
                    icon: IconKind.cast;
                    active: room.id == CastState.output-id;
                    clicked => {
                        CastState.select(room.id);
                        cast-menu.close();
                    }
                }
                if CastState.hint != "": Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: CastState.hint;
                    font-family: Fonts.family(self.text);
                    color: Theme.text-faint;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                if CastState.hint != "": Rectangle {
                    height: 6px;
                }
            }
        }
    }

    sleep-menu := PopupWindow {
        x: min(sleep-button.absolute-position.x - root.absolute-position.x, root.width - 190px);
        y: -self.height - 10px;
        width: 180px;
        Rectangle {
            background: Theme.raised;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 6px;
                Text {
                    text: "睡眠定时";
                    color: Theme.text-faint;
                    font-size: 12px;
                    height: 24px;
                    vertical-alignment: center;
                    x: 10px;
                }
                for option in [
                    { label: "本曲结束后", mode: 1, minutes: 0 },
                    { label: "本专辑结束后", mode: 2, minutes: 0 },
                    { label: "5 分钟", mode: 3, minutes: 5 },
                    { label: "10 分钟", mode: 3, minutes: 10 },
                    { label: "15 分钟", mode: 3, minutes: 15 },
                    { label: "30 分钟", mode: 3, minutes: 30 },
                    { label: "45 分钟", mode: 3, minutes: 45 },
                    { label: "1 小时", mode: 3, minutes: 60 },
                    { label: "2 小时", mode: 3, minutes: 120 },
                    { label: "3 小时", mode: 3, minutes: 180 },
                    { label: "4 小时", mode: 3, minutes: 240 },
                    { label: "关闭定时", mode: 0, minutes: 0 },
                ]: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    visible: option.mode != 0 || root.sleep-active;
                    background: item-area.has-hover ? Theme.surface-hover : transparent;
                    Text {
                        x: 10px;
                        text: option.label;
                        font-family: Fonts.family(self.text);
                        color: Theme.text;
                        vertical-alignment: center;
                        height: 100%;
                    }
                    item-area := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.set-sleep(option.mode, option.minutes);
                        }
                    }
                }
            }
        }
    }

    // Seek preview while dragging.
    property <int> preview-ms;
    property <string> preview-text: floor(root.preview-ms / 60000) + ":" + (mod(floor(root.preview-ms / 1000), 60) < 10 ? "0" : "") + mod(floor(root.preview-ms / 1000), 60);
}
