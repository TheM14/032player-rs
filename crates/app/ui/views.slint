import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Field, PrimaryButton, ValueBar, IconButton, IconKind, Icon } from "controls.slint";

export struct AlbumCard {
    id: int,
    title: string,
    artist: string,
    year: string,
    cover: image,
}

export struct AlbumRow {
    items: [AlbumCard],
}

export struct TrackRow {
    id: int,
    index: int,
    title: string,
    artist: string,
    album: string,
    duration: string,
}

export struct LyricLine {
    text: string,
}

export component LoginView inherits Rectangle {
    in-out property <string> server;
    in-out property <string> api-token;
    in-out property <string> media-token;
    in property <string> error;
    in property <bool> busy;
    callback login(string, string, string);
    background: Theme.bg;

    function submit() {
        if !root.busy {
            root.login(root.server, root.api-token, root.media-token);
        }
    }

    Rectangle {
        width: 420px;
        height: card.preferred-height;
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        card := VerticalLayout {
            padding: 32px;
            spacing: 18px;

            Text {
                text: "连接 032 Music Server";
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }

            Field {
                label: "服务器地址";
                placeholder: "https://music.example.com";
                text <=> root.server;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "API Token";
                password: true;
                text <=> root.api-token;
                accepted => {
                    root.submit();
                }
            }

            Field {
                label: "媒体凭据";
                password: true;
                text <=> root.media-token;
                accepted => {
                    root.submit();
                }
            }

            if root.error != "": Text {
                text: root.error;
                color: Theme.danger;
                wrap: word-wrap;
            }

            PrimaryButton {
                text: root.busy ? "连接中…" : "登录";
                enabled: !root.busy;
                clicked => {
                    root.submit();
                }
            }
        }
    }
}

component AlbumCardView inherits Rectangle {
    in property <AlbumCard> card;
    in property <length> size: 168px;
    callback clicked();
    width: root.size;
    height: root.size + 62px;

    VerticalLayout {
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: root.size;
            height: root.size;
            border-radius: Theme.radius;
            background: Theme.raised;
            clip: true;

            Image {
                source: root.card.cover;
                width: 100%;
                height: 100%;
                image-fit: ImageFit.cover;
            }

            Rectangle {
                background: area.has-hover ? #00000059 : transparent;
                animate background { duration: 120ms; }
            }

            if area.has-hover: Rectangle {
                x: parent.width - 52px;
                y: parent.height - 52px;
                width: 40px;
                height: 40px;
                border-radius: 20px;
                background: Theme.accent;
                Icon {
                    kind: IconKind.play;
                    width: 16px;
                    height: 16px;
                    fill: #ffffff;
                }
            }
        }

        Text {
            text: root.card.title;
            color: Theme.text;
            font-weight: 600;
            overflow: elide;
            width: root.size;
        }

        Text {
            text: root.card.year == "" ? root.card.artist : root.card.artist + " · " + root.card.year;
            color: Theme.text-dim;
            font-size: 12px;
            overflow: elide;
            width: root.size;
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AlbumGrid inherits Rectangle {
    in property <[AlbumRow]> rows;
    in property <int> loaded;
    in property <int> total;
    // Columns and the card size (logical) whenever the layout changes.
    callback layout-changed(int, length);
    callback play-album(int);
    // Cards at least 160px with 24px gaps and 32px side padding; the
    // columns then share the width.
    out property <int> columns: max(1, floor((self.width - 64px + 24px) / 184px));
    out property <length> card-size: (self.width - 64px - (root.columns - 1) * 24px) / root.columns;
    changed card-size => {
        root.layout-changed(root.columns, root.card-size);
    }
    init => {
        root.layout-changed(root.columns, root.card-size);
    }

    VerticalLayout {
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 24px;
            padding-bottom: 12px;
            Text {
                text: "专辑";
                color: Theme.text;
                font-size: 24px;
                font-weight: 700;
            }
            Text {
                text: root.total == 0 ? "" : root.loaded < root.total ? root.loaded + " / " + root.total : root.total + " 张";
                color: Theme.text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        ListView {
            for row in root.rows: HorizontalLayout {
                padding-left: 32px;
                padding-right: 32px;
                spacing: 24px;
                alignment: start;
                height: root.card-size + 86px;
                for card in row.items: AlbumCardView {
                    card: card;
                    size: root.card-size;
                    clicked => {
                        root.play-album(card.id);
                    }
                }
            }
        }
    }
}

export component TrackList inherits Rectangle {
    in property <[TrackRow]> tracks;
    in property <int> total;
    in property <int> playing-id: -1;
    callback play-track(int);
    // 32px side padding, # 48px, duration 56px, 4 gaps of 16px.
    property <length> flex: max(0px, self.width - 64px - 48px - 56px - 64px);
    property <length> title-w: root.flex * 0.42;
    property <length> artist-w: root.flex * 0.24;
    property <length> album-w: root.flex * 0.34;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 24px;
            padding-bottom: 12px;
            Text {
                text: "曲目";
                color: Theme.text;
                font-size: 24px;
                font-weight: 700;
            }
            Text {
                text: root.total == 0 ? "" : root.tracks.length < root.total ? root.tracks.length + " / " + root.total : root.total + " 首";
                color: Theme.text-dim;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        // Column header.
        HorizontalLayout {
            padding-left: 32px;
            padding-right: 32px;
            height: 28px;
            spacing: 16px;
            Text { text: "#"; width: 48px; color: Theme.text-faint; font-size: 12px; vertical-alignment: center; }
            Text { text: "标题"; width: root.title-w; color: Theme.text-faint; font-size: 12px; vertical-alignment: center; }
            Text { text: "艺人"; width: root.artist-w; color: Theme.text-faint; font-size: 12px; vertical-alignment: center; }
            Text { text: "专辑"; width: root.album-w; color: Theme.text-faint; font-size: 12px; vertical-alignment: center; }
            Text { text: "时长"; width: 56px; color: Theme.text-faint; font-size: 12px; horizontal-alignment: right; vertical-alignment: center; }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        ListView {
            for track in root.tracks: Rectangle {
                height: 36px;
                background: row-area.has-hover ? Theme.surface-hover : transparent;

                HorizontalLayout {
                    padding-left: 32px;
                    padding-right: 32px;
                    spacing: 16px;
                    Text {
                        text: track.index + 1;
                        width: 48px;
                        color: (track.id == root.playing-id) ? Theme.accent : Theme.text-faint;
                        vertical-alignment: center;
                    }
                    Text {
                        text: track.title;
                        width: root.title-w;
                        color: (track.id == root.playing-id) ? Theme.accent : Theme.text;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: track.artist;
                        width: root.artist-w;
                        color: Theme.text-dim;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: track.album;
                        width: root.album-w;
                        color: Theme.text-dim;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Text {
                        text: track.duration;
                        width: 56px;
                        color: Theme.text-dim;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }

                row-area := TouchArea {
                    double-clicked => {
                        root.play-track(track.index);
                    }
                }
            }
        }
    }
}

export component LyricsPanel inherits Rectangle {
    in property <[LyricLine]> lines;
    in property <int> active: -1;
    in property <bool> synced;
    in property <string> source;
    property <length> line-height: 40px;
    background: Theme.surface;

    VerticalLayout {
        HorizontalLayout {
            padding: 16px;
            Text {
                text: "歌词";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: root.source;
                color: Theme.text-faint;
                font-size: 11px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        if root.lines.length == 0: Rectangle {
            Text {
                text: "暂无歌词";
                color: Theme.text-faint;
            }
        }

        // Synced: auto-scroll only in M0 (user scrolling would break the binding).
        if root.lines.length > 0 && root.synced: synced-flick := Flickable {
            interactive: false;
            property <length> pad: max(0px, (self.height - root.line-height) / 2);
            content-height: root.lines.length * root.line-height + 2 * self.pad;
            content-y: -(max(0, root.active) * root.line-height);
            animate content-y { duration: 380ms; easing: ease-out; }

            for line[i] in root.lines: Text {
                x: 16px;
                y: synced-flick.pad + i * root.line-height;
                width: synced-flick.width - 32px;
                height: root.line-height;
                text: line.text;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: i == root.active ? 18px : 15px;
                font-weight: i == root.active ? 700 : 400;
                color: i == root.active ? Theme.text : Theme.text-faint;
                animate color { duration: 200ms; }
            }
        }

        // Plain lyrics: free scrolling.
        if root.lines.length > 0 && !root.synced: plain-flick := Flickable {
            content-height: root.lines.length * root.line-height + 32px;
            for line[i] in root.lines: Text {
                x: 16px;
                y: 16px + i * root.line-height;
                width: plain-flick.width - 32px;
                height: root.line-height;
                text: line.text;
                overflow: elide;
                vertical-alignment: center;
                horizontal-alignment: center;
                font-size: 15px;
                color: Theme.text-dim;
            }
        }
    }
}

export component PlayerBar inherits Rectangle {
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <string> quality;
    in property <image> cover;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <string> position-text;
    in property <string> duration-text;
    in property <bool> paused: true;
    in property <bool> buffering;
    in property <float> volume: 100;
    in property <bool> lyrics-open;
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(int);
    callback volume-changed(float);
    callback toggle-lyrics();
    height: 84px;
    background: Theme.surface;

    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;

        // Now playing.
        HorizontalLayout {
            width: 30%;
            spacing: 12px;
            alignment: start;
            Rectangle {
                width: 56px;
                height: 56px;
                y: (parent.height - self.height) / 2;
                border-radius: 4px;
                background: Theme.raised;
                clip: true;
                Image {
                    source: root.cover;
                    width: 100%;
                    height: 100%;
                    image-fit: ImageFit.cover;
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.has-track ? root.title : "未在播放";
                    color: Theme.text;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: root.artist;
                    color: Theme.text-dim;
                    font-size: 12px;
                    overflow: elide;
                }
                Text {
                    text: root.quality;
                    visible: root.quality != "";
                    color: Theme.accent;
                    font-size: 11px;
                    overflow: elide;
                }
            }
        }

        // Transport + progress.
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            HorizontalLayout {
                alignment: center;
                spacing: 12px;
                IconButton {
                    kind: IconKind.previous;
                    enabled: root.has-track;
                    clicked => {
                        root.previous();
                    }
                }
                IconButton {
                    kind: root.paused ? IconKind.play : IconKind.pause;
                    filled: true;
                    size: 40px;
                    enabled: root.has-track;
                    clicked => {
                        root.toggle-pause();
                    }
                }
                IconButton {
                    kind: IconKind.next;
                    enabled: root.has-track;
                    clicked => {
                        root.next();
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: seek-bar.dragging ? root.preview-text : root.position-text;
                    width: 48px;
                    color: Theme.text-dim;
                    font-size: 11px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                seek-bar := ValueBar {
                    enabled: root.has-track && root.duration-ms > 0;
                    value: root.duration-ms > 0 ? root.position-ms / root.duration-ms : 0;
                    live(v) => {
                        root.preview-ms = v * root.duration-ms;
                    }
                    committed(v) => {
                        root.seek(v * root.duration-ms);
                    }
                }
                Text {
                    text: root.buffering ? "缓冲中" : root.duration-text;
                    width: 48px;
                    color: Theme.text-dim;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // Volume + lyrics.
        HorizontalLayout {
            width: 30%;
            alignment: end;
            spacing: 12px;
            IconButton {
                kind: IconKind.lyrics;
                active: root.lyrics-open;
                y: (parent.height - self.height) / 2;
                clicked => {
                    root.toggle-lyrics();
                }
            }
            ValueBar {
                width: 120px;
                y: (parent.height - self.height) / 2;
                value: root.volume / 100;
                live(v) => {
                    root.volume-changed(v * 100);
                }
                committed(v) => {
                    root.volume-changed(v * 100);
                }
            }
        }
    }

    // Seek preview while dragging.
    property <int> preview-ms;
    property <string> preview-text: floor(root.preview-ms / 60000) + ":" + (mod(floor(root.preview-ms / 1000), 60) < 10 ? "0" : "") + mod(floor(root.preview-ms / 1000), 60);
}
