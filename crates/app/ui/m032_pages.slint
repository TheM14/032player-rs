                }
                Text {
                    text: root.loading && Lib032.series-info.title == "" ? "加载中…" : Lib032.series-info.title;
                    font-family: Fonts.family(self.text);
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 700;
                    overflow: elide;
                }
                if Lib032.series-info.renamed: VerticalLayout {
                    alignment: center;
                    Pill {
                        text: "已改名";
                    }
                }
            }
            Text {
                text: Lib032.series-info.facts;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 13px;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-top: 6px;
                PrimaryButton {
                    text: "播放全部";
                    width: 96px;
                    height: 32px;
                    clicked => {
                        Lib032.detail-action("play", 0);
                    }
                }
                GhostButton {
                    text: "加入队列";
                    clicked => {
                        Lib032.detail-action("last", 0);
                    }
                }
                GhostButton {
                    text: "在网页中打开";
                    clicked => {
                        Lib032.detail-action("web", 0);
                    }
                }
            }
        }

        HorizontalLayout {
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            SectionHead {
                title: "系列成员";
                count: Lib032.series-info.member-count + " 部作品";
            }
        }
        if !root.loading && Lib032.series-members.length == 0: Text {
            x: Shell.pad;
            text: "该系列暂无成员作品";
            color: Theme.text-faint;
        }
        CardRows {
            width: root.width;
            rows: Lib032.series-members;
            kind: 3;
            playlists: root.playlists;
            lazy: true;
            view-top: -root.content-y - self.y - root.height / 2;
            view-bottom: self.view-top + root.height * 2;
            row-shown(row) => {
                root.card-row-shown(GridId.members, row);
            }
            layout-changed(n, size) => {
                root.card-layout(GridId.members, n, size);
            }
            action(what, id, arg) => {
                root.card-action(GridId.members, what, id, arg);
            }
        }

        HorizontalLayout {
            padding-left: Shell.pad;
            padding-right: Shell.pad;
            SectionHead {
                title: "系列专辑";
                count: Lib032.series-info.album-count + " 张专辑";
            }
        }
        if !root.loading && Lib032.series-albums.length == 0: Text {
            x: Shell.pad;
            text: "尚无关联专辑";
            color: Theme.text-faint;
        }
        CardRows {
            width: root.width;
            rows: Lib032.series-albums;
            kind: 0;
            playlists: root.playlists;
            lazy: true;
            view-top: -root.content-y - self.y - root.height / 2;
            view-bottom: self.view-top + root.height * 2;
            row-shown(row) => {
                root.card-row-shown(GridId.series-albums, row);
            }
            layout-changed(n, size) => {
                root.card-layout(GridId.series-albums, n, size);
            }
            action(what, id, arg) => {
                root.card-action(GridId.series-albums, what, id, arg);
            }
        }
    }
}

// Daily mix page: hero, tracks (track list 2, mode 4) and the feedback
// column (rating, 换一个, 另存为歌单, today's other mixes).
export component MixPage inherits VerticalLayout {
    in-out property <length> scroll-y;
    in property <[TrackRow]> tracks;
    in property <bool> loading;
    in property <int> playing-id;
    in property <int> playing-mix: -1;
    in property <[PlaylistChoice]> playlists;
    callback track-action(string, int, int);
    callback open-mix(int);
    callback play-mix(int);
    property <bool> reasons-open;
    property <int> mix-id: Lib032.mix.id;
    changed mix-id => {
        root.reasons-open = false;
    }
    property <image> no-image;

    HorizontalLayout {
        vertical-stretch: 0;
        padding-left: Shell.pad;
        padding-right: Shell.pad;
        padding-top: 48px;
        padding-bottom: 16px;
        spacing: 24px;
        Rectangle {
            width: 180px;
            height: 180px;
            border-radius: Theme.radius;
            background: Lib032.mix-covers.length >= 4 ? Theme.raised : transparent;
            clip: true;
            if Lib032.mix-covers.length < 4: Cover {
                radius: Theme.radius;
                source: Lib032.mix-covers.length > 0 ? Lib032.mix-covers[0] : root.no-image;
                placeholder: "♪";
            }
            if Lib032.mix-covers.length >= 4: Rectangle {
                for img[i] in Lib032.mix-covers: Image {
                    x: mod(i, 2) * 90px;
                    y: floor(i / 2) * 90px;
                    width: 90px;
                    height: 90px;
                    source: img;
                    image-fit: ImageFit.cover;
                }
            }
        }
        VerticalLayout {
            alignment: end;
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: Lib032.mix.kicker;
                font-family: Fonts.family(self.text);
                color: Theme.accent;
                font-size: 13px;
            }
            Text {
                text: root.loading && Lib032.mix.title == "" ? "加载中…" : Lib032.mix.title;
                font-family: Fonts.family(self.text);
                color: Theme.text;
                font-size: 28px;
                font-weight: 700;
                overflow: elide;
            }
            if Lib032.mix.description != "": Text {
                text: Lib032.mix.description;
                font-family: Fonts.family(self.text);
                color: Theme.text-dim;
                font-size: 13px;
                wrap: word-wrap;
                max-height: 36px;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                for tag in Lib032.mix-tags: Pill {
                    text: tag.label;
                    accent: tag.style;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                padding-top: 6px;
                PrimaryButton {
                    text: "播放全部";
                    width: 96px;
                    height: 32px;
                    clicked => {
                        Lib032.detail-action("play", 0);
                    }
                }
                GhostButton {
                    text: "随机播放";
                    has-icon: true;
                    icon: IconKind.shuffle;
                    clicked => {
                        Lib032.detail-action("shuffle", 0);
                    }
                }
                GhostButton {
                    text: "加入播放队列";
                    clicked => {
                        Lib032.detail-action("last", 0);
                    }
                }
            }
            Text {
                text: Lib032.mix.subtitle;
                font-family: Fonts.family(self.text);
                color: Theme.text-faint;
                font-size: 13px;
            }
        }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 0px;
        TrackList {
            width: root.width - 280px;
            scroll-y <=> root.scroll-y;
            rows: root.tracks;
            mode: 4;
            loading: root.loading;
            playing-id: root.playing-id;
            playlists: root.playlists;
            action(what, i, arg) => {
                root.track-action(what, i, arg);
            }
        }
        Flickable {
            width: 280px;
            content-height: aside.preferred-height;
            aside := VerticalLayout {
                width: parent.width;
                padding-right: 24px;
                spacing: 16px;
                alignment: start;
                Rectangle {
                    border-radius: 10px;
                    background: Theme.surface;
                    height: feedback.preferred-height;
                    feedback := VerticalLayout {
                        padding: 16px;
                        spacing: 10px;
                        Text {
                            text: "这个歌单怎么样？";
                            color: Theme.text;
                            font-weight: 600;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            GhostButton {
                                text: "喜欢";
                                active: Lib032.mix.rating == 1;
                                clicked => {
                                    Lib032.detail-action(Lib032.mix.rating == 1 ? "undo" : "like", 0);
                                }
                            }
                            GhostButton {
                                text: Lib032.mix.rating == -1 ? "不喜欢" : "不喜欢…";
                                active: Lib032.mix.rating == -1;
                                clicked => {
                                    if Lib032.mix.rating == -1 {
                                        Lib032.detail-action("undo", 0);
                                    } else {
                                        root.reasons-open = !root.reasons-open;
                                    }
                                }
                            }
                        }
                        if Lib032.mix.disliked-note != "": Text {
                            text: Lib032.mix.disliked-note;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-dim;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                        if root.reasons-open && Lib032.mix.rating != -1: VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "哪里不满意？（可多选，也可不选）";
                                color: Theme.text-dim;
                                font-size: 13px;
                            }
                            for label[i] in ["太重复", "不喜欢这个主题", "歌不好听", "风格太跳", "歌和主题不符"]: CheckBox {
                                text: label;
                                checked: Lib032.mix-reasons[i];
                                toggled => {
                                    Lib032.mix-reasons[i] = self.checked;
                                }
                            }
                            HorizontalLayout {
                                alignment: start;
                                GhostButton {
                                    text: "提交";
                                    clicked => {
                                        root.reasons-open = false;
                                        Lib032.detail-action("dislike", 0);
                                    }
                                }
                            }
                        }
                        if Lib032.mix.current: VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                alignment: start;
                                GhostButton {
                                    text: "换一个";
                                    enabled: Lib032.mix.replacements-left > 0;
                                    clicked => {
                                        Lib032.detail-action("replace", 0);
                                    }
                                }
                            }
                            Text {
                                text: Lib032.mix.replacements-left > 0 ? "今天还可以换 " + Lib032.mix.replacements-left + " 次" : "今天的次数已用完";
                                font-family: Fonts.family(self.text);
                                color: Theme.text-faint;
                                font-size: 12px;
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            alignment: start;
                            HorizontalLayout {
                                alignment: start;
                                GhostButton {
                                    text: Lib032.mix.saved-playlist-id > 0 ? "再存一份为歌单" : "另存为歌单";
                                    clicked => {
                                        Lib032.detail-action("save", 0);
                                    }
                                }
                            }
                            if Lib032.mix.saved-playlist-id > 0: HorizontalLayout {
                                alignment: start;
                                LinkText {
                                    text: "查看已保存的歌单";
                                    clicked => {
                                        Lib032.detail-action("saved", Lib032.mix.saved-playlist-id);
                                    }
                                }
                            }
                        }
                        Text {
                            text: "“不再推荐”和评价从下一次生成开始生效。";
                            color: Theme.text-faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                if Lib032.mix-others.length > 0: VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: "今天的其他推荐";
                        color: Theme.text;
                        font-weight: 600;
                    }
                    for m in Lib032.mix-others: HomeRowView {
                        item: m;
                        mix: true;
                        playing: m.id == root.playing-mix;
                        action(what, arg) => {
                            if what == "play" {
                                root.play-mix(m.id);
                            } else {
                                root.open-mix(m.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

// Online lyrics search: results on the left, the selected one's lyrics on
// the right; 确定 uses it for this track on the server.
export component LyricsSearchDialog inherits Rectangle {
    callback close();
    background: #00000099;

    TouchArea { }

    debounce := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            LyricsSearch.search(LyricsSearch.name, LyricsSearch.artist);
        }
    }

    Rectangle {
        width: min(760px, root.width - 64px);
        height: min(560px, root.height - 64px);
        border-radius: 12px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        VerticalLayout {
            padding: 24px;
            spacing: 14px;
            Text {
                text: "搜索歌词";
                color: Theme.text;
                font-size: 18px;
                font-weight: 700;
            }
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 0;
                Field {
                    label: "歌曲名";
                    text <=> LyricsSearch.name;
                    edited => {
                        debounce.restart();
                    }
                    accepted => {
                        debounce.running = false;
                        LyricsSearch.search(LyricsSearch.name, LyricsSearch.artist);
                    }
                }
                Field {
                    label: "艺人";
                    text <=> LyricsSearch.artist;
                    edited => {
                        debounce.restart();
                    }
                    accepted => {
                        debounce.running = false;
                        LyricsSearch.search(LyricsSearch.name, LyricsSearch.artist);
                    }
                }
            }
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                Rectangle {
                    horizontal-stretch: 1;
                    if LyricsSearch.results.length == 0: Text {
                        text: LyricsSearch.searching ? "搜索中…" : "没有结果";
                        font-family: Fonts.family(self.text);
                        color: Theme.text-faint;
                    }
                    ListView {
                        for r[i] in LyricsSearch.results: Rectangle {
                            height: 62px;
                            border-radius: Theme.radius;
                            background: i == LyricsSearch.selected ? Theme.accent-dim : r-area.has-hover ? Theme.surface-hover : transparent;
                            r-area := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    LyricsSearch.selected = i;
                                    LyricsSearch.select(i);
                                }
                            }
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: r.title;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: r.artist;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text-dim;
                                        font-size: 13px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: r.meta;
                                        font-family: Fonts.family(self.text);
                                        color: Theme.text-faint;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: r.score;
                                    font-family: Fonts.family(self.text);
                                    color: Theme.text-dim;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle {
                    width: 280px;
                    border-radius: Theme.radius;
                    background: Theme.bg;
                    if LyricsSearch.preview.length == 0: Text {
                        text: LyricsSearch.selected < 0 ? "选择一条结果预览歌词" : "加载中…";
                        font-family: Fonts.family(self.text);
                        color: Theme.text-faint;
                        font-size: 13px;
                    }
                    ListView {
                        for line in LyricsSearch.preview: Text {
                            height: 24px;
                            text: line;
                            font-family: Fonts.family(self.text);
                            color: Theme.text-dim;
                            font-size: 13px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Text {
                    text: "选中的歌词会保存到服务端，对所有设备生效。";
                    color: Theme.text-faint;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                GhostButton {
                    text: "取消";
                    clicked => {
                        root.close();
                    }
                }
                PrimaryButton {
                    text: "确定";
                    enabled: LyricsSearch.selected >= 0;
                    width: 96px;
                    height: 32px;
                    clicked => {
                        LyricsSearch.apply(LyricsSearch.selected);
                        root.close();
                    }
                }
            }
        }
    }
}
