// 032 Dark (M0). Accent from shared/themes/music032: #8d7dff on dark.
export global Theme {
    out property <color> bg: #15141b;
    out property <color> surface: #1d1b25;
    out property <color> surface-hover: #272431;
    out property <color> raised: #2a2734;
    out property <color> border: #2e2b38;
    out property <color> text: #ecebf3;
    out property <color> text-dim: #a19db2;
    out property <color> text-faint: #6f6b80;
    out property <color> accent: #8d7dff;
    out property <color> accent-dim: #8d7dff33;
    out property <color> danger: #ff7a85;
    out property <length> radius: 6px;
}
